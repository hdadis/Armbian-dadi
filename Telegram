Description=Telegram Bot Armbian Monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/armbian-bot
ExecStart=/root/armbian-bot/venv/bin/python3 /root/armbian-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
sudo systemctl daemon-reload && sudo systemctl enable armbianbot.service
