# 1. Update paket & install dependencies pendukung
sudo apt-get update
sudo apt install python3 python3-pip python3-venv arp-scan -y
sudo apt install python3.10-venv

# 2. Buat folder direktori kerja di /root
sudo mkdir -p /root/armbian-bot && cd /root/armbian-bot

# 3. Buat Virtual Environment & Install pustaka Python
#    (pillow dipakai untuk preview gambar Denah di chat; bot tetap jalan tanpa pillow)
sudo python3 -m venv /root/armbian-bot/venv
sudo /root/armbian-bot/venv/bin/pip install pyTelegramBotAPI requests psutil pillow

# 4. Buat file bot.py (hentikan service lama dulu jika sudah ada)
sudo systemctl stop armbianbot.service 2>/dev/null || true
sudo wget -O /root/armbian-bot/bot.py https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Telegram

# 5. Buat file armbianbot.service
sudo bash -c 'cat << "EOF" > /etc/systemd/system/armbianbot.service
[Unit]
Description=Armbian Telegram Bot Monitor
After=network.target

[Service]
User=root
WorkingDirectory=/root/armbian-bot
ExecStart=/root/armbian-bot/venv/bin/python3 /root/armbian-bot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

EOF'


# 6. Reload daemon, aktifkan, dan jalankan service
sudo systemctl daemon-reload
sudo systemctl enable armbianbot.service
sudo systemctl restart armbianbot.service
sudo systemctl status armbianbot.service --no-pager

# 7. Cek fitur Denah (/denah dan /run sudo denah di Telegram butuh perintah 'denah')
if [ -x /usr/local/bin/denah ]; then
  echo "OK: perintah 'denah' sudah terpasang."
else
  echo "PERHATIAN: 'denah' belum terpasang. Jalankan dulu: sudo bash /root/install.sh"
fi

