@bot.message_handler(commands=["status"])
def send_status(message):
    suhu = get_cpu_temp()
    ram = psutil.virtual_memory()
    disk = psutil.disk_usage("/")
    uptime = get_uptime()
    
    status_msg = (
        "📊 *STATUS SERVER ARMBIAN*\n\n"
        f"⏱️ *Uptime:* `{uptime}`\n"
        f"🌡️ *Suhu CPU:* `{suhu}`\n"
        f"🧠 *RAM:* `{ram.percent}%` ({ram.used // (1024**2)}MB / {ram.total // (1024**2)}MB)\n"
        f"💾 *Disk:* `{disk.percent}%` ({disk.free // (1024**3)}GB Free)\n"
    )
    bot.send_message(message.chat.id, status_msg, parse_mode="Markdown")

@bot.message_handler(commands=["cekip"])
def send_ip_details(message):
    bot.reply_to(message, "⏳ Sedang mengambil data IP...")
    hasil_ip = get_ip_details()
    bot.send_message(message.chat.id, f"`{hasil_ip}`", parse_mode="Markdown")

@bot.message_handler(commands=["ceksuhu"])
def send_temp(message):
