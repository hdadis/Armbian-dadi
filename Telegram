# 1. Update paket & install dependencies pendukung
sudo apt update && sudo apt install python3 python3-pip python3-venv arp-scan -y

# 2. Buat folder direktori kerja di /root
sudo mkdir -p /root/armbian-bot && cd /root/armbian-bot

# 3. Buat Virtual Environment & Install pustaka Python
sudo python3 -m venv /root/armbian-bot/venv
sudo /root/armbian-bot/venv/bin/pip install pyTelegramBotAPI requests psutil

# 4. Buat file bot.py lengkap
sudo bash -c 'cat << "EOF" > /root/armbian-bot/bot.py
