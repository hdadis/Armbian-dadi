    respons = f"🌡️ *Suhu CPU Armbian:* `{suhu}`"
    bot.send_message(message.chat.id, respons, parse_mode="Markdown")

@bot.message_handler(commands=["cekram"])
def send_ram(message):
    ram = psutil.virtual_memory()
    total_gb = ram.total / (1024 ** 3)
    used_gb = ram.used / (1024 ** 3)
    respons = (
        f"🧠 *Penggunaan RAM:*\n"
        f"Terpakai : `{used_gb:.2f} GB` / `{total_gb:.2f} GB` (`{ram.percent}%`)"
    )
    bot.send_message(message.chat.id, respons, parse_mode="Markdown")

@bot.message_handler(commands=["cekdisk"])
def send_disk(message):
    disk = psutil.disk_usage("/")
    total_gb = disk.total / (1024 ** 3)
    used_gb = disk.used / (1024 ** 3)
    free_gb = disk.free / (1024 ** 3)
    respons = (
        f"💾 *Penggunaan Disk (/):*\n"
        f"Terpakai : `{used_gb:.2f} GB` / `{total_gb:.2f} GB` (`{disk.percent}%`)\n"
        f"Sisa     : `{free_gb:.2f} GB`"
    )
    bot.send_message(message.chat.id, respons, parse_mode="Markdown")

@bot.message_handler(commands=["uptime"])
def send_uptime(message):
    respons = f"⏱️ *Server Uptime:* `{get_uptime()}`"
    bot.send_message(message.chat.id, respons, parse_mode="Markdown")

@bot.message_handler(commands=["cekjaringan"])
def send_network_devices(message):
    bot.reply_to(message, "🔍 Sedang memindai jaringan lokal, mohon tunggu...")
    hasil_jaringan = get_local_devices()
    bot.send_message(message.chat.id, f"`{hasil_jaringan}`", parse_mode="Markdown")

bot.infinity_polling()
EOF'

# 5. Buat file konfigurasi systemd service
sudo bash -c 'cat << "EOF" > /etc/systemd/system/armbianbot.service
[Unit]
Description=Telegram Bot Armbian Monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/armbian-bot
ExecStart=/root/armbian-bot/venv/bin/python3 /root/armbian-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF'

# 6. Reload daemon, aktifkan, dan jalankan service
sudo systemctl daemon-reload
sudo systemctl enable armbianbot.service
sudo systemctl restart armbianbot.service
sudo systemctl status armbianbot.service
