#!/bin/bash

# 1. Pastikan script dijalankan sebagai root / sudo
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=================================================="
echo " Memulai Instalasi Otomatis MotionEye (Port 8080)"
echo "=================================================="

# 2. Update indeks paket dasar saja (tanpa upgrade sistem)
echo "[1/4] Memperbarui indeks paket..."
apt-get update -y
apt-get install -y curl

# 3. Install Docker jika belum ada
echo "[2/4] Menginstal Docker & Docker Compose..."
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    rm -f get-docker.sh
fi

if ! docker compose version &> /dev/null; then
    apt-get install -y docker-compose-plugin
fi

# 4. Buat folder direktori kerja dan storage
echo "[3/4] Membuat direktori MotionEye..."
INSTALL_DIR="/root/motioneye"
mkdir -p "$INSTALL_DIR/config"
mkdir -p "$INSTALL_DIR/storage"
cd "$INSTALL_DIR"

# 5. Tulis file docker-compose.yml dengan port 8080
echo "[4/4] Membuat file docker-compose.yml..."
cat << 'EOF' > docker-compose.yml
version: '3.8'

services:
  motioneye:
    image: ccrisan/motioneye:master-armhf
    container_name: motioneye
    restart: unless-stopped
    ports:
      - "8080:8765"
    environment:
      - TZ=Asia/Jakarta
    volumes:
      - ./config:/etc/motioneye
      - ./storage:/var/lib/motioneye
    privileged: true
EOF

# Perbaiki izin akses folder penyimpanan
chmod -R 777 "$INSTALL_DIR/config" "$INSTALL_DIR/storage"

# 6. Jalankan Docker Compose
echo "Mengunduh dan menjalankan MotionEye..."
docker compose pull
docker compose up -d

# Dapatkan IP Lokal STB
IP_ADDR=$(hostname -I | awk '{print $1}')

echo "=================================================="
echo " Instalasi Selesai!"
echo " Akses MotionEye di browser: http://${IP_ADDR}:8080"
echo " Username default : admin"
echo " Password default : (kosongkan)"
echo "=================================================="

# Tampilkan log kontainer
docker logs motioneye -f
