#!/bin/bash

# 1. Pastikan script dijalankan sebagai root / sudo
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=================================================="
echo " Setup MotionEye (IP: 192.168.18.20) + NFS Storage"
echo "=================================================="

# 2. Update indeks paket dan install nfs-common
echo "[1/5] Memperbarui paket & menginstal utilitas NFS..."
apt-get update -y
apt-get install -y curl nfs-common

# 3. Install Docker jika belum ada
echo "[2/5] Menginstal Docker & Docker Compose..."
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    rm -f get-docker.sh
fi

if ! docker compose version &> /dev/null; then
    apt-get install -y docker-compose-plugin
fi

# 4. Siapkan Direktori Lokal & Mount Network Storage (NFS)
echo "[3/5] Menghubungkan Network Storage (NFS)..."
STORAGE_DIR="/root/motioneye/storage"
mkdir -p "$STORAGE_DIR"

# Cek apakah folder sudah ter-mount, jika belum lakukan mount
if ! mountpoint -q "$STORAGE_DIR"; then
    mount -t nfs 192.168.18.2:/mnt/External/cctv "$STORAGE_DIR"
    
    # Tambahkan ke /etc/fstab agar auto-mount permanen saat STB direstart
    if ! grep -q "192.168.18.2:/mnt/External/cctv" /etc/fstab; then
        echo "192.168.18.2:/mnt/External/cctv $STORAGE_DIR nfs defaults 0 0" >> /etc/fstab
    fi
else
    echo "Network storage sudah ter-mount sebelumnya."
fi

# 5. Buat folder direktori konfigurasi aplikasi
echo "[4/5] Menyiapkan direktori aplikasi MotionEye..."
INSTALL_DIR="/root/motioneye"
mkdir -p "$INSTALL_DIR/config"
cd "$INSTALL_DIR"

# 6. Tulis file docker-compose.yml secara otomatis
echo "[5/5] Membuat file docker-compose.yml..."
cat << EOF > docker-compose.yml
version: '3.8'

services:
  motioneye:
    image: ccrisan/motioneye:master-armhf
    container_name: motioneye
    restart: unless-stopped
    ports:
      - "8080:8765"
    environment:
      - TZ=Asia/Jakarta
    volumes:
      - ./config:/etc/motioneye
      - /root/motioneye/storage:/var/lib/motioneye
    privileged: true
EOF

# Perbaiki izin akses folder config
chmod -R 777 "$INSTALL_DIR/config"

# 7. Jalankan Docker Compose
echo "Menjalankan kontainer MotionEye..."
docker compose pull
docker compose up -d

echo "=================================================="
echo " Instalasi Selesai & Berhasil Dikonfigurasi!"
echo "--------------------------------------------------"
echo " IP MotionEye STB     : 192.168.18.20"
echo " Network Storage      : 192.168.18.2:/mnt/External/cctv"
echo " Akses Web MotionEye  : http://192.168.18.20:8080"
echo " Username default     : admin"
echo " Password default     : (kosongkan)"
echo "=================================================="

# Tampilkan log kontainer
docker logs motioneye -f
