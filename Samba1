#!/bin/bash

# ==============================================================================
# Script: setup_samba_dual_user.sh
# Akses: User 'dadi' dan 'root' (Full Read/Write)
# Target: /mnt/External
# ==============================================================================

if [ "$EUID" -ne 0 ]; then
  echo "[-] Jalankan skrip ini dengan hak akses sudo / root."
  exit 1
fi

SHARE_GROUP="sambashare"
SHARE_USER="dadi"
MOUNT_POINT="/mnt/External"
SMB_CONF="/etc/samba/smb.conf"

echo "[+] 1. Memperbarui package & menginstal Samba + tool filesystem..."
apt-get update -y
apt-get install -y samba samba-common-bin smbclient cifs-utils ntfs-3g exfat-fuse

echo "[+] 2. Menyiapkan grup dan akun sistem..."
getent group $SHARE_GROUP >/dev/null || groupadd $SHARE_GROUP

if ! id "$SHARE_USER" &>/dev/null; then
    useradd -M -s /usr/sbin/nologin -g $SHARE_GROUP $SHARE_USER
else
    usermod -a -G $SHARE_GROUP $SHARE_USER
fi

# Tambahkan root ke grup sambashare
usermod -a -G $SHARE_GROUP root

echo "[+] 3. Mendeteksi penyimpanan eksternal..."
USB_DEV=$(lsblk -d -o NAME,TRAN | grep usb | awk '{print $1}' | head -n 1)

if [ -z "$USB_DEV" ]; then
    USB_PART=$(lsblk -ln -o NAME,MOUNTPOINT | grep -v '^sda' | awk '$2=="" {print $1}' | head -n 1)
else
    USB_PART=$(lsblk -ln -o NAME /dev/$USB_DEV | grep -E "[0-9]$" | head -n 1)
fi

if [ -z "$USB_PART" ]; then
    echo "[-] Gagal mendeteksi partisi storage eksternal. Periksa koneksi disk."
    exit 1
fi

USB_PATH="/dev/$USB_PART"
echo "[+] Partisi terdeteksi: $USB_PATH"

mkdir -p "$MOUNT_POINT"

# Deteksi tipe filesystem dan UUID
FSTYPE=$(blkid -s TYPE -o value "$USB_PATH")
UUID_USB=$(blkid -s UUID -o value "$USB_PATH")

echo "[+] Tipe filesystem: ${FSTYPE:-unknown}"

# Lepas mount lama jika sudah terpasang agar permission bersih
if mountpoint -q "$MOUNT_POINT"; then
    umount "$MOUNT_POINT"
fi

# Mounting sesuai jenis filesystem
echo "[+] Melakukan mounting ke $MOUNT_POINT..."
if [[ "$FSTYPE" == "ntfs" || "$FSTYPE" == "vfat" || "$FSTYPE" == "exfat" ]]; then
    # Permission NTFS/FAT diatur saat mounting (read, write, execute untuk dadi, root, & sambashare)
    mount -t auto -o uid=$SHARE_USER,gid=$SHARE_GROUP,umask=000,nofail "$USB_PATH" "$MOUNT_POINT"
else
    mount "$USB_PATH" "$MOUNT_POINT"
    chown -R "$SHARE_USER:$SHARE_GROUP" "$MOUNT_POINT"
    chmod -R 777 "$MOUNT_POINT"
fi

# Update /etc/fstab untuk auto-mount permanen
if [ -n "$UUID_USB" ]; then
    # Hapus entri lama jika ada
    sed -i "\|$MOUNT_POINT|d" /etc/fstab
    
    echo "[+] Menambahkan entri ke /etc/fstab..."
    if [[ "$FSTYPE" == "ntfs" || "$FSTYPE" == "vfat" || "$FSTYPE" == "exfat" ]]; then
        echo "UUID=$UUID_USB $MOUNT_POINT auto nosuid,nodev,nofail,uid=$SHARE_USER,gid=$SHARE_GROUP,umask=000 0 2" >> /etc/fstab
    else
        echo "UUID=$UUID_USB $MOUNT_POINT auto nosuid,nodev,nofail 0 2" >> /etc/fstab
    fi
fi

echo "--------------------------------------------------"
echo "[!] PENGATURAN PASSWORD SAMBA"
echo "--------------------------------------------------"

echo "[+] Masukkan password Samba untuk user '$SHARE_USER':"
smbpasswd -a "$SHARE_USER"
smbpasswd -e "$SHARE_USER"

echo ""
echo "[+] Masukkan password Samba untuk user 'root':"
smbpasswd -a root
smbpasswd -e root

echo "[+] 4. Menyiapkan konfigurasi /etc/samba/smb.conf..."
cp "$SMB_CONF" "$SMB_CONF.bak_$(date +%F_%R)"

# Hapus section [External] lama jika ada agar tidak double config
sed -i '/^\[External\]/,/^\[/ { /^\[External\]/! { /^\[/!d } }' "$SMB_CONF"
sed -i '/^\[External\]/d' "$SMB_CONF"

cat <<EOT >> "$SMB_CONF"

# ==========================================================
# Konfigurasi Storage Eksternal (dadi & root)
# ==========================================================
[External]
    comment = External Storage Shared
    path = $MOUNT_POINT
    browseable = yes
    read only = no
    guest ok = no
    valid users = dadi, root
    admin users = root
    write list = dadi, root
    create mask = 0777
    directory mask = 0777
    force create mode = 0777
    force directory mode = 0777
EOT

echo "[+] 5. Merestart layanan Samba..."
systemctl restart smbd
systemctl enable smbd

IP_ADDR=$(hostname -I | awk '{print $1}')

echo "--------------------------------------------------"
echo "[+] SETUP SELESAI!"
echo "--------------------------------------------------"
echo " IP Server   : $IP_ADDR"
echo " Path Share  : \\\\$IP_ADDR\\External"
echo " User Valid  : dadi ATAU root"
echo ""
echo " Catatan saat login dari Windows:"
echo " - Jika login gagal, gunakan format: \\dadi atau \\root"
echo " - Reset cache login Windows jika macet: net use * /delete /y"
echo "--------------------------------------------------"
