sudo tee /root/cleanup.sh >/dev/null << 'EOF'
#!/bin/bash

# ==============================================================================
# Script Pembersihan Menyeluruh, Auto-Cron 5 Jam & Refresh Nginx (Armbian STB HG680P)
# Terintegrasi: n8n Safe UI, Purge Compiler, MOCP Safe, AdGuard Clean, Nginx
# ==============================================================================

if [ "$EUID" -ne 0 ]; then
  echo "[-] Harap jalankan script ini sebagai root (gunakan: sudo bash $0)"
  exit 1
fi

SCRIPT_PATH="/root/cleanup.sh"
MODE="${1:-full}"

CLEAN_DIRS=(
  "/root/n8n/downloads"
  "/home/node/downloads"
  "/home/dadi/.n8n/binaryData"
  "/home/dadi/Downloads"
  "/var/www/n8n/downloads"
  "/root/.n8n/binaryData"
  "/root/Downloads"
)

WEB_DIRS=(
  "/root/website"
  "/home/armbian/website"
  "/home/dadi/website"
)

clean_n8n_files() {
  local FORCE_ALL="${1:-false}"
  for d in "${CLEAN_DIRS[@]}"; do
    # Lewati symlink agar tidak menghapus folder yang sama dua kali
    if [ -d "$d" ] && [ ! -L "$d" ]; then
      if [ "$FORCE_ALL" = "true" ]; then
        # Mode manual (--all): Hapus semua file detik ini juga tanpa peduli umur file
        find "$d" -mindepth 1 -delete 2>/dev/null || true
      else
        # Mode reguler (5 jam): Hapus file yang umurnya > 5 jam (300 menit) + subfolder kosong
        find "$d" -type f -mmin +300 -delete 2>/dev/null || true
        find "$d" -mindepth 1 -type d -empty -delete 2>/dev/null || true
      fi
    fi
  done
}

refresh_nginx_web() {
  if command -v nginx >/dev/null 2>&1; then
    echo "[+] Memperbarui izin akses folder website & memuat ulang Nginx..."
    chmod 711 /root 2>/dev/null || true
    for w in "${WEB_DIRS[@]}"; do
      if [ -d "$w" ]; then
        OWNER_USER=$(stat -c '%U' "$(dirname "$w")")
        chmod o+x "$(dirname "$w")" 2>/dev/null || true
        chown -R "$OWNER_USER":www-data "$w"
        find "$w" -type d -exec chmod 2755 {} +
        find "$w" -type f -exec chmod 644 {} +
      fi
    done

    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx
      echo "[+] Berhasil! Izin file website diperbarui & Nginx telah di-reload."
    else
      echo "[-] Peringatan: Konfigurasi Nginx bermasalah, reload dibatalkan!"
      nginx -t
    fi
  fi
}

# ------------------------------------------------------------------------------
# MODE CEPAT (Dipanggil lewat perintah 'refresh-web'): Hanya Refresh Nginx
# ------------------------------------------------------------------------------
if [ "$MODE" = "--web-only" ]; then
  refresh_nginx_web
  exit 0
fi

# ------------------------------------------------------------------------------
# MODE PENUH (Saat dijalankan manual atau otomatis setiap 5 jam)
# ------------------------------------------------------------------------------

CURRENT_SCRIPT="$(readlink -f "$0")"
if [ "$CURRENT_SCRIPT" != "$SCRIPT_PATH" ]; then
  cp -f "$CURRENT_SCRIPT" "$SCRIPT_PATH"
  chmod +x "$SCRIPT_PATH"
  echo "[+] Menyalin script secara permanen ke $SCRIPT_PATH..."
fi

# Buat shortcut perintah 'refresh-web' dan 'clean-stb' agar bisa dipanggil dari mana saja
cat << 'EOS' > /usr/local/bin/refresh-web
#!/bin/bash
sudo /bin/bash /root/cleanup.sh --web-only
EOS
chmod +x /usr/local/bin/refresh-web

cat << 'EOS' > /usr/local/bin/clean-stb
#!/bin/bash
sudo /bin/bash /root/cleanup.sh "$@"
EOS
chmod +x /usr/local/bin/clean-stb

# Hapus file cron lama yang duplikat agar tidak bentrok
rm -f /etc/cron.d/n8n-cleaner /etc/cron.d/n8n-download-limiter /etc/cron.daily/n8n-cleaner /usr/local/bin/n8n-cleaner.sh /usr/local/bin/limit-downloads /root/refresh.sh 2>/dev/null || true

# 1. Fitur Otomatisasi Cron (Murni setiap 5 jam, TANPA batasan jumlah file)
echo "[+] Memperbarui jadwal otomatis di Cron (Setiap 5 Jam, Tanpa Batas Jumlah File)..."
(
  crontab -l 2>/dev/null | grep -v "$SCRIPT_PATH" || true
  echo "0 */5 * * * /bin/bash $SCRIPT_PATH >/dev/null 2>&1"
) | crontab -
echo "[+] Berhasil! Pembersihan otomatis tiap 5 jam telah aktif."

echo "[+] Memulai pembersihan menyeluruh sistem Armbian..."
echo "--------------------------------------------------"
echo "Kapasitas SEBELUM pembersihan:"
df -h / | awk 'NR==2 {print "Terpakai: " $3 " dari " $2 " (" $5 ") - Sisa: " $4}'
echo "--------------------------------------------------"

