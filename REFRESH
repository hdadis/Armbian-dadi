sudo tee /root/cleanup.sh >/dev/null << 'EOF'
#!/bin/bash

# ==============================================================================
# Script Pembersihan Menyeluruh, Auto-Cron & Refresh Nginx (Armbian STB HG680P)
# Terintegrasi: n8n (5 Jam & Kuota 15 File), Purge Compiler, MOCP Safe, AdGuard, Nginx
# ==============================================================================

if [ "$EUID" -ne 0 ]; then
  echo "[-] Harap jalankan script ini sebagai root (gunakan: sudo bash $0)"
  exit 1
fi

SCRIPT_PATH="/root/cleanup.sh"
MAX_FILES=15
MODE="${1:-full}"

CLEAN_DIRS=(
  "/home/dadi/.n8n/binaryData"
  "/home/dadi/Downloads"
  "/var/www/n8n/downloads"
  "/root/.n8n/binaryData"
  "/root/Downloads"
)

WEB_DIRS=(
  "/root/website"
  "/home/armbian/website"
  "/home/dadi/website"
)

clean_n8n_files() {
  for d in "${CLEAN_DIRS[@]}"; do
    if [ -d "$d" ]; then
      find "$d" -mindepth 1 -delete 2>/dev/null || true
    fi
  done
}

refresh_nginx_web() {
  if command -v nginx >/dev/null 2>&1; then
    echo "[+] Memperbarui izin akses folder website & memuat ulang Nginx..."
    chmod 711 /root 2>/dev/null || true
    for w in "${WEB_DIRS[@]}"; do
      if [ -d "$w" ]; then
        OWNER_USER=$(stat -c '%U' "$(dirname "$w")")
        chmod o+x "$(dirname "$w")" 2>/dev/null || true
        chown -R "$OWNER_USER":www-data "$w"
        find "$w" -type d -exec chmod 2755 {} +
        find "$w" -type f -exec chmod 644 {} +
      fi
    done

    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx
      echo "[+] Berhasil! Izin file website diperbarui & Nginx telah di-reload."
    else
      echo "[-] Peringatan: Konfigurasi Nginx bermasalah, reload dibatalkan!"
      nginx -t
    fi
  fi
}

# ------------------------------------------------------------------------------
# MODE CEPAT 1 (Dipanggil lewat perintah 'refresh-web'): Hanya Refresh Nginx
# ------------------------------------------------------------------------------
if [ "$MODE" = "--web-only" ]; then
  refresh_nginx_web
  exit 0
fi

# ------------------------------------------------------------------------------
# MODE CEPAT 2 (Dipanggil tiap 10 menit oleh Cron): Cek kuota maksimal 15 file
# ------------------------------------------------------------------------------
if [ "$MODE" = "--quota-only" ]; then
  TOTAL_FILES=0
  for d in "${CLEAN_DIRS[@]}"; do
    if [ -d "$d" ]; then
      COUNT=$(find "$d" -type f 2>/dev/null | wc -l)
      TOTAL_FILES=$((TOTAL_FILES + COUNT))
    fi
  done

  if [ "$TOTAL_FILES" -gt "$MAX_FILES" ]; then
    clean_n8n_files
    find /tmp -mindepth 1 -maxdepth 1 ! -name 'moc*' ! -name 'systemd-private*' -mmin +10 -exec rm -rf {} + 2>/dev/null || true
  fi
  exit 0
fi

# ------------------------------------------------------------------------------
# MODE PENUH (Saat dijalankan manual atau otomatis setiap 5 jam)
# ------------------------------------------------------------------------------

CURRENT_SCRIPT="$(readlink -f "$0")"
if [ "$CURRENT_SCRIPT" != "$SCRIPT_PATH" ]; then
  cp -f "$CURRENT_SCRIPT" "$SCRIPT_PATH"
  chmod +x "$SCRIPT_PATH"
  echo "[+] Menyalin script secara permanen ke $SCRIPT_PATH..."
fi

# Buat shortcut perintah global 'refresh-web' yang mengarah ke mode --web-only
cat << 'EOS' > /usr/local/bin/refresh-web
#!/bin/bash
sudo /bin/bash /root/cleanup.sh --web-only
EOS
chmod +x /usr/local/bin/refresh-web

rm -f /etc/cron.d/n8n-cleaner /usr/local/bin/n8n-cleaner.sh /root/refresh.sh 2>/dev/null || true

# 1. Fitur Otomatisasi Cron (Setiap 5 jam & cek kuota 15 file tiap 10 menit)
echo "[+] Memperbarui jadwal otomatis di Cron (Setiap 5 Jam & Kuota $MAX_FILES File)..."
(
  crontab -l 2>/dev/null | grep -v "$SCRIPT_PATH" || true
  echo "0 */5 * * * /bin/bash $SCRIPT_PATH >/dev/null 2>&1"
  echo "*/10 * * * * /bin/bash $SCRIPT_PATH --quota-only >/dev/null 2>&1"
) | crontab -
echo "[+] Berhasil! Pembersihan otomatis tiap 5 jam & penjaga kuota $MAX_FILES file aktif."

echo "[+] Memulai pembersihan menyeluruh sistem Armbian..."
echo "--------------------------------------------------"
echo "Kapasitas SEBELUM pembersihan:"
df -h / | awk 'NR==2 {print "Terpakai: " $3 " dari " $2 " (" $5 ") - Sisa: " $4}'
echo "--------------------------------------------------"

# 2. Pastikan Swap kembali ke ukuran ideal 1GB (1024MB) jika masih 1.5GB sisa instalasi
if [ -f /swapfile ]; then
  SWAP_MB=$(du -m /swapfile | cut -f1)
  if [ "$SWAP_MB" -gt 1100 ]; then
    echo "[+] Mengecilkan /swapfile dari ${SWAP_MB}MB kembali ke default 1024MB (1GB)..."
    swapoff /swapfile 2>/dev/null || true
    rm -f /swapfile
    dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null 2>&1
    swapon /swapfile
  fi
fi

# 3. Membersihkan semua file unduhan / binary tersimpan n8n
echo "[+] Menghapus semua file unduhan & binary tersimpan n8n..."
clean_n8n_files

# 4. Hapus paket kompilator (build-essential ~200MB) HANYA jika n8n sudah terinstal
if command -v n8n >/dev/null 2>&1; then
  if dpkg -l | grep -q "^ii  build-essential"; then
    echo "[+] n8n sudah terinstal! Menghapus build-essential (gcc/g++) untuk hemat ~200MB..."
    apt-get remove --purge -y build-essential g++ gcc dpkg-dev >/dev/null 2>&1 || true
  fi
fi

# 5. Membersihkan cache package APT, file .deb sisa, dan orphan packages
echo "[+] Membersihkan cache APT, paket sisa, dan konfigurasi usang (rc)..."
apt-get autoremove --purge -y >/dev/null 2>&1 || true
dpkg -l | awk '/^rc/ {print $2}' | xargs -r dpkg --purge >/dev/null 2>&1 || true
apt-get autoclean -y >/dev/null 2>&1 || true
apt-get clean -y >/dev/null 2>&1 || true
rm -rf /var/lib/apt/lists/*

# 6. Membersihkan cache NPM secara langsung (aman walau disk 100% penuh)
echo "[+] Membersihkan cache NPM (root & semua user)..."
rm -rf /root/.npm /home/*/.npm /root/.node-gyp /home/*/.node-gyp 2>/dev/null || true

# 7. Memangkas log system (Systemd Journal & PostgreSQL log lama)
echo "[+] Memangkas log systemd-journal & log sistem..."
journalctl --vacuum-time=1d --vacuum-size=5M 2>/dev/null || true
find /var/log -type f \( -name "*.gz" -o -name "*.1" -o -name "*.old" \) -delete 2>/dev/null || true
truncate -s 0 /var/log/postgresql/*.log 2>/dev/null || true
truncate -s 0 /var/log/nginx/*.log 2>/dev/null || true

# 8. Membersihkan file temporary di /tmp dan /var/tmp (Aman untuk server MOCP)
echo "[+] Membersihkan file temporary (/tmp dan /var/tmp) tanpa memutus MOCP..."
find /tmp -mindepth 1 -maxdepth 1 ! -name 'moc*' ! -name 'systemd-private*' -exec rm -rf {} + 2>/dev/null || true
find /var/tmp -mindepth 1 -maxdepth 1 ! -name 'systemd-private*' -exec rm -rf {} + 2>/dev/null || true

# 9. Membersihkan Query Log AdGuard Home (jika layanannya aktif)
if systemctl is-active --quiet AdGuardHome; then
  echo "[+] Membersihkan query log AdGuard Home..."
  systemctl stop AdGuardHome
  if [ -f /opt/AdGuardHome/data/querylog.json ]; then
    echo '{"data":[]}' > /opt/AdGuardHome/data/querylog.json
  fi
  rm -f /opt/AdGuardHome/data/querylog.json.1 2>/dev/null || true
  systemctl start AdGuardHome
fi

# 10. Membersihkan PM2 log (untuk root dan untuk user biasa seperti dadi)
if command -v pm2 &> /dev/null; then
  echo "[+] Membersihkan log PM2 (root & user n8n)..."
  pm2 flush > /dev/null 2>&1 || true
  for u in /home/*; do
    USERNAME=$(basename "$u")
    if [ -d "$u/.pm2" ]; then
      su - "$USERNAME" -c "pm2 flush >/dev/null 2>&1" || true
      rm -rf "$u/.pm2/logs/*" 2>/dev/null || true
    fi
  done
fi

# 11. Refresh Izin Akses Website & Reload Nginx
refresh_nginx_web

# 12. Membersihkan cache user lokal (root dan semua user di /home)
echo "[+] Membersihkan cache user lokal..."
rm -rf /root/.cache/* 2>/dev/null || true
rm -rf /home/*/.cache/* 2>/dev/null || true

# 13. Menyegarkan RAM Cache
echo "[+] Menyegarkan cache RAM sistem..."
sync && echo 3 > /proc/sys/vm/drop_caches

echo "--------------------------------------------------"
echo "Kapasitas SESUDAH pembersihan:"
df -h / | awk 'NR==2 {print "Terpakai: " $3 " dari " $2 " (" $5 ") - Sisa: " $4}'
echo "--------------------------------------------------"
echo "Status RAM & Swap Saat Ini:"
free -h
echo "--------------------------------------------------"
echo "[+] PEMBERSIHAN & REFRESH NGINX SELESAI!"
echo "[+] Jadwal otomatis: Tiap 5 jam (Full) | Tiap 10 menit (Kuota $MAX_FILES file)."
echo "[+] Ketik 'refresh-web' kapan saja untuk refresh cepat Nginx."
echo "--------------------------------------------------"
EOF

sudo chmod +x /root/cleanup.sh
