sudo tee /root/cleanup.sh >/dev/null << 'EOF'
#!/bin/bash

# ==============================================================================
# Cleanup & Refresh STB Armbian HG680P  (v2)
# Layanan: AdGuardHome, Unbound, Samba, Shinobi, MOCP, CUPS, Nginx, n8n,
#          Cloudflared, Telegram, emulator PS1/NES/GBA, aria2 + yt-dlp
#
# PRINSIP: hanya membersihkan LOG, CACHE, FILE SEMENTARA & UNDUHAN LAMA.
#   TIDAK PERNAH menyentuh: konfigurasi, database, kredensial/token, save game,
#   ROM, rekaman Shinobi, playlist MOC, dan folder mount jaringan (sshfs/cifs/nfs
#   seperti /mnt/External/Downloads/IDM).
#
# Perintah:
#   clean-stb            pembersihan penuh manual (APT, swap, RAM, dll)
#   clean-stb --all      seperti di atas + hapus SEMUA file unduhan n8n sekarang
#   clean-stb --auto     versi ringan & aman (ini yang dipakai cron tiap 5 jam)
#   refresh-web          hanya rapikan izin website & reload Nginx
# ==============================================================================

if [ "$EUID" -ne 0 ]; then
  echo "[-] Harap jalankan script ini sebagai root (gunakan: sudo bash $0)"
  exit 1
fi

# cron punya PATH minim; pastikan pm2/n8n/dll tetap ketemu
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

SCRIPT_PATH="/root/cleanup.sh"
LOG_FILE="/var/log/cleanup-stb.log"
MODE="${1:-full}"

case "$MODE" in
  full|--all|--auto|--web-only) ;;
  *) echo "Pemakaian: clean-stb [--all | --auto | --web-only]"; exit 1 ;;
esac

# ------------------------------------------------------------------------------
# PENGATURAN (ubah di sini kalau perlu)
# ------------------------------------------------------------------------------
KEEP_HOURS=5                    # umur file unduhan n8n sebelum dihapus
JOURNAL_KEEP_TIME="2d"          # log systemd disimpan maksimal sekian hari
JOURNAL_KEEP_SIZE="20M"         # dan maksimal sekian ukuran
ADGUARD_DIR="/opt/AdGuardHome"  # lokasi AdGuard Home (dideteksi otomatis jika beda)
ADGUARD_AUTO_RESET_MB=20        # mode otomatis: reset statistik AdGuard hanya jika > sekian MB
PURGE_COMPILER="no"             # "yes" = hapus build-essential (gcc/g++) saat clean-stb manual
SWAP_TARGET_MB=1024             # ukuran ideal /swapfile

CLEAN_DIRS=(
  "/root/n8n/downloads"
  "/home/node/downloads"
  "/home/dadi/.n8n/binaryData"
  "/home/dadi/Downloads"
  "/var/www/n8n/downloads"
  "/root/.n8n/binaryData"
  "/root/Downloads"
)

# Tambahkan folder unduhan lain di sini (misal folder unduhan bot Telegram)
EXTRA_CLEAN_DIRS=(
)

WEB_DIRS=(
  "/root/website"
  "/home/armbian/website"
  "/home/dadi/website"
)

# Hanya file LOG yang dikosongkan (isi dikosongkan, file & izinnya tetap)
LOG_GLOBS=(
  "/var/log/nginx/*.log"
  "/var/log/postgresql/*.log"
  "/var/log/mysql/*.log"
  "/var/log/mariadb/*.log"
  "/var/log/samba/log.*"
  "/var/log/cups/*_log"
  "/var/log/unbound/*.log"
  "/var/log/unbound.log"
  "/var/log/cloudflared*.log"
  "/var/log/cloudflared/*.log"
  "/var/log/AdGuardHome*.log"
  "/home/Shinobi/logs/*"
)

SERVICES=(AdGuardHome unbound smbd nmbd cups nginx cloudflared mariadb mysql postgresql aria2 ariang)

ALL_CLEAN_DIRS=("${CLEAN_DIRS[@]}" "${EXTRA_CLEAN_DIRS[@]}")

# ------------------------------------------------------------------------------
# FUNGSI BANTU
# ------------------------------------------------------------------------------
log()  { echo "[+] $*"; }
warn() { echo "[-] $*"; }
sep()  { echo "--------------------------------------------------"; }

show_disk() {
  df -h / | awk 'NR==2 {print "Terpakai: " $3 " dari " $2 " (" $5 ") - Sisa: " $4}'
}

# true jika path berada di mount jaringan (sshfs/cifs/nfs) -> TIDAK BOLEH dibersihkan
is_remote_fs() {
  local fs
  fs=$(findmnt -n -o FSTYPE -T "$1" 2>/dev/null | head -n1)
  case "$fs" in
    fuse*|cifs|smb3|nfs|nfs4) return 0 ;;
  esac
  return 1
}

# Hanya proses yt-dlp yang sebenarnya (perintah diawali .../yt-dlp, atau python .../yt-dlp).
# Proses lain yang kebetulan memuat kata "yt-dlp" (grep, tail, shell, dll) TIDAK dihitung.
yt_running() {
  YT_PIDS=$(pgrep -f '^([^ ]*python[0-9.]* )?[^ ]*/yt-dlp( |$)' 2>/dev/null | tr '\n' ' ')
  [ -n "$YT_PIDS" ]
}

# ------------------------------------------------------------------------------
# PEMBERSIHAN
# ------------------------------------------------------------------------------
clean_download_dirs() {
  local force_all="${1:-false}" d
  for d in "${ALL_CLEAN_DIRS[@]}"; do
    [ -d "$d" ] || continue
    [ -L "$d" ] && continue
    if is_remote_fs "$d"; then
      warn "Lewati $d (folder jaringan/mount, tidak disentuh)"
      continue
    fi
    if [ "$force_all" = "true" ]; then
      find "$d" -xdev -mindepth 1 -delete 2>/dev/null || true
    else
      find "$d" -xdev -type f -mmin +$((KEEP_HOURS * 60)) -delete 2>/dev/null || true
      find "$d" -xdev -mindepth 1 -type d -empty -delete 2>/dev/null || true
    fi
  done
}

# File sementara & log unduhan YouTube (yt/ytmp3/ytm4a). Dilewati jika masih ada unduhan jalan.
clean_yt_temp() {
  local mode="$1"
  [ -d /var/tmp/yt ] || [ -d /var/tmp/yt-logs ] || return 0
  if yt_running; then
    log "yt-dlp masih berjalan (PID: ${YT_PIDS}), file sementara & log unduhan YouTube dilewati."
    return 0
  fi
  log "Membersihkan file sementara & log unduhan YouTube..."
  if [ "$mode" = "all" ]; then
    find /var/tmp/yt /var/tmp/yt-logs -xdev -mindepth 1 -delete 2>/dev/null || true
  else
    find /var/tmp/yt /var/tmp/yt-logs -xdev -mindepth 1 -mtime +0 -delete 2>/dev/null || true
    find /var/tmp/yt-logs -xdev -xtype l -delete 2>/dev/null || true
  fi
}

# Hanya hapus yang sudah lama tak disentuh, supaya proses yang sedang jalan (MOCP,
# Shinobi, ffmpeg, dll) tidak terganggu. Tidak pernah menyeberang ke mount lain.
clean_tmp() {
  local age_min="${1:-60}"
  log "Membersihkan file temporary lama di /tmp dan /var/tmp (> ${age_min} menit)..."
  find /tmp -xdev -mindepth 1 -maxdepth 1 -mmin +"$age_min" \
    ! -name 'moc*' ! -name 'systemd-private*' ! -name 'tmux-*' ! -name 'ssh-*' ! -name '.X11-unix' \
    -exec rm -rf --one-file-system {} + 2>/dev/null || true
  find /var/tmp -xdev -mindepth 1 -maxdepth 1 -mmin +"$age_min" \
    ! -name 'systemd-private*' ! -name 'yt' ! -name 'yt-logs' \
    -exec rm -rf --one-file-system {} + 2>/dev/null || true
}

clean_caches() {
  local c
  log "Membersihkan cache NPM & cache user (UI n8n, save game & konfigurasi emulator aman)..."
  rm -rf --one-file-system /root/.npm /home/*/.npm /root/.node-gyp /home/*/.node-gyp 2>/dev/null || true
  for c in /root/.cache /home/*/.cache; do
    [ -d "$c" ] || continue
    find "$c" -xdev -mindepth 1 -maxdepth 1 ! -name 'n8n' \
      -exec rm -rf --one-file-system {} + 2>/dev/null || true
  done
}

truncate_logs() {
  local pattern f
  log "Mengosongkan log layanan (Nginx, Samba, CUPS, Unbound, Cloudflared, AdGuard, Shinobi, DB)..."
  for pattern in "${LOG_GLOBS[@]}"; do
    for f in $pattern; do
      if [ -f "$f" ] && [ ! -L "$f" ]; then truncate -s 0 "$f" 2>/dev/null; fi
    done
  done
  # log sistem besar di /var/log (di Armbian sering ada di RAM) + log lama terotasi
  find /var/log -xdev -maxdepth 1 -type f -size +5M ! -name 'cleanup-stb.log' \
    -exec truncate -s 0 {} + 2>/dev/null || true
  find /var/log -xdev -type f \( -name "*.gz" -o -name "*.1" -o -name "*.old" \) -delete 2>/dev/null || true
}

clean_pm2_logs() {
  local d u
  log "Membersihkan log PM2 (root & semua user)..."
  if command -v pm2 >/dev/null 2>&1; then
    pm2 flush >/dev/null 2>&1 9>&- || true
    for u in /home/*; do
      [ -d "$u/.pm2" ] && su -s /bin/bash -l "$(basename "$u")" -c "pm2 flush >/dev/null 2>&1" 9>&- 2>/dev/null
    done
  fi
  for d in /root/.pm2/logs /home/*/.pm2/logs; do
    [ -d "$d" ] && find "$d" -xdev -type f -name '*.log' -exec truncate -s 0 {} + 2>/dev/null
  done
}

vacuum_journal() {
  log "Memangkas log systemd-journal (simpan ${JOURNAL_KEEP_TIME}, maks ${JOURNAL_KEEP_SIZE})..."
  journalctl --vacuum-time="$JOURNAL_KEEP_TIME" --vacuum-size="$JOURNAL_KEEP_SIZE" >/dev/null 2>&1 || true
}

# Hanya query log, statistik & cache DNS. TIDAK menyentuh AdGuardHome.yaml,
# folder filters/ (blocklist) dan sessions.db (login).
clean_adguard() {
  local mode="$1" data size_mb wd
  systemctl is-active --quiet AdGuardHome 2>/dev/null || return 0
  if [ ! -d "$ADGUARD_DIR/data" ]; then
    wd=$(systemctl show -p WorkingDirectory --value AdGuardHome 2>/dev/null)
    if [ -n "$wd" ] && [ -d "$wd/data" ]; then ADGUARD_DIR="$wd"; fi
  fi
  data="$ADGUARD_DIR/data"
  if [ ! -d "$data" ]; then
    warn "Folder data AdGuard Home tidak ditemukan, dilewati."
    return 0
  fi
  size_mb=$(du -cm "$data"/querylog.json* "$data"/stats.db "$data"/cache.db 2>/dev/null | tail -n1 | cut -f1)
  size_mb=${size_mb:-0}
  if [ "$mode" = "auto" ] && [ "$size_mb" -lt "$ADGUARD_AUTO_RESET_MB" ]; then
    log "AdGuard Home: log & statistik baru ${size_mb}MB (< ${ADGUARD_AUTO_RESET_MB}MB), dilewati agar DNS tidak terputus."
    return 0
  fi
  log "Membersihkan Query Log, Statistik, & Cache AdGuard Home (${size_mb}MB)..."
  systemctl stop AdGuardHome
  rm -f "$data"/querylog.json* "$data"/stats.db "$data"/cache.db 2>/dev/null || true
  systemctl start AdGuardHome
  sleep 2
  if systemctl is-active --quiet AdGuardHome; then
    log "Selesai! AdGuard Home aktif lagi (pengaturan, blocklist & login tidak disentuh)."
  else
    warn "AdGuard Home TIDAK aktif setelah dibersihkan! Cek: systemctl status AdGuardHome"
  fi
}

# Rapikan izin website tanpa mengubah yang sudah benar, lalu reload Nginx.
# Bit eksekusi file dipertahankan. Reload hanya jika ada yang berubah (atau dipaksa).
refresh_nginx_web() {
  local force="${1:-true}" w parent owner n changed=0 rootmode
  command -v nginx >/dev/null 2>&1 || return 0
  log "Memeriksa izin akses folder website..."
  rootmode=$(stat -c '%a' /root)
  if [ $((rootmode % 2)) -eq 0 ]; then chmod 711 /root 2>/dev/null || true; fi
  for w in "${WEB_DIRS[@]}"; do
    [ -d "$w" ] || continue
    parent="$(dirname "$w")"
    owner="$(stat -c '%U' "$parent")"
    chmod o+x "$parent" 2>/dev/null || true
    n=$(find "$w" -xdev \( ! -user "$owner" -o ! -group www-data \) -print -exec chown -h "$owner":www-data {} + 2>/dev/null | wc -l)
    changed=$((changed + n))
    n=$(find "$w" -xdev -type d ! -perm 2755 -print -exec chmod 2755 {} + 2>/dev/null | wc -l)
    changed=$((changed + n))
    n=$(find "$w" -xdev -type f -perm /111 ! -perm 755 -print -exec chmod 755 {} + 2>/dev/null | wc -l)
    changed=$((changed + n))
    n=$(find "$w" -xdev -type f ! -perm /111 ! -perm 644 -print -exec chmod 644 {} + 2>/dev/null | wc -l)
    changed=$((changed + n))
  done
  if [ "$force" = "true" ] || [ "$changed" -gt 0 ]; then
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx
      log "Izin website dirapikan ($changed perubahan) & Nginx telah di-reload."
    else
      warn "Konfigurasi Nginx bermasalah, reload dibatalkan!"
      nginx -t
    fi
  fi
}

# ------------------------------------------------------------------------------
# KHUSUS MODE PENUH (manual)
# ------------------------------------------------------------------------------
clean_apt() {
  local list
  if [ "$PURGE_COMPILER" = "yes" ] && command -v n8n >/dev/null 2>&1; then
    if dpkg -l | grep -qE "^ii\s+build-essential"; then
      log "Menghapus build-essential (gcc/g++) untuk hemat ~200MB..."
      apt-get remove --purge -y build-essential g++ gcc dpkg-dev >/dev/null 2>&1 || true
    fi
  fi
  log "Membersihkan cache APT, paket sisa, dan konfigurasi usang (rc)..."
  list=$(apt-get -s autoremove --purge 2>/dev/null | awk '/^(Purg|Remv)/ {printf "%s ", $2}')
  [ -n "$list" ] && log "Paket yatim yang dihapus: $list"
  apt-get autoremove --purge -y >/dev/null 2>&1 || true
  dpkg -l | awk '/^rc/ {print $2}' | xargs -r dpkg --purge >/dev/null 2>&1 || true
  apt-get autoclean -y >/dev/null 2>&1 || true
  apt-get clean -y >/dev/null 2>&1 || true
  rm -rf /var/lib/apt/lists/*   # catatan: sebelum apt install berikutnya jalankan apt update
}

fix_swapfile() {
  local swap_mb used_mb avail_mb
  [ -f /swapfile ] || return 0
  swap_mb=$(du -m /swapfile | cut -f1)
  [ "$swap_mb" -gt $((SWAP_TARGET_MB + 76)) ] || return 0
  used_mb=$(free -m | awk '/^Swap:/ {print $3}')
  avail_mb=$(free -m | awk '/^Mem:/ {print $7}')
  if [ "$used_mb" -ge $((avail_mb - 200)) ]; then
    warn "Swap terpakai ${used_mb}MB & RAM tersedia ${avail_mb}MB: pengecilan swap ditunda agar tidak OOM."
    return 0
  fi
  log "Mengecilkan /swapfile dari ${swap_mb}MB ke ${SWAP_TARGET_MB}MB..."
  swapoff /swapfile 2>/dev/null || true
  rm -f /swapfile
  dd if=/dev/zero of=/swapfile bs=1M count="$SWAP_TARGET_MB" status=none
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null 2>&1
  swapon /swapfile
}

refresh_ram() {
  local mode="$1" total avail
  total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
  # mode otomatis: hanya saat RAM tersedia <= 15%
  if [ "$mode" = "auto" ] && [ $((avail * 100 / total)) -gt 15 ]; then return 0; fi
  log "Menyegarkan cache RAM sistem..."
  sync && echo 3 > /proc/sys/vm/drop_caches
}

# ------------------------------------------------------------------------------
# LAPORAN (hanya melaporkan, tidak mengubah apa pun)
# ------------------------------------------------------------------------------
check_services() {
  local s
  echo "Status layanan:"
  for s in "${SERVICES[@]}"; do
    systemctl list-unit-files "$s.service" 2>/dev/null | grep -q "^$s.service" || continue
    systemctl is-enabled --quiet "$s" 2>/dev/null || continue
    if systemctl is-active --quiet "$s"; then
      echo "  [OK] $s"
    else
      echo "  [!!] $s TIDAK AKTIF"
    fi
  done
}

report_shinobi() {
  local d
  for d in /home/Shinobi/videos /opt/Shinobi/videos; do
    [ -d "$d" ] && echo "  Rekaman Shinobi ($d): $(du -sh "$d" 2>/dev/null | cut -f1) - tidak dihapus script ini (atur retensi di Shinobi)"
  done
}

trim_log() {
  local tmp
  [ -f "$LOG_FILE" ] || return 0
  tmp=$(mktemp)
  tail -n 300 "$LOG_FILE" > "$tmp" && cat "$tmp" > "$LOG_FILE"
  rm -f "$tmp"
}

setup_shortcuts_and_cron() {
  local current
  current="$(readlink -f "$0")"
  if [ "$current" != "$SCRIPT_PATH" ]; then
    cp -f "$current" "$SCRIPT_PATH"
    chmod +x "$SCRIPT_PATH"
    log "Menyalin script secara permanen ke $SCRIPT_PATH..."
  fi

  # Shortcut perintah agar bisa dipanggil dari mana saja
cat << 'EOS' > /usr/local/bin/refresh-web
#!/bin/bash
sudo /bin/bash /root/cleanup.sh --web-only
EOS
  chmod +x /usr/local/bin/refresh-web

cat << 'EOS' > /usr/local/bin/clean-stb
#!/bin/bash
sudo /bin/bash /root/cleanup.sh "$@"
EOS
  chmod +x /usr/local/bin/clean-stb

  # Hapus file cron lama yang duplikat agar tidak bentrok
  rm -f /etc/cron.d/n8n-cleaner /etc/cron.d/n8n-download-limiter /etc/cron.daily/n8n-cleaner \
        /usr/local/bin/n8n-cleaner.sh /usr/local/bin/limit-downloads /root/refresh.sh 2>/dev/null || true

  if command -v crontab >/dev/null 2>&1; then
    log "Memperbarui jadwal otomatis di Cron (setiap 5 jam, mode --auto yang ringan & aman)..."
    (
      crontab -l 2>/dev/null | grep -v "$SCRIPT_PATH" || true
      echo "0 */5 * * * /bin/bash $SCRIPT_PATH --auto >> $LOG_FILE 2>&1"
    ) | crontab -
    log "Berhasil! Pembersihan otomatis tiap 5 jam aktif (riwayat: $LOG_FILE)."
  else
    warn "cron belum terpasang. Pasang dengan: apt install -y cron"
  fi
}

# ------------------------------------------------------------------------------
# ALUR UTAMA
# ------------------------------------------------------------------------------
# Cegah dua pembersihan berjalan bersamaan
exec 9>/run/cleanup-stb.lock
if ! flock -n 9; then
  echo "[-] Pembersihan lain sedang berjalan, dibatalkan."
  exit 0
fi

# MODE CEPAT: hanya refresh Nginx
if [ "$MODE" = "--web-only" ]; then
  refresh_nginx_web true
  exit 0
fi

# MODE OTOMATIS (cron tiap 5 jam): ringan, tidak mengubah paket/swap/izin tanpa perlu
if [ "$MODE" = "--auto" ]; then
  echo "=== $(date '+%F %T') | pembersihan otomatis ==="
  BEFORE="$(show_disk)"
  clean_download_dirs false
  clean_yt_temp auto
  clean_caches
  truncate_logs
  clean_pm2_logs
  vacuum_journal
  clean_tmp 1440
  clean_adguard auto
  refresh_nginx_web false
  refresh_ram auto
  echo "Sebelum: $BEFORE"
  echo "Sesudah: $(show_disk)"
  check_services
  trim_log
  exit 0
fi

# MODE PENUH (manual): clean-stb  /  clean-stb --all
setup_shortcuts_and_cron

log "Memulai pembersihan menyeluruh sistem Armbian..."
sep
echo "Kapasitas SEBELUM pembersihan:"
show_disk
sep

fix_swapfile

if [ "$MODE" = "--all" ]; then
  log "Menghapus SEMUA file unduhan & binary tersimpan n8n (Mode Paksa)..."
  clean_download_dirs true
else
  log "Menghapus file unduhan & binary tersimpan n8n yang berumur > ${KEEP_HOURS} jam..."
  clean_download_dirs false
fi

clean_yt_temp all
clean_apt
clean_caches
truncate_logs
clean_pm2_logs
vacuum_journal
clean_tmp 60
clean_adguard full
refresh_nginx_web true
refresh_ram full

sep
echo "Kapasitas SESUDAH pembersihan:"
show_disk
sep
echo "Status RAM & Swap Saat Ini:"
free -h
sep
check_services
report_shinobi
sep
log "PEMBERSIHAN & REFRESH SELESAI! Pengaturan layanan tidak diubah."
log "Jadwal otomatis : tiap 5 jam (mode --auto, riwayat di $LOG_FILE)."
log "Perintah cepat  : 'clean-stb' (bersih penuh) | 'clean-stb --all' (hapus semua unduhan n8n) | 'refresh-web' (izin web + Nginx)."
sep
EOF

sudo chmod +x /root/cleanup.sh
