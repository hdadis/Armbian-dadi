# 6. Hak akses & Reload Nginx
chown -R www-data:www-data "$WEB_DIR"
chmod -R 755 "$WEB_DIR"

if [ -d "$ROM_SRC" ]; then
    chown -R www-data:www-data "$ROM_SRC"
    chmod -R 755 "$ROM_SRC"
fi

tee "$NGINX_CONF" > /dev/null << NGINXEOF
server {
    listen $PORT;
    server_name _;

    root $WEB_DIR;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }
}
NGINXEOF

if [ ! -f /etc/nginx/sites-enabled/gaming ]; then
    ln -s "$NGINX_CONF" /etc/nginx/sites-enabled/
fi

nginx -t
systemctl reload nginx

LOCAL_IP=$(hostname -I | awk '{print $1}')

echo ""
echo "=========================================================="
echo " UPDATE BERHASIL!"
echo " Path ROM: $ROM_SRC"
echo " Renderer Fix & Multi-BIOS siap digunakan."
echo " Akses via: http://$LOCAL_IP:$PORT"
echo " (Refresh paksa browser dengan Ctrl + F5)"
echo "=========================================================="
EOF
