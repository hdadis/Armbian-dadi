cat << 'EOF' > install.sh
#!/bin/bash
set -e

if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

PORT=8085
WEB_DIR="/var/www/gaming"
ROM_SRC="/mnt/External/Dokumen/Software/GAMES/STB"
ROM_DIR="$WEB_DIR/roms"
NGINX_CONF="/etc/nginx/sites-available/gaming"

echo "=== Memperbarui Server Gaming Retro HG680P (Renderer Fix & Multi-Region BIOS) ==="

# 1. Dependensi
apt update -qq
apt install -y curl nginx

# 2. Direktori web
mkdir -p "$WEB_DIR"

# 3. Symlink ROM
if [ -d "$ROM_SRC" ]; then
    rm -rf "$ROM_DIR"
    ln -s "$ROM_SRC" "$ROM_DIR"
else
    mkdir -p "$ROM_DIR"
fi

# 4. Unduh BIOS PS1 jika belum ada
if [ -d "$ROM_SRC" ]; then
    [ ! -f "$ROM_SRC/scph5501.bin" ] && curl -L --retry 3 -o "$ROM_SRC/scph5501.bin" "https://github.com/Abdess/retroarch_system/raw/libretro/Sony%20-%20PlayStation/scph5501.bin"
    [ ! -f "$ROM_SRC/scph5500.bin" ] && curl -L --retry 3 -o "$ROM_SRC/scph5500.bin" "https://github.com/Abdess/retroarch_system/raw/libretro/Sony%20-%20PlayStation/scph5500.bin"
    [ ! -f "$ROM_SRC/scph5502.bin" ] && curl -L --retry 3 -o "$ROM_SRC/scph5502.bin" "https://github.com/Abdess/retroarch_system/raw/libretro/Sony%20-%20PlayStation/scph5502.bin"
fi

# 5. Tulis file index.html
tee "$WEB_DIR/index.html" > /dev/null << 'HTMLEOF'
