cat > ~/install-n8n.sh << 'EOF_SCRIPT'
#!/bin/bash
# =====================================================================
#  n8n + PostgreSQL + PM2 + Cloudflared + Auto-Cleaner (HG680P 1GB)
#  Versi Final Anti-OOM & Anti-Disk-Full (n8n@1.94.0 + Node 22)
#  Jalankan sebagai user biasa (BUKAN root):  bash install-n8n.sh
# =====================================================================
set -eu

# ------------------------- KONFIGURASI -------------------------------
DOMAIN="ai.balai.my.id"
LOCAL_IP="192.168.18.20"
DB_NAME="n8n"
DB_USER="n8n_user"
PROJECT_DIR="/var/www/n8n"
N8N_VERSION="1.94.0"          # Dipin ke 1.94.0 agar stabil & ringan
NODE_MAJOR="22"               # Node 22 LTS
INSTALL_SWAP_MB="1536"        # 1.5 GB sementara khusus saat npm install agar tidak Killed
FINAL_SWAP_MB="1024"          # 1 GB default setelah instalasi selesai (hemat eMMC)
HEAP_MB="400"                 # V8 heap n8n saat berjalan (aman untuk RAM 1GB)
RESTART_MB="520"              # PM2 auto-restart jika RSS melewati ini
MAX_FILES=15                  # Maksimal jumlah file unduhan/binary sebelum dihapus semua

# 0.0.0.0 agar bisa diakses via http://192.168.18.20:5678 dan via domain
LISTEN_ADDRESS="0.0.0.0"
SETUP_NGINX="true"
SECURE_COOKIE="false"         # False agar login via IP lokal HTTP tidak terblokir

# Token Cloudflare Tunnel
CF_TOKEN="eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9"
# ---------------------------------------------------------------------

echo "=================================================="
echo "   n8n $N8N_VERSION + PostgreSQL Setup (HG680P 1GB) "
echo "=================================================="

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: Jangan jalankan sebagai root. Gunakan user biasa (misal: dadi)."
    exit 1
fi

ENV_FILE="$PROJECT_DIR/.env"
N8N_USER_DIR="$HOME/.n8n"

# [0/9] Bersihkan sisa sampah lama & siapkan Swap
echo "[0/9] Membersihkan sisa cache lama & memeriksa Swap..."
sudo rm -rf /root/.npm "$HOME/.npm" /tmp/* /var/tmp/*
sudo journalctl --vacuum-time=1s >/dev/null 2>&1 || true

INSTALLED_N8N=$(n8n --version 2>/dev/null || echo "none")
if [ "$INSTALLED_N8N" != "$N8N_VERSION" ]; then
    echo "  Menyiapkan Swap sementara ${INSTALL_SWAP_MB}MB (1.5GB) untuk instalasi n8n..."
    sudo swapoff /swapfile 2>/dev/null || true
    sudo rm -f /swapfile
    sudo dd if=/dev/zero of=/swapfile bs=1M count="$INSTALL_SWAP_MB" status=progress
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
else
    if [ ! -f /swapfile ]; then
        sudo dd if=/dev/zero of=/swapfile bs=1M count="$FINAL_SWAP_MB" status=progress
        sudo chmod 600 /swapfile
        sudo mkswap /swapfile
    fi
    sudo swapon /swapfile 2>/dev/null || true
fi
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab >/dev/null
echo 'vm.swappiness=20' | sudo tee /etc/sysctl.d/99-n8n-swap.conf >/dev/null
sudo sysctl -p /etc/sysctl.d/99-n8n-swap.conf >/dev/null || true

# [1/9] Dependensi sistem
echo "[1/9] Menginstal dependensi sistem..."
sudo apt update -y
sudo apt install -y postgresql postgresql-contrib curl git build-essential \
    ca-certificates gnupg python3 openssl cron
sudo apt-get clean

# [2/9] Node.js + PM2 + n8n
echo "[2/9] Memeriksa Node.js $NODE_MAJOR, PM2 & n8n@$N8N_VERSION..."
if ! command -v node >/dev/null 2>&1 || ! node -v | grep -q "^v${NODE_MAJOR}\."; then
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | sudo -E bash -
    sudo apt install -y nodejs
    sudo apt-get clean
fi
node -v
npm -v

if ! command -v pm2 >/dev/null 2>&1; then
    echo "  Menginstal PM2..."
    sudo npm install -g pm2 --no-audit --no-fund
    sudo rm -rf /root/.npm "$HOME/.npm" /tmp/*
fi

if [ "$INSTALLED_N8N" != "$N8N_VERSION" ]; then
    echo "  Menginstal n8n@$N8N_VERSION (proses ini memakan waktu 5-15 menit di ARM, harap sabar)..."
    sudo rm -rf /usr/lib/node_modules/n8n /usr/lib/node_modules/.n8n*
    sudo rm -rf /usr/local/lib/node_modules/n8n /usr/local/lib/node_modules/.n8n*

    sudo NODE_OPTIONS="--max-old-space-size=1024" npm install -g "n8n@${N8N_VERSION}" \
        --unsafe-perm --no-audit --no-fund --maxsockets 1 --loglevel info

    sudo rm -rf /root/.npm "$HOME/.npm" /tmp/*
else
    echo "  n8n versi $N8N_VERSION sudah terinstal, melewati unduhan ulang."
fi
n8n --version

# [3/9] Secret (dipertahankan jika sudah ada)
echo "[3/9] Menyiapkan secret..."
sudo mkdir -p "$PROJECT_DIR"
sudo chown -R "$USER":"$USER" "$PROJECT_DIR"

DB_PASS=""
ENCRYPTION_KEY=""
if [ -f "$ENV_FILE" ]; then
    DB_PASS=$(grep '^DB_POSTGRESDB_PASSWORD=' "$ENV_FILE" | cut -d= -f2- || true)
    ENCRYPTION_KEY=$(grep '^N8N_ENCRYPTION_KEY=' "$ENV_FILE" | cut -d= -f2- || true)
    cp "$ENV_FILE" "$ENV_FILE.bak"
fi
if [ -z "$ENCRYPTION_KEY" ] && [ -f "$N8N_USER_DIR/config" ]; then
    ENCRYPTION_KEY=$(grep -o '"encryptionKey": *"[^"]*"' "$N8N_USER_DIR/config" | sed 's/.*: *"\(.*\)"/\1/' || true)
fi
[ -n "$DB_PASS" ] || DB_PASS=$(openssl rand -hex 16)
[ -n "$ENCRYPTION_KEY" ] || ENCRYPTION_KEY=$(openssl rand -hex 24)

# [4/9] PostgreSQL
echo "[4/9] Menyiapkan & men-tuning PostgreSQL..."
sudo systemctl enable --now postgresql

sudo -u postgres psql -tc "SELECT 1 FROM pg_roles WHERE rolname = '$DB_USER'" | grep -q 1 || \
    sudo -u postgres psql -c "CREATE USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"
sudo -u postgres psql -c "ALTER USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"

sudo -u postgres psql -tc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" | grep -q 1 || \
    sudo -u postgres psql -c "CREATE DATABASE $DB_NAME OWNER $DB_USER;"
sudo -u postgres psql -c "ALTER DATABASE $DB_NAME OWNER TO $DB_USER;"
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER;"
sudo -u postgres psql -d "$DB_NAME" -c "GRANT ALL ON SCHEMA public TO $DB_USER;"

sudo -u postgres psql -c "ALTER SYSTEM SET shared_buffers = '24MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET work_mem = '2MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET maintenance_work_mem = '16MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET max_connections = 20;"
sudo -u postgres psql -c "ALTER SYSTEM SET effective_cache_size = '96MB';"
sudo systemctl restart postgresql

# [5/9] File .env
echo "[5/9] Menulis $ENV_FILE ..."
if [ "$SECURE_COOKIE" = "true" ]; then COOKIE_VAL="true"; else COOKIE_VAL="false"; fi

cat > "$ENV_FILE" << EOF
# --- Domain & jaringan ---
N8N_HOST=$DOMAIN
N8N_EDITOR_BASE_URL=https://$DOMAIN/
WEBHOOK_URL=https://$DOMAIN/
N8N_PROTOCOL=https
N8N_LISTEN_ADDRESS=$LISTEN_ADDRESS
N8N_PORT=5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=$COOKIE_VAL
NODE_ENV=production
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- Database ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=127.0.0.1
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=$DB_NAME
DB_POSTGRESDB_USER=$DB_USER
DB_POSTGRESDB_PASSWORD=$DB_PASS

# --- Keamanan (JANGAN diubah setelah credential dibuat) ---
N8N_ENCRYPTION_KEY=$ENCRYPTION_KEY

# --- Timezone ---
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# --- Hemat memori & Disk (Khusus HG680P) ---
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_PAYLOAD_SIZE_MAX=15
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=5
EXECUTIONS_DATA_PRUNE_MAX_COUNT=200
N8N_METRICS=false
N8N_LOG_LEVEL=warn
N8N_RUNNERS_ENABLED=false
N8N_DIAGNOSTICS_ENABLED=false
EOF
chmod 600 "$ENV_FILE"

echo ">>> Kunci enkripsi n8n (simpan baik-baik): $ENCRYPTION_KEY"

# [6/9] Jalankan via PM2
echo "[6/9] Menjalankan n8n via PM2..."
cd "$PROJECT_DIR"

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

pm2 delete n8n >/dev/null 2>&1 || true
pm2 start "$(command -v n8n)" --name n8n \
    --interpreter node \
    --node-args="--max-old-space-size=$HEAP_MB" \
    --max-memory-restart "${RESTART_MB}M" \
    -- start
pm2 save
sudo env PATH="$PATH:/usr/bin" pm2 startup systemd -u "$USER" --hp "$HOME" >/dev/null || true
pm2 save

# [7/9] Nginx & Cloudflared Tunnel
if [ "$SETUP_NGINX" = "true" ]; then
    echo "[7/9] Menyiapkan Nginx..."
    sudo apt install -y nginx
    sudo tee /etc/nginx/sites-available/n8n >/dev/null << EOF
server {
    listen 80;
    server_name $DOMAIN $LOCAL_IP _;
    client_max_body_size 15m;

    location / {
        proxy_pass http://127.0.0.1:5678;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
EOF
    sudo ln -sf /etc/nginx/sites-available/n8n /etc/nginx/sites-enabled/n8n
    sudo rm -f /etc/nginx/sites-enabled/default
    sudo nginx -t && sudo systemctl reload nginx
fi

echo "[7b/9] Memasang & Mengonfigurasi Cloudflared Service..."
if ! command -v cloudflared >/dev/null 2>&1; then
    ARCH=$(dpkg --print-architecture)
    echo "  Mengunduh binary cloudflared untuk $ARCH..."
    curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}.deb" -o /tmp/cloudflared.deb
    sudo dpkg -i /tmp/cloudflared.deb
    rm -f /tmp/cloudflared.deb
fi

sudo cloudflared service uninstall 2>/dev/null || true
sudo cloudflared service install "$CF_TOKEN"
sudo systemctl enable --now cloudflared

# [8/9] Auto-Cleaner: Hapus semua file setiap 5 jam & batasi maks 15 file
echo "[8/9] Menyiapkan Auto-Cleaner (Reset tiap 5 jam & Maks $MAX_FILES file)..."
mkdir -p "$N8N_USER_DIR/binaryData" "$HOME/Downloads" "$PROJECT_DIR/downloads"

sudo tee /usr/local/bin/n8n-cleaner.sh >/dev/null << EOF
#!/bin/bash
# Script pembersih otomatis agar STB HG680P tetap fresh dan ringan
MODE="\${1:-check}"
MAX_FILES=$MAX_FILES

DIRS=(
    "$N8N_USER_DIR/binaryData"
    "$HOME/Downloads"
    "$PROJECT_DIR/downloads"
)

clean_all_files() {
    for d in "\${DIRS[@]}"; do
        if [ -d "\$d" ]; then
            find "\$d" -mindepth 1 -delete 2>/dev/null || true
        fi
    done
    find /tmp -mindepth 1 -mmin +10 -not -name "systemd-*" -delete 2>/dev/null || true
    su - "$USER" -c "pm2 flush >/dev/null 2>&1" || true
}

if [ "\$MODE" = "force" ]; then
    clean_all_files
    sync; echo 1 > /proc/sys/vm/drop_caches 2>/dev/null || true
else
    TOTAL_FILES=0
    for d in "\${DIRS[@]}"; do
        if [ -d "\$d" ]; then
            COUNT=\$(find "\$d" -type f 2>/dev/null | wc -l)
            TOTAL_FILES=\$((TOTAL_FILES + COUNT))
        fi
    done

    if [ "\$TOTAL_FILES" -gt "\$MAX_FILES" ]; then
        clean_all_files
    fi
fi
EOF

sudo chmod +x /usr/local/bin/n8n-cleaner.sh

sudo tee /etc/cron.d/n8n-cleaner >/dev/null << EOF
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 1. Setiap 5 jam: Hapus paksa semua file unduhan/tersimpan, tmp, dan flush log
0 */5 * * * root /usr/local/bin/n8n-cleaner.sh force >/dev/null 2>&1

# 2. Setiap 10 menit: Cek jumlah file, jika lebih dari $MAX_FILES file langsung hapus semua
*/10 * * * * root /usr/local/bin/n8n-cleaner.sh check >/dev/null 2>&1
EOF
sudo chmod 644 /etc/cron.d/n8n-cleaner
sudo systemctl enable --now cron

# [9/9] Pembersihan Akhir Sistem & Kembalikan Swap ke Default 1GB
echo "[9/9] Membersihkan sampah apt, cache npm & mengembalikan Swap ke ${FINAL_SWAP_MB}MB (1GB)..."
sudo apt-get clean
sudo apt-get autoclean
sudo apt-get autoremove -y
sudo apt autoremove -y
sudo rm -rf /root/.npm "$HOME/.npm" /tmp/*

# Kembalikan ukuran swap ke 1GB (1024MB) jika saat ini masih berukuran 1.5GB
CURRENT_SWAP_MB=0
if [ -f /swapfile ]; then
    CURRENT_SWAP_MB=$(du -m /swapfile | cut -f1)
fi
if [ "$CURRENT_SWAP_MB" -gt 1100 ]; then
    echo "  Mengecilkan /swapfile kembali ke default ${FINAL_SWAP_MB}MB (1GB)..."
    sudo swapoff /swapfile 2>/dev/null || true
    sudo rm -f /swapfile
    sudo dd if=/dev/zero of=/swapfile bs=1M count="$FINAL_SWAP_MB" status=progress
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
fi

# Tunggu n8n siap (start pertama di ARM + migrasi DB bisa 1-3 menit)
echo "Menunggu n8n siap (maks 3 menit)..."
READY="no"
for i in $(seq 1 36); do
    if curl -fs "http://127.0.0.1:5678/healthz" >/dev/null 2>&1; then READY="yes"; break; fi
    sleep 5
done

echo "=================================================="
if [ "$READY" = "yes" ]; then
    echo " n8n BERJALAN & SIAP DIGUNAKAN!"
    echo " - Akses Lokal  : http://$LOCAL_IP:5678"
    echo " - Akses Publik : https://$DOMAIN/"
else
    echo " n8n sedang melakukan migrasi database awal. Cek dengan: pm2 logs n8n"
fi
echo "--------------------------------------------------"
echo " Status Storage & Memori Saat Ini:"
df -h /
echo "--------------------------------------------------"
free -h
echo "--------------------------------------------------"
pm2 status
echo "=================================================="
EOF_SCRIPT
chmod +x ~/install-n8n.sh
bash ~/install-n8n.sh
