#!/bin/bash
# =====================================================================
#  n8n + PostgreSQL (native) + PM2  -  LOW-RAM (HG680P 1GB) v2
#  Aman dijalankan ulang (idempotent): secret tidak berubah.
#  Jalankan sebagai user biasa (BUKAN root):  bash install-n8n.sh
# =====================================================================
set -eu

# ------------------------- KONFIGURASI -------------------------------
DOMAIN="ai.balai.my.id"
DB_NAME="n8n"
DB_USER="n8n_user"
PROJECT_DIR="/var/www/n8n"
N8N_VERSION="latest"          # sebaiknya di-pin, mis. "1.123.0", setelah cek halaman rilis n8n
NODE_MAJOR="22"               # Node 20 sudah EOL
SWAP_SIZE="1G"                # dibuat hanya jika belum ada swap
HEAP_MB="256"                 # V8 heap n8n
RESTART_MB="600"              # PM2 restart jika RSS melewati ini
# 127.0.0.1 = hanya reverse proxy di mesin ini yang bisa akses (disarankan).
# Ganti ke 0.0.0.0 HANYA jika proxy/tunnel ada di mesin lain.
LISTEN_ADDRESS="127.0.0.1"
SETUP_NGINX="false"           # true = pasang Nginx (HTTP :80) sebagai reverse proxy
SECURE_COOKIE="true"          # butuh akses via HTTPS. Set false jika masih akses via http://IP:5678
# ---------------------------------------------------------------------

echo "=================================================="
echo "   n8n + PostgreSQL LOW-RAM Setup (v2)            "
echo "=================================================="

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: jangan jalankan sebagai root. Pakai user biasa yang punya sudo."
    exit 1
fi

ENV_FILE="$PROJECT_DIR/.env"

# [0/7] Swap (penting: npm install n8n di 1GB RAM sering OOM tanpa swap)
echo "[0/7] Memeriksa swap..."
if [ "$(swapon --show --noheadings | wc -l)" -eq 0 ]; then
    echo "  Tidak ada swap, membuat /swapfile ($SWAP_SIZE)..."
    sudo fallocate -l "$SWAP_SIZE" /swapfile
    sudo chmod 600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
    grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab >/dev/null
    echo 'vm.swappiness=20' | sudo tee /etc/sysctl.d/99-n8n-swap.conf >/dev/null
    sudo sysctl -p /etc/sysctl.d/99-n8n-swap.conf >/dev/null || true
else
    echo "  Swap sudah ada, dilewati."
fi

# [1/7] Dependensi sistem
echo "[1/7] Menginstal dependensi sistem..."
sudo apt update -y
sudo apt install -y postgresql postgresql-contrib curl git build-essential \
    ca-certificates gnupg python3 openssl

# [2/7] Node.js + PM2 + n8n
echo "[2/7] Menginstal Node.js $NODE_MAJOR, PM2 & n8n@$N8N_VERSION..."
curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | sudo -E bash -
sudo apt install -y nodejs
node -v
npm -v
sudo npm install -g pm2 "n8n@${N8N_VERSION}" --unsafe-perm
n8n --version

# [3/7] Secret (dipertahankan jika sudah ada)
echo "[3/7] Menyiapkan secret..."
sudo mkdir -p "$PROJECT_DIR"
sudo chown -R "$USER":"$USER" "$PROJECT_DIR"

DB_PASS=""
ENCRYPTION_KEY=""
if [ -f "$ENV_FILE" ]; then
    DB_PASS=$(grep '^DB_POSTGRESDB_PASSWORD=' "$ENV_FILE" | cut -d= -f2- || true)
    ENCRYPTION_KEY=$(grep '^N8N_ENCRYPTION_KEY=' "$ENV_FILE" | cut -d= -f2- || true)
    cp "$ENV_FILE" "$ENV_FILE.bak"
fi
# Jika .env hilang tapi n8n pernah jalan, pakai key lama agar credential tetap terbaca
if [ -z "$ENCRYPTION_KEY" ] && [ -f "$HOME/.n8n/config" ]; then
    ENCRYPTION_KEY=$(grep -o '"encryptionKey": *"[^"]*"' "$HOME/.n8n/config" | sed 's/.*: *"\(.*\)"/\1/' || true)
fi
[ -n "$DB_PASS" ] || DB_PASS=$(openssl rand -hex 16)
[ -n "$ENCRYPTION_KEY" ] || ENCRYPTION_KEY=$(openssl rand -hex 24)

# [4/7] PostgreSQL
echo "[4/7] Menyiapkan & men-tuning PostgreSQL..."
sudo systemctl enable --now postgresql

sudo -u postgres psql -tc "SELECT 1 FROM pg_roles WHERE rolname = '$DB_USER'" | grep -q 1 || \
    sudo -u postgres psql -c "CREATE USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"
# Selalu sinkronkan password dengan yang ada di .env
sudo -u postgres psql -c "ALTER USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"

sudo -u postgres psql -tc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" | grep -q 1 || \
    sudo -u postgres psql -c "CREATE DATABASE $DB_NAME OWNER $DB_USER;"
sudo -u postgres psql -c "ALTER DATABASE $DB_NAME OWNER TO $DB_USER;"
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER;"
sudo -u postgres psql -d "$DB_NAME" -c "GRANT ALL ON SCHEMA public TO $DB_USER;"

# ALTER SYSTEM -> ditulis ke postgresql.auto.conf, idempotent, tanpa sed
sudo -u postgres psql -c "ALTER SYSTEM SET shared_buffers = '24MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET work_mem = '2MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET maintenance_work_mem = '16MB';"
sudo -u postgres psql -c "ALTER SYSTEM SET max_connections = 20;"
sudo -u postgres psql -c "ALTER SYSTEM SET effective_cache_size = '96MB';"
sudo systemctl restart postgresql

# [5/7] File .env
echo "[5/7] Menulis $ENV_FILE ..."
if [ "$SECURE_COOKIE" = "true" ]; then COOKIE_VAL="true"; else COOKIE_VAL="false"; fi

cat > "$ENV_FILE" << EOF
# --- Domain & jaringan ---
N8N_HOST=$DOMAIN
N8N_EDITOR_BASE_URL=https://$DOMAIN/
WEBHOOK_URL=https://$DOMAIN/
N8N_PROTOCOL=https
N8N_LISTEN_ADDRESS=$LISTEN_ADDRESS
N8N_PORT=5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=$COOKIE_VAL
NODE_ENV=production
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- Database ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=127.0.0.1
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=$DB_NAME
DB_POSTGRESDB_USER=$DB_USER
DB_POSTGRESDB_PASSWORD=$DB_PASS

# --- Keamanan (JANGAN diubah setelah credential dibuat) ---
N8N_ENCRYPTION_KEY=$ENCRYPTION_KEY

# --- Timezone ---
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# --- Hemat memori ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
N8N_METRICS=false
N8N_LOG_LEVEL=warn
N8N_RUNNERS_ENABLED=false
N8N_DIAGNOSTICS_ENABLED=false
EOF
chmod 600 "$ENV_FILE"

echo ">>> Kunci enkripsi n8n (simpan baik-baik): $ENCRYPTION_KEY"

# [6/7] Jalankan via PM2
echo "[6/7] Menjalankan n8n via PM2..."
cd "$PROJECT_DIR"

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

# delete + start (bukan restart) supaya node-args & env baru pasti terpakai
pm2 delete n8n >/dev/null 2>&1 || true
pm2 start "$(command -v n8n)" --name n8n \
    --interpreter node \
    --node-args="--max-old-space-size=$HEAP_MB" \
    --max-memory-restart "${RESTART_MB}M" \
    -- start
pm2 save
sudo env PATH="$PATH:/usr/bin" pm2 startup systemd -u "$USER" --hp "$HOME" >/dev/null || true
pm2 save

# [7/7] Nginx (opsional)
if [ "$SETUP_NGINX" = "true" ]; then
    echo "[7/7] Menyiapkan Nginx..."
    sudo apt install -y nginx
    sudo tee /etc/nginx/sites-available/n8n >/dev/null << EOF
server {
    listen 80;
    server_name $DOMAIN;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:5678;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
EOF
    sudo ln -sf /etc/nginx/sites-available/n8n /etc/nginx/sites-enabled/n8n
    sudo rm -f /etc/nginx/sites-enabled/default
    sudo nginx -t && sudo systemctl reload nginx
    echo "  Nginx melayani HTTP :80. Untuk HTTPS gunakan Cloudflare (proxy) atau: sudo apt install certbot python3-certbot-nginx && sudo certbot --nginx -d $DOMAIN"
else
    echo "[7/7] Nginx dilewati (SETUP_NGINX=false). Pastikan reverse proxy/tunnel mengarah ke 127.0.0.1:5678."
fi

# Tunggu n8n siap (start pertama di ARM + migrasi DB bisa 1-3 menit)
echo "Menunggu n8n siap (maks 3 menit)..."
READY="no"
for i in $(seq 1 36); do
    if curl -fs "http://127.0.0.1:5678/healthz" >/dev/null 2>&1; then READY="yes"; break; fi
    sleep 5
done

echo "=================================================="
if [ "$READY" = "yes" ]; then
    echo " n8n BERJALAN. Buka: https://$DOMAIN/ (buat akun owner pertama)"
else
    echo " n8n belum merespons. Cek log:  pm2 logs n8n --lines 50"
fi
pm2 status
free -h
echo "=================================================="
