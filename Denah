def _bersih(val: str) -> str:
    val = (val or "").strip()
    if not val or val.upper().startswith("ISI_"):
        return ""
    return val


def get_gemini_keys() -> list:
    env = os.environ.get("GEMINI_KEYS", "")
    sumber = [k.strip() for k in env.split(",")] if env.strip() else GEMINI_KEYS
    hasil, terlihat = [], set()
    for k in sumber:
        kb = _bersih(k)
        if kb and kb not in terlihat:
            hasil.append(kb)
            terlihat.add(kb)
    return hasil


def get_gemini_key(index: int = 0) -> str:
    keys = get_gemini_keys()
    if not keys:
        raise ValueError("Belum ada GEMINI_KEYS valid di /root/api_keys.py")
    return keys[index % len(keys)]


def get_key(nama: str, wajib: bool = True) -> str:
    nama_low = nama.strip().lower()
    env_val = _bersih(os.environ.get(nama_low.upper(), ""))
    val = env_val or _bersih(KEYS.get(nama_low, ""))
    if wajib and not val:
        raise ValueError(f"API key '{nama}' belum diisi di /root/api_keys.py")
    return val


def jalankan_rotasi_gemini(fungsi, jeda: float = 1.5, verbose: bool = True):
    keys = get_gemini_keys()
