def pilih_beragam(kandidat: list, maks: int = MAKS_FASILITAS) -> list:
    pilih, dipakai_kat, dipakai_sektor = [], {}, {}
    sisa = list(kandidat)

    while sisa and len(pilih) < maks:
        terbaik_idx, terbaik_skor = None, -1e9
        for idx, item in enumerate(sisa):
            if dipakai_kat.get(item["kat"], 0) >= 1:
                continue
            sek = sektor(item["b"])
            bonus = 12.0 if dipakai_sektor.get(sek, 0) == 0 else 0.0
            skor = item.get("skor", 100.0 - idx * 3.0) + bonus
            if skor > terbaik_skor:
                terbaik_skor, terbaik_idx = skor, idx
        if terbaik_idx is None:
            break
        it = sisa.pop(terbaik_idx)
        pilih.append(it)
        dipakai_kat[it["kat"]] = dipakai_kat.get(it["kat"], 0) + 1
        sek = sektor(it["b"])
        dipakai_sektor[sek] = dipakai_sektor.get(sek, 0) + 1

    for it in list(sisa):
        if len(pilih) >= maks:
            break
        if dipakai_kat.get(it["kat"], 0) < 2:
            pilih.append(it)
            dipakai_kat[it["kat"]] = dipakai_kat.get(it["kat"], 0) + 1
            sisa.remove(it)

    for it in sisa:
        if len(pilih) >= maks:
            break
        pilih.append(it)

    pilih.sort(key=lambda x: x["d"])
    for i, f in enumerate(pilih, 1):
        f["no"] = i
        f["arah"] = arah_detail(f["b"])
    return pilih


def olah_hasil_gemini(js: dict, lat0: float, lon0: float, radius: float):
    kw = js.get("kawasan") or {}
    bagian = []
    if kw.get("kelurahan"):
        kel = bersihkan_prefix(kw["kelurahan"], r"^(kel\.?|kelurahan|desa|ds\.?)\s+")
        if kel:
            bagian.append(f"Kel. {kel}")
    if kw.get("kecamatan"):
        kec = bersihkan_prefix(kw["kecamatan"], r"^(kec\.?|kecamatan)\s+")
        if kec:
            bagian.append(f"Kec. {kec}")
    if kw.get("kota_kabupaten"):
        bagian.append(str(kw["kota_kabupaten"]).strip())
    if kw.get("provinsi"):
        bagian.append(str(kw["provinsi"]).strip())
    kawasan = ", ".join(bagian) if bagian else "Tidak teridentifikasi"

    kandidat, terlihat = [], set()
    for idx, f in enumerate(js.get("fasilitas") or []):
        try:
            nama = str(f["nama"]).strip()
            kat = normal_kategori(f.get("kategori"))
            lat, lon = float(f["lat"]), float(f["lon"])
        except Exception:
            continue
        if not nama or not kat or not (-90.0 <= lat <= 90.0 and -180.0 <= lon <= 180.0):
            continue
        if nama.lower() in NAMA_GENERIK_BLOKIR:
            continue
        kunci = re.sub(r"\s+", " ", nama.lower())
        if kunci in terlihat:
            continue
        d = haversine_km(lat0, lon0, lat, lon)
        if d > radius or d < 0.02:
            continue
        terlihat.add(kunci)
        kandidat.append({
            "nama": nama[:44], "kat": kat, "lat": lat, "lon": lon,
            "d": d, "b": bearing_deg(lat0, lon0, lat, lon), "skor": 100.0 - idx * 3.0,
        })
    return kawasan, pilih_beragam(kandidat, MAKS_FASILITAS)


