def _olah_elemen_osm(elems: list, lat0: float, lon0: float, radius: float) -> list:
    kandidat = []
    for el in elems:
        tags = el.get("tags") or {}
        nama = (tags.get("name") or "").strip()
        if not nama or len(nama) < 3 or nama.lower() in NAMA_GENERIK_BLOKIR:
            continue
        kat = klasifikasi_tag_osm(tags)
        if not kat:
            continue
        if "lat" in el and "lon" in el:
            elat, elon = float(el["lat"]), float(el["lon"])
        elif isinstance(el.get("center"), dict):
            elat, elon = float(el["center"]["lat"]), float(el["center"]["lon"])
        else:
            continue
        d = haversine_km(lat0, lon0, elat, elon)
        if d > radius or d < 0.02:
            continue
        kandidat.append({
            "nama": nama[:44], "kat": kat, "lat": elat, "lon": elon,
            "d": d, "b": bearing_deg(lat0, lon0, elat, elon),
            "skor": skor_strategis_osm(el, tags, kat, d, radius),
        })

    kandidat.sort(key=lambda x: (-x["skor"], x["d"]))
    unik = []
    for item in kandidat:
        kunci = re.sub(r"[^a-z0-9]", "", item["nama"].lower())
        duplikat = False
        for u in unik:
            kunci_u = re.sub(r"[^a-z0-9]", "", u["nama"].lower())
            if kunci == kunci_u:
                duplikat = True
                break
            if u["kat"] == item["kat"] and haversine_km(u["lat"], u["lon"], item["lat"], item["lon"]) < 0.12:
                duplikat = True
                break
        if not duplikat:
            unik.append(item)
    return unik


def ambil_dari_osm(lat0: float, lon0: float, radius: float):
    print("[OSM Nominatim] Mengidentifikasi perkiraan kawasan...", flush=True)
    kawasan = ambil_kawasan_nominatim(lat0, lon0)
    elems = query_overpass(lat0, lon0, radius, tambahan=False)
    unik = _olah_elemen_osm(elems, lat0, lon0, radius)
    if len(unik) < MAKS_FASILITAS:
        try:
            elems2 = query_overpass(lat0, lon0, radius, tambahan=True)
            unik = _olah_elemen_osm(elems + elems2, lat0, lon0, radius)
        except Exception as e:
            print(f"[OSM Tambahan] dilewati ({str(e)[:100]})")
    terpilih = pilih_beragam(unik, MAKS_FASILITAS)
    print(f"[OSM] Terpilih {len(terpilih)} fasilitas strategis dari {len(unik)} kandidat unik")
    return kawasan, terpilih


