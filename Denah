def panggil_gemini(key: str, model: str, prompt: str) -> str:
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
    body = {
        "contents": [{"role": "user", "parts": [{"text": prompt}]}],
        "tools": [{"google_search": {}}],
        "generationConfig": {"temperature": 0.2},
    }
    req = urllib.request.Request(
        url, data=json.dumps(body).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json", "x-goog-api-key": key},
    )
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            data = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        isi = e.read().decode("utf-8", "ignore")
        try:
            isi = json.loads(isi)["error"]["message"]
        except Exception:
            pass
        raise RuntimeError(f"HTTP {e.code}: {str(isi)[:200]}")

    cands = data.get("candidates") or []
    if not cands:
        raise RuntimeError(f"Tidak ada kandidat jawaban ({data.get('promptFeedback')})")
    parts = (cands[0].get("content") or {}).get("parts") or []
    teks = "".join(p.get("text", "") for p in parts if not p.get("thought"))
    if not teks.strip():
        raise RuntimeError("Jawaban kosong dari Gemini")
    return teks


def ekstrak_json(teks: str) -> dict:
    bersih = re.sub(r"```(?:json)?\s*", "", teks, flags=re.I).replace("```", "").strip()
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", bersih):
        try:
            obj, _ = dec.raw_decode(bersih[m.start():])
            if isinstance(obj, dict) and ("fasilitas" in obj or "kawasan" in obj):
                return obj
        except json.JSONDecodeError:
            continue
    raise ValueError("Objek JSON valid tidak ditemukan pada respons Gemini")


def normal_kategori(k):
