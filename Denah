def is_external_mounted(path: str) -> bool:
    """True jika path berada di mount point eksternal (bukan partisi root eMMC '/')."""
    try:
        root_dev = os.stat("/").st_dev
        cur = os.path.abspath(path)
        while not os.path.exists(cur) and cur != "/":
            cur = os.path.dirname(cur)
        return os.stat(cur).st_dev != root_dev
    except Exception:
        return False


def parse_koordinat(s: str):
    s = (
        s.strip().strip("'").strip('"')
        .replace("′", "'").replace("’", "'").replace("‘", "'")
        .replace("″", '"').replace("”", '"').replace("“", '"')
        .replace("º", "°")
    )
    dms = re.findall(
        r"(\d+(?:[.,]\d+)?)\s*°\s*(\d+(?:[.,]\d+)?)\s*'\s*(\d+(?:[.,]\d+)?)\s*(?:\"|'')?\s*"
        r"(LU|LS|BT|BB|[NSEW])?",
        s, flags=re.I,
    )
    if len(dms) >= 2:
        nilai = []
        for d, m, sec, h in dms[:2]:
            v = (
                float(d.replace(",", "."))
                + float(m.replace(",", ".")) / 60.0
                + float(sec.replace(",", ".")) / 3600.0
            )
            h = h.upper()
            if h in ("S", "W", "LS", "BB"):
                v = -v
            nilai.append((v, h))
        (a, ha), (b, hb) = nilai
        if ha in ("E", "W", "BT", "BB") or hb in ("N", "S", "LU", "LS"):
            a, b = b, a
        lat, lon = a, b
    else:
        m_dec = re.fullmatch(r"([+-]?\d+(?:\.\d+)?)\s*[,;\s]\s*([+-]?\d+(?:\.\d+)?)", s)
        if m_dec:
            lat, lon = float(m_dec.group(1)), float(m_dec.group(2))
        else:
            bagian = [p for p in re.split(r"\s*;\s*|,\s+|\s+", s) if p]
            if len(bagian) < 2:
                raise ValueError(f"Format koordinat tidak dikenali: {s}")
            lat, lon = float(bagian[0].replace(",", ".")), float(bagian[1].replace(",", "."))
    if not (-90.0 <= lat <= 90.0 and -180.0 <= lon <= 180.0):
        raise ValueError("Koordinat di luar jangkauan valid")
    return lat, lon


def to_dms(val: float, pos: str, neg: str) -> str:
    h = pos if val >= 0 else neg
    v = abs(val)
    d = int(v)
    m = int((v - d) * 60)
    sec = round(((v - d) * 60 - m) * 60, 1)
    if sec >= 60.0:
        sec -= 60.0
        m += 1
    if m >= 60:
        m -= 60
        d += 1
    return f"{d}°{m:02d}'{sec:04.1f}\"{h}"


def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    r = 6371.0088
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp, dl = p2 - p1, math.radians(lon2 - lon1)
    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(min(1.0, a)))


def bearing_deg(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    return (math.degrees(math.atan2(y, x)) + 360.0) % 360.0


def arah_detail(b: float) -> str:
    return ARAH8[int((b + 22.5) // 45.0) % 8]


def sektor(b: float) -> str:
    if b >= 315.0 or b < 45.0:
        return "UTARA"
    if b < 135.0:
        return "TIMUR"
    if b < 225.0:
        return "SELATAN"
    return "BARAT"


