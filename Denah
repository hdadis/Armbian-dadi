def ambil_kawasan_nominatim(lat: float, lon: float) -> str:
    params = urllib.parse.urlencode({
        "format": "jsonv2", "lat": f"{lat:.6f}", "lon": f"{lon:.6f}",
        "zoom": 16, "addressdetails": 1, "accept-language": "id",
    })
    req = urllib.request.Request(
        f"{NOMINATIM_URL}?{params}", headers={"User-Agent": OSM_USER_AGENT}
    )
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            data = json.loads(r.read().decode("utf-8"))
    except Exception as e:
        print(f"[OSM Nominatim] peringatan: {e}")
        return "Tidak teridentifikasi"

    addr = data.get("address") or {}
    kel = addr.get("village") or addr.get("suburb") or addr.get("quarter") or addr.get("neighbourhood") or addr.get("hamlet") or ""
    kec = addr.get("city_district") or addr.get("municipality") or addr.get("district") or (addr.get("suburb") if addr.get("village") else "") or ""
    kota = addr.get("city") or addr.get("regency") or addr.get("county") or addr.get("town") or ""
    prov = addr.get("state") or addr.get("region") or ""

    kel_c = bersihkan_prefix(kel, r"^(kel\.?|kelurahan|desa|ds\.?)\s+") if kel else ""
    kec_c = bersihkan_prefix(kec, r"^(kec\.?|kecamatan)\s+") if kec else ""
    kota_c, prov_c = str(kota).strip(), str(prov).strip()
    if kec_c and kel_c and kec_c.lower() == kel_c.lower():
        kec_c = ""
    if kota_c and kec_c and kota_c.lower() == kec_c.lower():
        kec_c = ""

    bagian = []
    if kel_c:
        bagian.append(f"Kel. {kel_c}")
    if kec_c:
        bagian.append(f"Kec. {kec_c}")
    if kota_c:
        bagian.append(kota_c)
    if prov_c:
        bagian.append(prov_c)
    return ", ".join(bagian) if bagian else "Tidak teridentifikasi"


def klasifikasi_tag_osm(tags: dict):
    aeroway = (tags.get("aeroway") or "").lower()
    railway = (tags.get("railway") or "").lower()
    amenity = (tags.get("amenity") or "").lower()
    shop = (tags.get("shop") or "").lower()
    leisure = (tags.get("leisure") or "").lower()
    tourism = (tags.get("tourism") or "").lower()
    nama_low = (tags.get("name") or "").lower()

    if aeroway == "aerodrome":
        return "bandara"
    if railway in ("station", "halt"):
        return "stasiun"
    if amenity == "bus_station":
        return "terminal"
    if amenity == "hospital":
        if any(k in nama_low for k in ("klinik", "puskesmas", "praktek", "praktik", "apotek")):
            return None
        return "rumah sakit"
    if amenity in ("university", "college"):
        return "universitas"
    if shop in ("mall", "department_store"):
        return "mall"
    if amenity == "police":
        return "kantor polisi"
    if amenity == "marketplace":
        return "pasar"
    if leisure in ("park", "water_park", "nature_reserve") or tourism in ("attraction", "theme_park", "zoo"):
        return "rekreasi"
    if amenity in ("cinema", "theatre", "arts_centre") or leisure in ("amusement_arcade", "bowling_alley", "karaoke_box"):
        return "tempat hiburan"
    if amenity == "school":
        return "sekolah"
    if amenity == "restaurant":
        return "restoran"
    return None


def skor_strategis_osm(el: dict, tags: dict, kat: str, dist_km: float, radius_km: float) -> float:
    nl = (tags.get("name") or "").strip().lower()
    skor = float(BOBOT_KATEGORI_OSM.get(kat, 15))
    if el.get("type") in ("way", "relation"):
        skor += 14.0
    if tags.get("wikidata") or tags.get("wikipedia"):
        skor += 35.0
    for k, pts in (("website", 8.0), ("contact:website", 8.0), ("brand", 6.0),
                   ("operator", 5.0), ("opening_hours", 4.0), ("phone", 3.0),
                   ("addr:street", 3.0), ("building", 3.0)):
        if tags.get(k):
            skor += pts
    boost_kw = (
        "rsud", "rumah sakit", "rs ", "hospital", "universitas", "institut",
        "politeknik", "stasiun", "terminal", "bandara", "mall", "mal ",
        "plaza", "town square", "square", "polres", "polsek", "polda",
        "pasar ", "alun-alun", "alun alun", "taman ", "sma negeri", "sman ",
        "smk negeri", "smkn ", "smp negeri", "smpn ", "bioskop", "xxi", "cgv",
    )
    if any(k in nl for k in boost_kw):
        skor += 12.0
    penalti_kw = (
        "paud", "tk ", "tk.", "ra ", "kb ", "playgroup", "bimbel", "kursus",
        "pos polisi", "pos lantas", "pos satpam", "warung", "warteg", "warkop",
        "angkringan", "kios", "lapak", "kantin", "pecel lele", "mie ayam",
        "bakso ", "sate ", "geprek", "taman bermain", "lapangan rt",
    )
    if any(k in nl for k in penalti_kw):
        skor -= 24.0
    if radius_km > 0:
        skor += max(0.0, (1.0 - dist_km / radius_km)) * 10.0
    return skor


def hitung_bbox(lat: float, lon: float, radius_km: float):
    dlat = radius_km / 111.32
    dlon = radius_km / (111.32 * max(0.01, math.cos(math.radians(lat))))
    return (lat - dlat, lon - dlon, lat + dlat, lon + dlon)


def _kirim_overpass(q: str, label: str) -> list:
    payload = urllib.parse.urlencode({"data": q}).encode("utf-8")
    err_terakhir = ""
    for url in OVERPASS_URLS:
        host = urllib.parse.urlparse(url).netloc
        print(f"[OSM {label}] {host}...", end=" ", flush=True)
        req = urllib.request.Request(
            url, data=payload, method="POST",
            headers={
                "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                "User-Agent": OSM_USER_AGENT,
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=OSM_TIMEOUT) as r:
                data = json.loads(r.read().decode("utf-8"))
            elems = data.get("elements") or []
            print(f"-> {len(elems)} objek")
            return elems
        except Exception as e:
            err_terakhir = str(e)
            print(f"-> gagal ({err_terakhir[:100]})")
            time.sleep(1.5)
    raise RuntimeError(f"Semua mirror Overpass gagal: {err_terakhir}")


