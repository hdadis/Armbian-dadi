def lum(h: str) -> float:
    c = [int(h[i:i + 2], 16) / 255.0 for i in (1, 3, 5)]
    c = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]


def _pack_zone(items, y_lo, y_hi, gap):
    if not items:
        return
    total_h = sum(f["ch"] for f in items)
    avail = y_hi - y_lo
    eff_gap = gap
    if len(items) > 1 and total_h + eff_gap * (len(items) - 1) > avail:
        eff_gap = max(12.0, (avail - total_h) / (len(items) - 1))
    cur = y_lo
    for f in items:
        f["top"] = max(f["y"] - f["ch"] / 2.0, cur)
        cur = f["top"] + f["ch"] + eff_gap
    if items[-1]["top"] + items[-1]["ch"] > y_hi:
        cur = y_hi
        for f in reversed(items):
            f["top"] = min(f["top"], cur - f["ch"])
            cur = f["top"] - eff_gap
    if items[0]["top"] < y_lo:
        cur = y_lo
        for f in items:
            f["top"] = cur
            cur += f["ch"] + eff_gap


def susun_kolom(items, cy, y_lo=490.0, y_hi=3320.0, gap=36.0, band_half=96.0):
    if not items:
        return
    band_top, band_bot = cy - band_half, cy + band_half
    items.sort(key=lambda f: f["y"])
    atas = [f for f in items if f["y"] < cy]
    bawah = [f for f in items if f["y"] >= cy]

    def fits(lst, lo, hi, min_gap=16.0):
        return (sum(f["ch"] for f in lst) + min_gap * max(0, len(lst) - 1)) <= (hi - lo)

    while atas and not fits(atas, y_lo, band_top):
        bawah.insert(0, atas.pop())
    while bawah and not fits(bawah, band_bot, y_hi):
        atas.append(bawah.pop(0))
    _pack_zone(atas, y_lo, band_top, gap)
    _pack_zone(bawah, band_bot, y_hi, gap)


def render_png(path: str, lat: float, lon: float, radius: float, kawasan: str, fasilitas: list, sumber_label: str):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.patches import Circle, FancyBboxPatch, Rectangle

    plt.rcParams["font.family"] = "sans-serif"
    plt.rcParams["font.sans-serif"] = ["Liberation Sans", "Noto Sans", "DejaVu Sans"]

    W = H = 3840
    DPI = 400
    pt = lambda px: px * 72.0 / DPI

    fig = plt.figure(figsize=(W / DPI, H / DPI), dpi=DPI, facecolor=BG)
    ax = fig.add_axes([0, 0, 1, 1], facecolor=BG)
    ax.set_xlim(0, W)
    ax.set_ylim(H, 0)
    ax.axis("off")
    rend = fig.canvas.get_renderer()
    tw_cache = {}

    def tw(s, px):
        key = (s, round(px, 2))
        if key not in tw_cache:
            t = ax.text(0, 0, s, fontsize=pt(px), fontweight="bold")
            tw_cache[key] = t.get_window_extent(rend).width
            t.remove()
        return tw_cache[key]

    def fit(s, max_w, px, min_px=26):
        w = tw(s, px)
        if w > max_w and w > 0:
            px = max(min_px, px * (max_w / w) * 0.97)
            while tw(s, px) > max_w and px > min_px:
                px *= 0.96
        return px

    def wrap(s, px, max_w):
        out, cur = [], ""
        for word in s.split():
            cand = (cur + " " + word).strip()
            if cur and tw(cand, px) > max_w:
                out.append(cur)
                cur = word
            else:
                cur = cand
        if cur:
            out.append(cur)
        return out

    def text(x, y, s, px, color, ha="center", z=20):
        ax.text(x, y, s, fontsize=pt(px), fontweight="bold", color=color, ha=ha, va="center", zorder=z)

    def line(x1, y1, x2, y2, color, wpx, dash=None, z=2):
        kw = {"linestyle": (0, dash)} if dash else {}
        ax.plot([x1, x2], [y1, y2], color=color, lw=pt(wpx), zorder=z,
                solid_capstyle="butt", dash_capstyle="butt", **kw)

    def box(x, y, w, h, fc, ec, lwpx, rad, z=5):
        ax.add_patch(FancyBboxPatch((x, y), w, h, boxstyle=f"round,pad=0,rounding_size={rad}",
                                    fc=fc, ec=ec, lw=pt(lwpx), zorder=z))

    cx, cy, R = W / 2.0, 1990.0, 1000.0
    xy = lambda b, r: (cx + r * math.sin(math.radians(b)), cy - r * math.cos(math.radians(b)))

    judul = f"Diagram Radar Lokasi Strategis — Radius Maksimal {fmt_r(radius)} km"
