    box(cx - wr_rumah / 2, cy - 160, wr_rumah, 96, "#DC2626", "#FFFFFF", 5, 6, z=12)
    text(cx, cy - 112, "RUMAH", 54, "#FFFFFF", z=13)

    urut_warna, label_warna = [], {}
    for f in fasilitas:
        w = f["warna"]
        if w not in urut_warna:
            urut_warna.append(w)
        label_warna.setdefault(w, [])
        if f["kat"] not in label_warna[w]:
            label_warna[w].append(f["kat"])

    if urut_warna:
        bx0, bx1, by, bh = 120.0, W - 120.0, 3395.0, 120.0
        segmen = []
        for w in urut_warna:
            urut = GRUP_LEGENDA.get(w)
            kats = sorted(label_warna[w], key=lambda k: urut.index(k)) if urut else label_warna[w]
            lab = " / ".join(KAT_DISPLAY[k] for k in kats)
            segmen.append((w, lab, max(tw(lab, 56) + 120.0, 380.0)))
        sum_b = sum(b for _, _, b in segmen)
        cur_x = bx0
        for w, lab, bobot in segmen:
            bw = (bx1 - bx0) * (bobot / sum_b)
            ax.add_patch(Rectangle((cur_x, by), bw + 0.6, bh, fc=w, ec="none", zorder=5))
            tc = "#0B1120" if lum(w) > 0.2 else "#FFFFFF"
            text(cur_x + bw / 2.0, by + bh / 2.0, lab, fit(lab, bw - 48, 58), tc, z=6)
            cur_x += bw

    foot = f"Sumber data: {sumber_label}, diakses {tanggal_id()}. Jarak berupa perkiraan garis lurus (straight-line distance) dari titik rumah."
    fy = 3605
    for s in wrap(foot, 46, 3520):
        text(cx, fy, s, 46, "#94A3B8", ha="center")
        fy += 68

    fig.savefig(path, dpi=DPI, facecolor=BG)
    plt.close(fig)
    del fig
    gc.collect()

    from PIL import Image
    Image.MAX_IMAGE_PIXELS = None
    with Image.open(path) as im:
        if im.size[0] < 3840 or im.size[1] < 3840:
            raise RuntimeError(f"Ukuran PNG {im.size} kurang dari 3840x3840")


def tulis_txt(path: str, lat: float, lon: float, radius: float, kawasan: str, fasilitas: list, sumber_label: str):
    lines = [
        "KETERANGAN LOKASI STRATEGIS",
        "=" * 60,
        f"Titik Rumah       : {to_dms(lat, 'N', 'S')} {to_dms(lon, 'E', 'W')} ({lat:.6f}, {lon:.6f})",
        f"Perkiraan Kawasan : {kawasan}",
        f"Radius Maksimal   : {fmt_r(radius)} km",
        "=" * 60,
    ]
    for nama, rentang in (("UTARA", "315°–45°"), ("TIMUR", "45°–135°"),
                          ("SELATAN", "135°–225°"), ("BARAT", "225°–315°")):
        lines.extend(["", f"[{nama}] ({rentang})"])
        item = [f for f in fasilitas if sektor(f["b"]) == nama]
        if not item:
            lines.append(f"* Tidak ada fasilitas terpilih pada sektor ini di dalam radius maksimal {fmt_r(radius)} km.")
        for f in sorted(item, key=lambda x: x["no"]):
            lines.append(f"* [{f['no']}] {f['nama']} ({KAT_DISPLAY[f['kat']]}) — {fmt_km(f['d'])} km ({f['arah']})")
    lines.extend([
        "", "-" * 60,
        f"Sumber data: {sumber_label}, diakses {tanggal_id()}.",
        "Jarak berupa perkiraan garis lurus (straight-line distance) dari titik rumah.",
    ])
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def kirim(files: list) -> str:
    remote = REMOTE_DIR
    ssh_opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "StrictHostKeyChecking=accept-new"]
    subprocess.run(["ssh", *ssh_opts, REMOTE_HOST, f"mkdir -p {shlex.quote(remote)}"], check=True)
    subprocess.run(["scp", *ssh_opts, *files, f"{REMOTE_HOST}:{remote}/"], check=True)
    return remote


def ambil_keys() -> list:
    if api_keys is not None:
        return api_keys.get_gemini_keys()
    env = os.environ.get("GEMINI_KEYS", "")
    return [k.strip() for k in env.split(",") if k.strip() and not k.strip().startswith("ISI_")]


def parse_args():
    p = argparse.ArgumentParser(description="Generator Diagram Radar Lokasi Strategis 4K")
    p.add_argument("koordinat", nargs="?", help="Koordinat DMS atau desimal")
    p.add_argument("radius", nargs="?", type=str, help="Radius maksimal dalam km")
    p.add_argument("--sumber", choices=("osm", "auto", "gemini"), default=SUMBER_DEFAULT,
                   help=f"Sumber data: osm, auto, atau gemini (default: {SUMBER_DEFAULT})")
    p.add_argument("--model", default=DEFAULT_MODEL, help=f"Model Gemini (default: {DEFAULT_MODEL})")
    p.add_argument("--no-upload", action="store_true", help="Simpan lokal saja tanpa SCP")
    p.add_argument("--salin-ke", dest="salin_ke", default=None,
                   help="Salin PNG & TXT hasil ke folder ini (dipakai bot Telegram)")
    return p.parse_args()


def main():
    args = parse_args()
    if args.koordinat:
        kor_str = args.koordinat
        radius = float(args.radius.replace(",", ".")) if args.radius else RADIUS_DEFAULT
    else:
        kor_str = input("Koordinat (DMS atau desimal): ")
        r = input(f"Radius maksimal km [{RADIUS_DEFAULT:g}]: ").strip()
        radius = float(r.replace(",", ".")) if r else RADIUS_DEFAULT

    if radius <= 0:
        sys.exit("Radius harus lebih besar dari 0 km.")

    lat, lon = parse_koordinat(kor_str)
    print(f"Titik: {lat:.6f}, {lon:.6f} | Radius: {radius:g} km | Mode: {args.sumber}")

    kawasan, fasilitas, sumber_label, error_terakhir = None, [], "", ""

    if args.sumber in ("auto", "gemini"):
        keys = ambil_keys()
        if keys:
            kaw, fas, err = ambil_dari_gemini(keys, args.model, lat, lon, radius)
            if fas:
                kawasan, fasilitas = kaw, fas
                sumber_label = "Google Maps (via Gemini + Google Search)"
            else:
                error_terakhir = err
        elif args.sumber == "gemini":
            sys.exit("Mode --sumber gemini memerlukan API key aktif di /root/api_keys.py.")
        else:
            print("[Info] API key Gemini kosong -> langsung menggunakan OpenStreetMap.")

    if not fasilitas and args.sumber in ("osm", "auto"):
        if args.sumber == "auto" and error_terakhir:
            print(f"[Fallback] Gemini gagal ({error_terakhir[:100]}) -> beralih ke OpenStreetMap...")
        try:
            kawasan, fasilitas = ambil_dari_osm(lat, lon, radius)
            sumber_label = "OpenStreetMap (Overpass & Nominatim)"
        except Exception as e:
            sys.exit(f"Gagal mengambil data dari OpenStreetMap: {e}")

    if not fasilitas:
        sys.exit(f"Tidak ada fasilitas ditemukan dalam radius {radius:g} km. Error: {error_terakhir}")

    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    langsung_external = is_external_mounted(REMOTE_DIR)
    folder = REMOTE_DIR if langsung_external else os.path.join(TMP_DIR, f"denah_{ts}")
    os.makedirs(folder, exist_ok=True)
    png_path, txt_path = os.path.join(folder, PNG_NAME), os.path.join(folder, TXT_NAME)

    print(f"Kawasan: {kawasan}")
    for f in fasilitas:
        print(f"  [{f['no']}] {f['nama']} ({KAT_DISPLAY[f['kat']]}) — {fmt_km(f['d'])} km ({f['arah']})")

    print("Merender PNG 4K (3840x3840 @ 400 DPI)...")
    render_png(png_path, lat, lon, radius, kawasan, fasilitas, sumber_label)
    tulis_txt(txt_path, lat, lon, radius, kawasan, fasilitas, sumber_label)

    if args.salin_ke:
        os.makedirs(args.salin_ke, exist_ok=True)
        for _src in (png_path, txt_path):
            shutil.copy2(_src, args.salin_ke)
        print(f"[Salin] Hasil disalin ke {args.salin_ke}")

    if langsung_external:
        print(f"Selesai (langsung di disk eksternal): {REMOTE_DIR}")
        return
    if args.no_upload:
        print(f"Selesai (sementara di /tmp): {folder}")
        return

    try:
        remote = kirim([png_path, txt_path])
        shutil.rmtree(folder, ignore_errors=True)
        print(f"Selesai: {PNG_NAME} & {TXT_NAME} langsung masuk ke {REMOTE_HOST}:{remote} (cache /tmp dibersihkan)")
    except Exception as e:
        print(f"File jadi tapi gagal dikirim ({e}). Salinan sementara: {folder}")


if __name__ == "__main__":
    main()
