            print(f"[API {i}/{len(keys)}] Gemini key ...{key[-4:]}", flush=True)
        try:
            return fungsi(key)
        except Exception as e:
            error_terakhir = e
            if verbose:
                print(f"  -> gagal: {str(e)[:150]}", flush=True)
            if i < len(keys):
                time.sleep(jeda)
    raise RuntimeError(f"Semua {len(keys)} Gemini key gagal. Error terakhir: {error_terakhir}")


