#!/usr/bin/env bash
# ==============================================================================
# Jellyfin Native Installer for Armbian (eMMC Mode - HG680P / ARM64)
# - Memasang Jellyfin native dari repositori resmi (deb822)
# - Memakai path standar eMMC (/var/lib/jellyfin & /var/cache/jellyfin)
# - Mengalihkan log & TMPDIR ke eMMC (menghindari limit tmpfs & armbian-ramlog)
# ==============================================================================

set -euo pipefail

JELLYFIN_DATA_DIR="/var/lib/jellyfin"
JELLYFIN_CACHE_DIR="/var/cache/jellyfin"
JELLYFIN_LOG_DIR="/var/lib/jellyfin/log"
JELLYFIN_TMP_DIR="/var/lib/jellyfin/tmp"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# 1. Validasi root
if [[ "${EUID}" -ne 0 ]]; then
    err "Script ini harus dijalankan sebagai root (gunakan sudo)."
    exit 1
fi

# 2. Deteksi OS & Arsitektur
if [[ ! -f /etc/os-release ]]; then
    err "File /etc/os-release tidak ditemukan."
    exit 1
fi

# shellcheck source=/dev/null
source /etc/os-release

VERSION_OS="${ID,,}"
if [[ "${VERSION_OS}" != "debian" && "${VERSION_OS}" != "ubuntu" ]]; then
    if [[ "${ID_LIKE:-}" == *"ubuntu"* ]]; then
        VERSION_OS="ubuntu"
    elif [[ "${ID_LIKE:-}" == *"debian"* ]]; then
        VERSION_OS="debian"
    else
        err "OS '${ID}' tidak didukung. Khusus Debian/Ubuntu/Armbian."
        exit 1
    fi
fi

VERSION_CODENAME="${VERSION_CODENAME:-$(lsb_release -cs 2>/dev/null || true)}"
ARCH="$(dpkg --print-architecture)"

if [[ -z "${VERSION_CODENAME}" ]]; then
    err "Gagal mendeteksi VERSION_CODENAME OS."
    exit 1
fi

# 3. Cek sisa ruang eMMC (/)
AVAIL_KB="$(df --output=avail -k / | tail -n 1 | tr -d ' ')"
AVAIL_MB="$((AVAIL_KB / 1024))"

info "Target OS   : ${VERSION_OS} (${VERSION_CODENAME}) [${ARCH}]"
info "Target Mode : eMMC (${JELLYFIN_DATA_DIR})"
info "Sisa eMMC / : ${AVAIL_MB} MB"

if (( AVAIL_KB < 2621440 )); then
    warn "Sisa ruang eMMC kurang dari 2.5 GB. Jellyfin 10.11+ butuh minimal 2 GB ruang kosong untuk start."
fi

# 4. Pasang Repositori Resmi Jellyfin (deb822)
info "Memasang dependensi dan repositori resmi Jellyfin..."
apt-get update -qq
apt-get install -y --no-install-recommends curl gnupg ca-certificates

install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor --yes -o /etc/apt/keyrings/jellyfin.gpg
chmod 0644 /etc/apt/keyrings/jellyfin.gpg

cat <<EOF > /etc/apt/sources.list.d/jellyfin.sources
Types: deb
URIs: https://repo.jellyfin.org/${VERSION_OS}
Suites: ${VERSION_CODENAME}
Components: main
Architectures: ${ARCH}
Signed-By: /etc/apt/keyrings/jellyfin.gpg
EOF

# 5. Install Jellyfin Native
info "Menginstal paket jellyfin..."
apt-get update -qq
apt-get install -y jellyfin

# 6. Siapkan folder log & tmp di eMMC (bypass ramlog 50MB & tmpfs)
info "Mengalihkan log dan TMPDIR ke eMMC..."
systemctl stop jellyfin || true

mkdir -p "${JELLYFIN_DATA_DIR}" "${JELLYFIN_CACHE_DIR}" "${JELLYFIN_LOG_DIR}" "${JELLYFIN_TMP_DIR}"
chown -R jellyfin:jellyfin "${JELLYFIN_DATA_DIR}" "${JELLYFIN_CACHE_DIR}"

DEFAULT_FILE="/etc/default/jellyfin"
if [[ -f "${DEFAULT_FILE}" ]]; then
    [[ -f "${DEFAULT_FILE}.bak" ]] || cp "${DEFAULT_FILE}" "${DEFAULT_FILE}.bak"
else
    touch "${DEFAULT_FILE}"
fi

set_env_var() {
    local file="$1"
    local key="$2"
    local val="$3"
    if grep -qE "^#?[[:space:]]*${key}=" "${file}"; then
        sed -i -E "s|^#?[[:space:]]*${key}=.*|${key}=\"${val}\"|" "${file}"
    else
        echo "${key}=\"${val}\"" >> "${file}"
    fi
}

set_env_var "${DEFAULT_FILE}" "JELLYFIN_DATA_DIR"  "${JELLYFIN_DATA_DIR}"
set_env_var "${DEFAULT_FILE}" "JELLYFIN_CACHE_DIR" "${JELLYFIN_CACHE_DIR}"
set_env_var "${DEFAULT_FILE}" "JELLYFIN_LOG_DIR"   "${JELLYFIN_LOG_DIR}"
set_env_var "${DEFAULT_FILE}" "TMPDIR"             "${JELLYFIN_TMP_DIR}"

# 7. Systemd override agar ramah RAM/CPU STB dan menerapkan TMPDIR
info "Membuat systemd override..."
OVERRIDE_DIR="/etc/systemd/system/jellyfin.service.d"
mkdir -p "${OVERRIDE_DIR}"

cat <<EOF > "${OVERRIDE_DIR}/override.conf"
[Service]
Environment="TMPDIR=${JELLYFIN_TMP_DIR}"
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
EOF

# 8. Bersihkan cache apt agar eMMC tetap lega
apt-get clean

# 9. Jalankan service
info "Menjalankan service Jellyfin..."
systemctl daemon-reload
systemctl enable --now jellyfin

sleep 3

if systemctl is-active --quiet jellyfin; then
    LOCAL_IP="$(hostname -I | awk '{print $1}')"
    REMAINING_MB="$(( $(df --output=avail -k / | tail -n 1 | tr -d ' ') / 1024 ))"
    ok "Jellyfin berhasil dipasang di eMMC dan berjalan!"
    echo ""
    echo "================================================================"
    echo " Akses Web UI : http://${LOCAL_IP:-<IP-STB>}:8096"
    echo " Data & Log   : ${JELLYFIN_DATA_DIR}"
    echo " Sisa eMMC    : ${REMAINING_MB} MB"
    echo "----------------------------------------------------------------"
    echo " Wajib di Web UI agar eMMC tidak cepat penuh:"
    echo " 1. Matikan Transcoding (wajib Direct Play)"
    echo " 2. Matikan Trickplay & Chapter Image Extraction"
    echo " 3. Arahkan library media ke folder film Anda (misal di USB/NAS)"
    echo "================================================================"
else
    err "Service Jellyfin gagal start. Cek log terakhir:"
    journalctl -u jellyfin -n 25 --no-pager
    exit 1
fi
