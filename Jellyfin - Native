#!/usr/bin/env bash
# ==============================================================================
# Jellyfin Native Installer for Armbian / Debian / Ubuntu (Optimized for HG680P)
# - Memasang Jellyfin native dari repositori resmi (deb822)
# - Memindahkan data, cache, log, dan TMPDIR ke storage eksternal
# - Menambahkan systemd override agar menunggu USB mount & ramah RAM/CPU
# ==============================================================================

set -euo pipefail

# Default path (bisa diubah via argumen pertama atau env JELLYFIN_BASE_DIR)
JELLYFIN_BASE_DIR="${1:-${JELLYFIN_BASE_DIR:-/mnt/External/jellyfin}}"

# Warna output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# 1. Validasi hak akses root
if [[ "${EUID}" -ne 0 ]]; then
    err "Script ini harus dijalankan sebagai root (gunakan sudo)."
    exit 1
fi

# 2. Deteksi OS & Arsitektur
if [[ ! -f /etc/os-release ]]; then
    err "File /etc/os-release tidak ditemukan. OS tidak dikenali."
    exit 1
fi

# shellcheck source=/dev/null
source /etc/os-release

VERSION_OS="${ID,,}"
if [[ "${VERSION_OS}" != "debian" && "${VERSION_OS}" != "ubuntu" ]]; then
    if [[ "${ID_LIKE:-}" == *"ubuntu"* ]]; then
        VERSION_OS="ubuntu"
    elif [[ "${ID_LIKE:-}" == *"debian"* ]]; then
        VERSION_OS="debian"
    else
        err "OS '${ID}' tidak didukung. Script ini khusus Debian/Ubuntu/Armbian."
        exit 1
    fi
fi

VERSION_CODENAME="${VERSION_CODENAME:-$(lsb_release -cs 2>/dev/null || true)}"
ARCH="$(dpkg --print-architecture)"

if [[ -z "${VERSION_CODENAME}" ]]; then
    err "Gagal mendeteksi VERSION_CODENAME OS."
    exit 1
fi

info "Target OS      : ${VERSION_OS} (${VERSION_CODENAME}) [${ARCH}]"
info "Target Storage : ${JELLYFIN_BASE_DIR}"

# 3. Validasi Mount Point, Filesystem, dan Kapasitas Disk
CHECK_DIR="${JELLYFIN_BASE_DIR}"
while [[ ! -d "${CHECK_DIR}" ]]; do
    CHECK_DIR="$(dirname "${CHECK_DIR}")"
done

MOUNT_POINT="$(df --output=target "${CHECK_DIR}" | tail -n 1)"
FS_TYPE="$(df --output=fstype "${CHECK_DIR}" | tail -n 1)"
AVAIL_KB="$(df --output=avail -k "${CHECK_DIR}" | tail -n 1 | tr -d ' ')"
AVAIL_GB="$((AVAIL_KB / 1024 / 1024))"

info "Mount Point    : ${MOUNT_POINT} (Filesystem: ${FS_TYPE}, Sisa: ~${AVAIL_GB} GB)"

if [[ "${MOUNT_POINT}" == "/" ]]; then
    warn "Target berada di rootfs/eMMC ('/'), bukan storage eksternal!"
    warn "Di STB eMMC 8 GB (seperti HG680P), Jellyfin 10.11+ rentan gagal start karena limit 2 GB."
    if [[ -t 0 ]]; then
        read -rp "Tetap lanjutkan instalasi ke '${JELLYFIN_BASE_DIR}'? [y/N]: " confirm
        [[ "${confirm,,}" == "y" ]] || exit 1
    fi
fi

if (( AVAIL_KB < 3145728 )); then
    warn "Ruang kosong kurang dari 3 GB. Jellyfin 10.11+ mewajibkan minimal 2 GB ruang kosong."
fi

if [[ "${FS_TYPE}" =~ ^(ntfs|ntfs3|fuseblk|vfat|exfat)$ ]]; then
    warn "Filesystem '${FS_TYPE}' terdeteksi. Linux permission (chown) tidak berjalan normal di NTFS/FAT."
    warn "Pastikan drive di-mount dengan akses tulis untuk user 'jellyfin' (atau gunakan partisi ext4 untuk database SQLite yang lebih stabil)."
fi

# 4. Pasang Repositori Resmi Jellyfin (deb822)
info "Memasang dependensi dan repositori resmi Jellyfin..."
apt-get update -qq
apt-get install -y --no-install-recommends curl gnupg ca-certificates

install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor --yes -o /etc/apt/keyrings/jellyfin.gpg
chmod 0644 /etc/apt/keyrings/jellyfin.gpg

cat <<EOF > /etc/apt/sources.list.d/jellyfin.sources
Types: deb
URIs: https://repo.jellyfin.org/${VERSION_OS}
Suites: ${VERSION_CODENAME}
Components: main
Architectures: ${ARCH}
Signed-By: /etc/apt/keyrings/jellyfin.gpg
EOF

# 5. Install Jellyfin Native
info "Menginstal paket jellyfin..."
apt-get update -qq
apt-get install -y jellyfin

# 6. Hentikan Service & Siapkan Direktori Eksternal
info "Mengonfigurasi direktori kerja ke ${JELLYFIN_BASE_DIR}..."
systemctl stop jellyfin || true

mkdir -p "${JELLYFIN_BASE_DIR}"/{data,cache,log,tmp}

# Migrasi data awal jika folder eksternal masih kosong
if [[ -d /var/lib/jellyfin ]] && [[ -z "$(ls -A "${JELLYFIN_BASE_DIR}/data")" ]]; then
    cp -a /var/lib/jellyfin/. "${JELLYFIN_BASE_DIR}/data/" 2>/dev/null || true
fi

if ! chown -R jellyfin:jellyfin "${JELLYFIN_BASE_DIR}" 2>/dev/null; then
    warn "chown ke jellyfin:jellyfin gagal (normal pada mount NTFS/exFAT). Cek izin akses secara manual."
fi

# 7. Update /etc/default/jellyfin tanpa menghapus parameter bawaan lainnya
DEFAULT_FILE="/etc/default/jellyfin"
if [[ -f "${DEFAULT_FILE}" ]]; then
    [[ -f "${DEFAULT_FILE}.bak" ]] || cp "${DEFAULT_FILE}" "${DEFAULT_FILE}.bak"
else
    touch "${DEFAULT_FILE}"
fi

set_env_var() {
    local file="$1"
    local key="$2"
    local val="$3"
    if grep -qE "^#?[[:space:]]*${key}=" "${file}"; then
        sed -i -E "s|^#?[[:space:]]*${key}=.*|${key}=\"${val}\"|" "${file}"
    else
        echo "${key}=\"${val}\"" >> "${file}"
    fi
}

set_env_var "${DEFAULT_FILE}" "JELLYFIN_DATA_DIR"  "${JELLYFIN_BASE_DIR}/data"
set_env_var "${DEFAULT_FILE}" "JELLYFIN_CACHE_DIR" "${JELLYFIN_BASE_DIR}/cache"
set_env_var "${DEFAULT_FILE}" "JELLYFIN_LOG_DIR"   "${JELLYFIN_BASE_DIR}/log"
set_env_var "${DEFAULT_FILE}" "TMPDIR"             "${JELLYFIN_BASE_DIR}/tmp"

# 8. Buat Systemd Drop-in Override (tunggu mount eksternal + prioritas ramah STB)
info "Membuat systemd override..."
OVERRIDE_DIR="/etc/systemd/system/jellyfin.service.d"
mkdir -p "${OVERRIDE_DIR}"

{
    echo "[Unit]"
    echo "After=local-fs.target"
    if [[ "${MOUNT_POINT}" != "/" ]]; then
        echo "RequiresMountsFor=${MOUNT_POINT}"
    fi
    echo ""
    echo "[Service]"
    echo "Environment=\"TMPDIR=${JELLYFIN_BASE_DIR}/tmp\""
    echo "Nice=5"
    echo "IOSchedulingClass=best-effort"
    echo "IOSchedulingPriority=6"
} > "${OVERRIDE_DIR}/override.conf"

# 9. Cek Swap/ZRAM sebagai pengingat di perangkat RAM 1 GB
SWAP_TOTAL="$(awk '/SwapTotal/ {print $2}' /proc/meminfo)"
if (( SWAP_TOTAL == 0 )); then
    warn "Swap/ZRAM tidak aktif. Sangat disarankan mengaktifkan zram/swap untuk STB RAM 1 GB."
fi

# 10. Reload & Jalankan Service
info "Menjalankan service Jellyfin..."
systemctl daemon-reload
systemctl enable --now jellyfin

sleep 3

if systemctl is-active --quiet jellyfin; then
    LOCAL_IP="$(hostname -I | awk '{print $1}')"
    ok "Jellyfin berhasil dipasang dan berjalan!"
    echo ""
    echo "================================================================"
    echo " Akses Web UI : http://${LOCAL_IP:-<IP-STB>}:8096"
    echo " Data & Cache : ${JELLYFIN_BASE_DIR}"
    echo "----------------------------------------------------------------"
    echo " Rekomendasi Setup Awal di Web UI (khusus HG680P / S905X):"
    echo " 1. Users -> [User] -> Matikan semua opsi Transcoding (Direct Play)"
    echo " 2. Libraries -> Matikan Trickplay & Chapter Image Extraction"
    echo " 3. Pastikan user 'jellyfin' punya izin baca pada folder media"
    echo "================================================================"
else
    err "Service Jellyfin gagal start. Cek log terakhir:"
    journalctl -u jellyfin -n 25 --no-pager
    exit 1
fi
