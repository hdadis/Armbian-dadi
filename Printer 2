#!/bin/bash

# Pastikan dijalankan sebagai root
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root"
  exit 1
fi

echo "1. Memperbarui repositori..."
apt-get update

echo "2. Menginstal CUPS dan komponen inti Print Server..."
apt-get install -y cups cups-client printer-driver-gutenprint hplip printer-driver-foo2zjs p910nd avahi-daemon wget netcat-openbsd nmap

echo "3. Menginstal SANE (Scanner Server)..."
apt-get install -y sane sane-utils sane-backends

# Opsional: Coba instal driver Canon jika tersedia di arsitektur ini (tidak akan mematikan script jika gagal)
apt-get install -y printer-driver-cnijfilter-mg4200 cnijfilter2 scangearmp2 || echo "Driver khusus x86 dilewati, menggunakan Gutenprint..."

echo "4. Mengatur user dan grup lpadmin..."
id -u cupsadmin &>/dev/null || useradd -g lpadmin -m cupsadmin
id -u dadi &>/dev/null && usermod -a -G lpadmin dadi

echo "Masukkan password untuk cupsadmin:"
passwd cupsadmin

if id -u dadi &>/dev/null; then
  echo "Masukkan password untuk dadi:"
  passwd dadi
fi

echo "5. Mengunduh konfigurasi Saned, Jetdirect, dan p910nd..."
wget -O /etc/default/saned https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Saned
wget -O /usr/local/bin/jetdirect.sh https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Jetdirect
wget -O /etc/systemd/system/jetdirect.service https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Jetdirect_Service
wget -O /etc/default/p910nd https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/p910nd

chmod +x /usr/local/bin/jetdirect.sh

echo "6. Mengonfigurasi akses jaringan SANE..."
if ! grep -q "^192.168.18.0/29" /etc/sane.d/saned.conf; then
  echo "192.168.18.0/29" >> /etc/sane.d/saned.conf
fi

echo "Mengaktifkan layanan CUPS, Avahi, dan Jetdirect..."
sudo systemctl daemon-reload
sudo systemctl enable --now avahi-daemon
sudo systemctl start avahi-daemon
sudo systemctl enable --now cups
sudo cupsctl --remote-any
sudo systemctl restart cups
systemctl enable --now jetdirect

# Mengaktifkan jetdirect (setelah file berhasil diunduh di atas)
systemctl enable --now jetdirect

echo "Instalasi selesai!"
