#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=== 1. Menginstal dependensi dasar sistem ==="
apt-get update && apt-get install -y curl build-essential python3 python3-pip software-properties-common

echo "=== 2. Menginstal Node.js v20 (LTS) ==="
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Verifikasi instalasi Node.js
node -v
npm -v

echo "=== 3. Menginstal PM2 dan n8n v1.94.0 via pnpm (Lebih Cepat & Stabil) ==="
# Meningkatkan socket concurrency npm terlebih dahulu agar install pnpm lebih ngebut
npm config set maxsockets 50

# Instal pnpm secara global menggunakan npm bawaan
npm install -g pnpm --unsafe-perm

# Menggunakan pnpm untuk menginstal pm2 dan n8n secara global. 
# Ditambahkan --prod untuk melewati devDependencies agar instalasi jauh lebih ringan.
pnpm config set child-concurrency 20
pnpm add -g pm2 n8n@1.94.0 --prod

echo "=== 4. Menyiapkan konfigurasi environment n8n ==="
mkdir -p /root/n8n
mkdir -p /root/n8n/downloads
cd /root/n8n
curl -sSL https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/n8n-sql -o .env

echo "=== 5. Menginstal Cloudflared ==="
bash -c "$(curl -fsSL https://raw.githubusercontent.com/hdadis/Armbian-dadi/refs/heads/main/Cloudflared)"
cloudflared service install eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9

echo "=== 6. Menjalankan n8n dengan PM2 ==="
# Hapus instance lama jika ada yang nyangkut
pm2 delete n8n 2>/dev/null || true

# [PERBAIKAN]: Mengambil lokasi pasti biner n8n secara otomatis agar PM2 tidak bingung mencari filenya
N8N_PATH=$(which n8n)

# Jalankan n8n menggunakan path absolut yang sudah didapatkan
pm2 start "$N8N_PATH" --cwd /root/n8n --dotenv /root/n8n/.env --name "n8n"
pm2 save

# Autostart PM2 pada saat booting
env PATH=$PATH:/usr/bin /usr/lib/node_modules/pm2/bin/pm2 startup systemd -u root --hp /root

echo "=== Instalasi Selesai ==="
pm2 status
