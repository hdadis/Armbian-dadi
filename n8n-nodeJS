#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=== 1. Menginstal dependensi dasar sistem ==="
apt-get update
apt-get install -y curl build-essential python3 python3-pip software-properties-common

echo "=== 2. Menginstal Node.js v20 (LTS) ==="
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Verifikasi instalasi Node.js
node -v
npm -v

echo "=== 3. Menginstal PM2 dan n8n v1.94.0 ==="
# Menggunakan --unsafe-perm untuk mencegah issue permission saat install global di ARM
npm install -g --unsafe-perm pm2 n8n@1.94.0

echo "=== 4. Menyiapkan konfigurasi environment n8n ==="
mkdir -p /root/n8n
cd /root/n8n
curl -sSL https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/n8n-env -o /root/n8n/.env

echo "Menginstal Cloudflared..."
bash -c "$(curl -fsSL https://raw.githubusercontent.com/hdadis/Armbian-dadi/refs/heads/main/Cloudflared)"
cloudflared service install eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9

echo "=== 6. Menjalankan n8n dengan PM2 ==="
# Menjalankan n8n dari direktori kerja yang tepat
pm2 start n8n --dotenv /root/n8n/.env --name "n8n"
pm2 save

# Mengatur autostart PM2 secara otomatis tanpa input manual
env PATH=$PATH:/usr/bin /usr/lib/node_modules/pm2/bin/pm2 startup systemd -u root --hp /root

pm2 logs n8n

echo "Instalasi selesai dan berhasil dikonfigurasi!"
