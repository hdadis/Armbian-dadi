#!/bin/bash

if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root atau dengan sudo"
  exit 1
fi

echo "1. Menginstal MOC, plugin codec, dan ALSA murni..."
apt-get update
apt-get install -y --no-install-recommends moc moc-ffmpeg-plugin alsa-utils alsa-ucm-conf

echo "2. Membuat jembatan ALSA & Mixer Virtual (Master) untuk S905X-P212..."
cat << 'EOF' > /etc/asound.conf
pcm.!default {
    type plug
    slave.pcm "softvol"
}

pcm.softvol {
    type softvol
    slave {
        pcm "plughw:0,0"
    }
    control {
        name "Master"
        card 0
    }
}

ctl.!default {
    type hw
    card 0
}
EOF

# Pancing ALSA selama 1 detik agar kontrol volume 'Master' terdaftar di kernel
speaker-test -D default -c 2 -t wav -l 1 >/dev/null 2>&1 || true

# Fungsi untuk membuat konfigurasi MOC di direktori target
buat_config_moc() {
  local TARGET_USER=$1
  local TARGET_HOME=$2
  local MOC_DIR="$TARGET_HOME/.moc"

  mkdir -p "$MOC_DIR"
  cat <<EOF > "$MOC_DIR/config"
SoundDriver = ALSA
AlsaDevice = default
ALSAMixer1 = Master
ALSAMixer2 = Master
SavePlaylist = yes
Softmixer_SaveState = yes
EOF
  chown -R "$TARGET_USER":"$TARGET_USER" "$MOC_DIR"
  chmod 600 "$MOC_DIR/config"
}

echo "3. Mengatur konfigurasi MOC untuk mode ROOT (/root/.moc)..."
buat_config_moc "root" "/root"
usermod -aG audio root

echo "4. Mengatur konfigurasi MOC untuk semua user di /home (termasuk dadi)..."
for USER_DIR in /home/*; do
  if [ -d "$USER_DIR" ]; then
    U_NAME=$(basename "$USER_DIR")
    if id "$U_NAME" &>/dev/null; then
      echo "   -> Menyiapkan konfigurasi MOC untuk user: $U_NAME"
      buat_config_moc "$U_NAME" "$USER_DIR"
      usermod -aG audio "$U_NAME"
    fi
  fi
done

echo "5. Memulai ulang server MOC..."
killall -9 mocp 2>/dev/null || true
mocp -S

echo "========================================================"
echo "Fresh Install Selesai! MOC siap dijalankan di mode root maupun user."
