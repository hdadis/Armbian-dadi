#!/bin/bash

if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini dengan sudo: sudo ./set_432hz.sh"
  exit 1
fi

echo "1. Menginstal plugin LADSPA Pitch Scaler (Sangat ringan, hanya ~200KB)..."
apt-get update
apt-get install -y swh-plugins ladspa-sdk

# Tentukan target user (dadi)
TARGET_USER="dadi"
if ! id "$TARGET_USER" &>/dev/null; then
  TARGET_USER=${SUDO_USER:-root}
fi
USER_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
USER_UID=$(id -u "$TARGET_USER")

echo "2. Memasang konfigurasi Filter 432Hz (Ratio: 0.98181818) untuk user $TARGET_USER..."

# A. Buat konfigurasi untuk PipeWire (Filter-Chain 432Hz)
PW_CONF_DIR="$USER_HOME/.config/pipewire/pipewire.conf.d"
mkdir -p "$PW_CONF_DIR"

cat << 'EOF' > "$PW_CONF_DIR/99-432hz.conf"
context.modules = [
    {   name = libpipewire-module-filter-chain
        args = {
            node.description = "Output 432Hz Native"
            media.name       = "Output 432Hz Native"
            filter.graph = {
                nodes = [
                    {
                        type   = ladspa
                        name   = pitch_432hz
                        plugin = pitch_scale_1193
                        label  = pitchScale
                        control = {
                            "Pitch co-efficient" = 0.98181818
                        }
                    }
                ]
            }
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name   = "effect_input.432hz"
                media.class = Audio/Sink
            }
            playback.props = {
                node.name   = "effect_output.432hz"
                node.passive = true
            }
        }
    }
]
EOF
chown -R "$TARGET_USER":"$TARGET_USER" "$USER_HOME/.config"

# B. Buat skrip pengaktif otomatis untuk PulseAudio / PipeWire-Pulse
cat << 'EOF' > /usr/local/bin/aktifkan-432hz
#!/bin/bash
# Cek apakah modul 432Hz sudah aktif
if pactl list short sinks | grep -q "432hz"; then
  SINK_NAME=$(pactl list short sinks | awk '/432hz/ {print $2}' | head -n 1)
  pactl set-default-sink "$SINK_NAME"
  echo "[+] Output 432Hz sudah aktif dan disetel sebagai utama ($SINK_NAME)."
else
  # Jika berjalan di PulseAudio murni, muat modul LADSPA secara langsung
  MASTER_SINK=$(pactl get-default-sink)
  pactl load-module module-ladspa-sink sink_name=output_432hz master="$MASTER_SINK" plugin=pitch_scale_1193 label=pitchScale control=0.98181818 2>/dev/null || true
  pactl set-default-sink output_432hz 2>/dev/null || true
  echo "[+] Modul 432Hz berhasil diaktifkan!"
fi
EOF
chmod +x /usr/local/bin/aktifkan-432hz

echo "3. Memulai ulang layanan audio dan mengaktifkan jalur 432Hz..."
sudo -u "$TARGET_USER" XDG_RUNTIME_DIR="/run/user/$USER_UID" systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null || true
sudo -u "$TARGET_USER" XDG_RUNTIME_DIR="/run/user/$USER_UID" pulseaudio -k 2>/dev/null || true
sleep 2
sudo -u "$TARGET_USER" XDG_RUNTIME_DIR="/run/user/$USER_UID" /usr/local/bin/aktifkan-432hz

echo "========================================================"
echo "Selesai! Semua suara dari MOCP kini berjalan di frekuensi 432Hz."
echo "Catatan: Jika ingin kembali ke 440Hz standar, cukup hapus file:"
echo "rm -f $PW_CONF_DIR/99-432hz.conf && systemctl --user restart pipewire"
