bash#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "Menginstal aplikasi..."
# Ganti dengan paket yang ingin Anda install, contoh:
yes | sudo apt install -y moc
yes | sudo apt install -y gstreamer1.0-libav gstreamer1.0-plugins-ugly gstreamer1.0-plugins-ugly-multiverse
yes | sudo apt install -y libasound2-plugin-equal ladspa-sdk swh-plugins

# Buat konfigurasi ALSA (~/.asoundrc)
echo "[2/4] Membuat konfigurasi ALSA (~/.asoundrc)..."
cat << 'EOF' > ~/.asoundrc
pcm.pitch432 {
    type ladspa
    slave.pcm "plug:default"
    plugin "pitch_scale"
    label "pitchScale"
    input {
        controls [ 0.981818 ] # Rasio 432 / 440 Hz
    }
}

pcm.mocp432 {
    type plug
    slave.pcm "pitch432"
}
EOF

# Buat folder dan konfigurasi MOCP (~/.moc/config)
echo "[3/4] Mengatur konfigurasi MOCP (~/.moc/config)..."
mkdir -p ~/.moc

cat << 'EOF' > ~/.moc/config
SoundDriver = ALSA
ALSADevice = mocp432
EOF

mocp -S
pactl info
yes | sudo apt install -y pipewire pipewire-pulse pipewire-audio-client-libraries libspa-0.2-bluetooth libspa-0.2-jack wireplumber
systemctl --user --now disable pulseaudio.service pulseaudio.socket
systemctl --user mask pulseaudio.service pulseaudio.socket
systemctl --user --now enable pipewire.socket pipewire-pulse.socket
systemctl --user --now start pipewire.socket pipewire-pulse.socket
sudo apt remove pulseaudio-module-bluetooth
systemctl --user --now enable wireplumber.service
mocp -S
yes | sudo apt install -y moc moc-ffmpeg-plugin -y
yes | sudo apt install -y alsa-utils -y
sudo usermod -a -G audio $USER
yes | sudo apt install -y pulseaudio pulseaudio-utils -y
sudo usermod -a -G pulse-access $USER

echo "Instalasi selesai!"
