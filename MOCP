#!/bin/bash

if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini dengan sudo: sudo ./setup_moc_alsa.sh"
  exit 1
fi

REAL_USER=${SUDO_USER:-$USER}
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

echo "1. Menginstal MOC, plugin codec, dan ALSA murni..."
# apt-get update
apt-get install -y moc moc-ffmpeg-plugin alsa-utils

echo "2. Menambahkan user ($REAL_USER) ke grup audio..."
usermod -aG audio "$REAL_USER"

echo "3. Mengatur konfigurasi MOC (ALSA + Softmixer)..."
MOC_DIR="$USER_HOME/.moc"
mkdir -p "$MOC_DIR"

cat <<EOF > "$MOC_DIR/config"
SoundDriver = ALSA
AlsaDevice = default
SavePlaylist = yes
Softmixer_SaveState = yes
EOF

chown -R "$REAL_USER":"$REAL_USER" "$MOC_DIR"
chmod 600 "$MOC_DIR/config"

echo "4. Memulai ulang server MOC..."
su - "$REAL_USER" -c "mocp -x 2>/dev/null || true"
su - "$REAL_USER" -c "mocp -S"

echo "Selesai! MOC siap dijalankan dengan mengetik 'mocp'."
