echo "[5/5] Membuat program utama (claude_excel.py)..."
cat << 'EOF' > claude_excel.py
import os
import re
import shutil
import subprocess
import sys
import tempfile

import anthropic
from docx import Document
from docx.shared import Pt
from openpyxl import load_workbook

MODEL = "claude-opus-5-5"
MAX_PERCOBAAN = 3
MAX_TOKENS = 32000
BT = "`" * 3
ERR = {"#DIV/0!", "#REF!", "#NAME?", "#VALUE!", "#N/A", "#NUM!", "#NULL!"}

PROMPT = """You are a senior finance analyst (FP&A, accounting, corporate finance) and an expert Python/openpyxl developer.
Read the case study and answer it fully. Return exactly two parts, in this order, and nothing outside the tags:

<excel_script>
raw Python code (no markdown fences), openpyxl + standard library only, that saves "__OUT__" in the current directory
</excel_script>
<laporan>
detailed written analysis in Markdown
</laporan>

LANGUAGE: write all Excel labels and the report in the same language as the case study.

STRUCTURE: follow the case study literally. If it specifies the sheets (number, names, order), tables, columns or questions, build exactly that and answer EVERY question and sub-question in the order asked, using the question numbering in the section titles. Never add sheets that were not asked for. If the case does not specify the layout, use 2 sheets: "Analysis" (inputs, calculations, answers per question) and "Summary" (key figures linked to Analysis, checks, conclusion, recommendation, action items).

EXCEL CONTENT (detailed, analytical, but compact):
- Inputs at the top: every number given in the case in its own cell (yellow fill FFF2CC, bold blue font 0000FF). Add a short italic grey note for every assumption you add.
- Every result is a live formula that references input cells. Never compute in Python and paste values. Quote sheet names with spaces or & in formulas, e.g. 'Summary & Closure'!B2.
- Every table: header row fill 1F3864 with white bold wrapped text; show the formula logic in the header or in an adjacent "Formula / Logic" column; TOTAL row fill E7E6E6 bold; IF-formula status columns; a check cell (formula) that reconciles totals to the figures stated in the case.
- Add a wrapped-text commentary column per row or per metric with case-specific analysis: what the number means, the risk, what must be verified, largest and smallest items. Include scenario comparison, sensitivity, key risk metrics, thresholds or targets wherever relevant to the case.
- The summary sheet or section must contain: key figures linked by formula, financial impact, a clear conclusion, a recommendation and numbered action items. Sentences that contain numbers must be formulas such as ="Cost rises to "&TEXT(Analysis!C28,"#,##0"), so they stay live.
- Interpret every result (the "so what"): compare with targets, quantify the impact, state the decision and the conditions.
- Format: Calibri 11; title bold 16 navy 1F3864; italic grey 595959 subtitle; section bands fill D9E1F2 with bold navy text; amounts #,##0;(#,##0);"-" ; percentages 0.0%;(0.0%);"-" ; thin light-grey borders; gridlines hidden; freeze panes below the main header; set column widths and row heights so wrapped text is fully visible; merge long text cells across the table width.
- Use only widely supported functions: IF, IFERROR, AND, OR, SUM, SUMIF, SUMIFS, SUMPRODUCT, COUNTIF, INDEX, MATCH, MAX, MIN, AVERAGE, ROUND, TEXT, NPV, IRR, PMT. Never use XLOOKUP, FILTER, SORT, UNIQUE, LET or dynamic arrays.

CODE EFFICIENCY (saves tokens): keep the script compact. Define small helper functions for styling and for writing rows, and use loops. No comments, no docstrings, no prints. The script must be complete (never truncated) and end with wb.save("__OUT__").

REPORT (inside <laporan>): Markdown with headings in the language of the case. Detailed but do not copy every Excel cell. Sections: executive summary (key numbers and verdict); assumptions; answer to each question with formulas and figures step by step (tables allowed); analysis, interpretation and risks; conclusion, recommendation and actions. Every number must equal what the Excel formulas produce."""


def baca_soal():
    print("=" * 70)
    print("   EXCEL + WORD BUILDER (.xlsx + .docx)")
    print("=" * 70)
    print("Paste soal Anda, lalu ketik SELESAI di baris baru dan tekan ENTER:")
    print("-" * 70)
    baris_soal = []
    while True:
        try:
            baris = input()
        except EOFError:
            break
        if baris.strip().upper() == "SELESAI":
            break
        baris_soal.append(baris)
    return "\n".join(baris_soal).strip()


def panggil(client, system, messages):
    with client.messages.stream(
        model=MODEL, max_tokens=MAX_TOKENS, system=system, messages=messages
    ) as stream:
        pesan = stream.get_final_message()
    teks = "".join(b.text for b in pesan.content if getattr(b, "type", "") == "text")
    return teks, pesan.stop_reason


def ambil_tag(teks, tag):
    m = re.search(rf"<{tag}>(.*?)</{tag}>", teks, re.DOTALL)
    return m.group(1).strip() if m else None


def bersihkan_kode(kode):
    return "\n".join(l for l in kode.splitlines() if not l.strip().startswith(BT))


def cek_error_rumus(path):
    soffice = shutil.which("soffice") or shutil.which("libreoffice")
    if not soffice:
        return None
    tmp = tempfile.mkdtemp()
    try:
        subprocess.run(
            [soffice, "--headless", "--convert-to", "xlsx", "--outdir", tmp, path],
            capture_output=True, timeout=150,
        )
        hasil = os.path.join(tmp, os.path.basename(path))
        if not os.path.exists(hasil):
            return None
        wb = load_workbook(hasil, data_only=True)
        err = []
        for ws in wb.worksheets:
            for row in ws.iter_rows():
                for c in row:
                    v = c.value
                    if isinstance(v, str) and (v in ERR or v.startswith("Err:")):
                        err.append(f"{ws.title}!{c.coordinate} = {v}")
        return err
    except Exception:
        return None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def verifikasi(path):
    if not os.path.exists(path):
        return False, "Output file was not created (wb.save missing or wrong file name)."
    try:
        wb = load_workbook(path)
    except Exception as e:
        return False, f"Output file cannot be opened: {e}"
    total = 0
    for ws in wb.worksheets:
        total += sum(1 for row in ws.iter_rows() for c in row if c.data_type == "f")
    if total == 0:
        return False, "The workbook has no live formulas. Results must be formulas, not values."
    err = cek_error_rumus(path)
    if err:
        return False, "Formulas return errors after recalculation:\n" + "\n".join(err[:30])
    return True, ""


# ---------- MARKDOWN -> DOCX (di memori, tanpa file .md) ----------
def tambah_teks_inline(paragraf, teks):
    bagian = re.split(r"(\*\*.+?\*\*|`.+?`|\*.+?\*)", teks)
    for b in bagian:
        if not b:
            continue
        if b.startswith("**") and b.endswith("**") and len(b) > 4:
            paragraf.add_run(b[2:-2]).bold = True
        elif b.startswith("`") and b.endswith("`") and len(b) > 2:
            paragraf.add_run(b[1:-1]).font.name = "Consolas"
        elif b.startswith("*") and b.endswith("*") and len(b) > 2:
            paragraf.add_run(b[1:-1]).italic = True
        else:
            paragraf.add_run(b)


def pisah_sel(baris):
    return [s.strip() for s in baris.strip().strip("|").split("|")]


def md_ke_docx(md, path):
    doc = Document()
    doc.styles["Normal"].font.name = "Calibri"
    doc.styles["Normal"].font.size = Pt(11)
    baris = md.splitlines()
    i = 0
    while i < len(baris):
        s = baris[i].strip()
        if not s:
            i += 1
            continue
        if s.startswith("|") and i + 1 < len(baris) and re.match(r"^\s*\|?[\s:\-|]+\|?\s*$", baris[i + 1]):
            header = pisah_sel(s)
            i += 2
            isi = []
            while i < len(baris) and baris[i].strip().startswith("|"):
                isi.append(pisah_sel(baris[i]))
                i += 1
            tabel = doc.add_table(rows=1, cols=len(header))
            tabel.style = "Table Grid"
            for j, h in enumerate(header):
                sel = tabel.rows[0].cells[j]
                sel.text = ""
                tambah_teks_inline(sel.paragraphs[0], h)
                for r in sel.paragraphs[0].runs:
                    r.bold = True
            for row in isi:
                cells = tabel.add_row().cells
                for j in range(len(header)):
                    cells[j].text = ""
                    tambah_teks_inline(cells[j].paragraphs[0], row[j] if j < len(row) else "")
            doc.add_paragraph()
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", s)
        if m:
            doc.add_heading(m.group(2).replace("**", ""), level=min(len(m.group(1)), 4))
            i += 1
            continue
        if re.match(r"^(-{3,}|\*{3,}|_{3,})$", s):
            i += 1
            continue
        m = re.match(r"^\d+[.)]\s+(.*)$", s)
        if m:
            tambah_teks_inline(doc.add_paragraph(style="List Number"), m.group(1))
            i += 1
            continue
        m = re.match(r"^[-*+]\s+(.*)$", s)
        if m:
            tambah_teks_inline(doc.add_paragraph(style="List Bullet"), m.group(1))
            i += 1
            continue
        tambah_teks_inline(doc.add_paragraph(), s)
        i += 1
    doc.save(path)


def main():
    api_key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not api_key:
        print("\n[!] ERROR: ANTHROPIC_API_KEY belum diatur!")
        sys.exit(1)
    client = anthropic.Anthropic(api_key=api_key)

    soal = baca_soal()
    if not soal:
        print("\n[!] Soal kosong. Batal.")
        sys.exit(1)

    nama = input("\nNama file Excel output (Contoh: Jawaban.xlsx): ").strip() or "Jawaban.xlsx"
    if not nama.lower().endswith(".xlsx"):
        nama += ".xlsx"
    nama_docx = nama[:-5] + "_Analisis.docx"
    system = PROMPT.replace("__OUT__", nama)

    messages = [{"role": "user", "content": soal}]
    docx_ok = False

    try:
        for percobaan in range(1, MAX_PERCOBAAN + 1):
            print(f"\n[*] Percobaan {percobaan}/{MAX_PERCOBAAN}: Claude menyusun Excel + laporan...")
            teks, stop = panggil(client, system, messages)

            if not docx_ok:
                laporan = ambil_tag(teks, "laporan")
                if laporan:
                    try:
                        md_ke_docx(laporan, nama_docx)
                        docx_ok = True
                        print(f"[✓] Word : {os.path.abspath(nama_docx)}")
                    except Exception as e:
                        with open(nama[:-5] + "_laporan_cadangan.txt", "w", encoding="utf-8") as f:
                            f.write(laporan)
                        print(f"[!] Gagal membuat .docx ({e}). Teks cadangan disimpan.")

            kode = ambil_tag(teks, "excel_script")
            if kode is None:
                error_msg = "Response had no complete <excel_script> block (probably truncated)."
                if stop == "max_tokens":
                    error_msg += " Output hit the token limit: make the script much more compact."
                asisten = "(incomplete response)"
            else:
                kode = bersihkan_kode(kode)
                asisten = "<excel_script>\n" + kode + "\n</excel_script>"
                with open("_temp_builder.py", "w", encoding="utf-8") as f:
                    f.write(kode)
                if os.path.exists(nama):
                    os.remove(nama)
                hasil = subprocess.run(
                    [sys.executable, "_temp_builder.py"],
                    capture_output=True, text=True, timeout=180,
                )
                ok, pesan = verifikasi(nama)
                if hasil.returncode == 0 and ok:
                    os.remove("_temp_builder.py")
                    print("\n[✓] SELESAI!")
                    print(f"    Excel : {os.path.abspath(nama)}")
                    if docx_ok:
                        print(f"    Word  : {os.path.abspath(nama_docx)}")
                    sys.exit(0)
                error_msg = (hasil.stderr.strip() if hasil.returncode != 0 else pesan) or pesan \
                    or "Script exited with a non-zero status."
                print("    [!] Gagal:\n" + error_msg[-1200:])

            messages.append({"role": "assistant", "content": asisten})
            messages.append({
                "role": "user",
                "content": "The script failed:\n\n" + error_msg[-3000:] +
                           "\n\nReturn ONLY the full corrected script inside <excel_script></excel_script> "
                           "(no <laporan>), same content and structure, compact code.",
            })

        print("\n[!] Excel gagal dibuat. Kode terakhir ada di '_temp_builder.py'.")
        if docx_ok:
            print(f"    File Word tetap tersimpan: {os.path.abspath(nama_docx)}")
        sys.exit(1)

    except anthropic.APIError as e:
        print(f"\n[!] Error API: {e}")
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("\n[!] Script builder terlalu lama (timeout).")
        sys.exit(1)


if __name__ == "__main__":
    main()
EOF

