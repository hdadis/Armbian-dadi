30:8D:99:15:09:0E
D0:03:DF:11:7A:B5
74:23:44:E4:6E:86
10:27:F5:44:60:C0
EOF

echo "[2/4] Membuat skrip pembaruan firewall..."
cat << 'EOF' > /usr/local/bin/update-mac-filter.sh
#!/bin/bash
iptables -N MAC_FILTER 2>/dev/null
iptables -F MAC_FILTER
iptables -A MAC_FILTER -i lo -j RETURN

grep -v '^#' /etc/mac_whitelist.txt | grep -v '^$' | while read -r mac; do
    iptables -A MAC_FILTER -m mac --mac-source "$mac" -j RETURN
done

iptables -A MAC_FILTER -j DROP

iptables -D INPUT -p udp --dport 53 -j MAC_FILTER 2>/dev/null
iptables -D INPUT -p tcp --dport 53 -j MAC_FILTER 2>/dev/null
iptables -I INPUT -p udp --dport 53 -j MAC_FILTER
iptables -I INPUT -p tcp --dport 53 -j MAC_FILTER

echo "Filter MAC Address berhasil diterapkan!"
EOF

chmod +x /usr/local/bin/update-mac-filter.sh

echo "[3/4] Menjadikan skrip utama sebagai perintah global (maclist)..."
# Menyalin file ini langsung ke folder /usr/local/bin/ dan mengubah namanya menjadi maclist
cp "$0" /usr/local/bin/maclist
chmod +x /usr/local/bin/maclist

echo "[4/4] Menjalankan aturan firewall & menyimpan konfigurasi..."
/usr/local/bin/update-mac-filter.sh
apt update && apt install iptables-persistent -y
netfilter-persistent save

echo "===================================================="
echo "Instalasi selesai!"
echo "Sekarang Anda bisa menjalankan perintah kapan saja dengan:"
echo "sudo maclist"
echo "===================================================="
