#!/bin/bash

# Pastikan dijalankan sebagai root (sudo)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan skrip ini dengan hak akses sudo: sudo ./maclist.sh"
  exit 1
fi

echo "[1/4] Membuat daftar whitelist MAC address..."
cat << 'EOF' > /etc/mac_whitelist.txt
C0:E3:FB:1A:E5:7F
74:51:BA:0F:2E:E1
FC:9D:05:38:0A:2E
78:53:33:43:29:DC
58:20:71:EC:8A:28
C8:90:8A:71:CE:EB
E8:A7:2F:0A:03:3E
7C:70:DB:2B:35:B3
4C:BB:6F:5B:64:BC
AC:A7:F1:33:3C:4E
F0:A7:31:36:78:DB
30:DE:4B:A8:4D:44
30:DE:4B:A8:55:5F
98:25:4A:CC:15:07
30:DE:4B:81:67:95
38:2C:E5:0E:52:F5
8C:87:D0:19:E9:7D
3C:97:0E:E8:B6:7A
00:15:18:01:81:31
CC:4D:75:96:B3:B8
9C:6B:00:15:1E:2F
58:85:E9:71:05:CF
