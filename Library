import os, re, sqlite3, fcntl, time

BASE = "/opt/ai-modul"
MODUL_DIR = f"{BASE}/modul_pdf"
DB_FILE = f"{BASE}/index.db"
KEY_FILE = f"{BASE}/api_key.txt"
PASS_FILE = f"{BASE}/web_password.txt"
LOCK_FILE = f"{BASE}/.index.lock"
STATUS_FILE = f"{BASE}/status.json"
FLAG_RETRY = f"{BASE}/retry.flag"
FLAG_REINDEX = f"{BASE}/reindex.flag"

MODEL_NAME = "gemini-3.5-flash-lite"
EXTS = (".pdf", ".docx", ".xlsx", ".csv", ".txt", ".jpg", ".jpeg", ".png", ".webp")
IMG_EXTS = (".jpg", ".jpeg", ".png", ".webp")
PLACEHOLDER = "TEMPEL_API_KEY_ANDA_DISINI"
MAX_TRIES = 3

SCHEMA = """
CREATE TABLE IF NOT EXISTS files(
  name TEXT PRIMARY KEY, size INTEGER, mtime REAL, status TEXT,
  chunks INTEGER DEFAULT 0, tries INTEGER DEFAULT 0, error TEXT, updated REAL);
CREATE VIRTUAL TABLE IF NOT EXISTS chunks USING fts5(
  isi, sumber UNINDEXED, halaman UNINDEXED,
  tokenize='unicode61 remove_diacritics 2');
"""


def get_api_key():
    try:
        with open(KEY_FILE, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def has_key(k):
    return bool(k) and PLACEHOLDER not in k


def save_api_key(key):
    fd = os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(key.strip())


def get_db():
    db = sqlite3.connect(DB_FILE, timeout=60)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=NORMAL")
    db.executescript(SCHEMA)
    return db


def list_files():
    out = []
    if not os.path.isdir(MODUL_DIR):
        return out
    for f in sorted(os.listdir(MODUL_DIR)):
        if f.startswith(".") or not f.lower().endswith(EXTS):
            continue
        p = os.path.join(MODUL_DIR, f)
        try:
            if not os.path.isfile(p):
                continue
            st = os.stat(p)
        except OSError:
            continue
        out.append((f, st.st_size, st.st_mtime))
    return out


def lock_held():
    """True jika indexer sedang berjalan."""
    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


CACHE_DIR = f"{BASE}/cache_img"
VISUAL_RE = re.compile(
    r"\b(bentuk|tampilan|gambar|foto|formulir|form|blangko|template|rupa|wujud|layout|skema|"
    r"diagram|bagan|grafik|tabel|tunjukkan|perlihatkan|tampilkan|seperti apa)\b", re.I)


def minta_visual(teks):
    return bool(VISUAL_RE.search(teks or ""))


def render_sumber(sumber, halaman, lebar=1400):
    """Kembalikan path JPEG (di cache) untuk halaman PDF / file gambar; None jika tidak bisa."""
    import hashlib
    ext = os.path.splitext(sumber)[1].lower()
    path = os.path.join(MODUL_DIR, sumber)
    if not os.path.isfile(path):
        return None
    st = os.stat(path)
    kunci = hashlib.sha1(f"{sumber}|{halaman}|{st.st_mtime}|{st.st_size}".encode()).hexdigest()[:20]
    os.makedirs(CACHE_DIR, exist_ok=True)
    out = os.path.join(CACHE_DIR, kunci + ".jpg")
    if os.path.exists(out):
        return out
    img = None
    try:
        if ext == ".pdf":
            m = re.search(r"(\d+)", halaman or "")
            if not m:
                return None
            import pypdfium2 as pdfium
            pdf = pdfium.PdfDocument(path)
            try:
                idx = int(m.group(1)) - 1
                if idx < 0 or idx >= len(pdf):
                    return None
                page = pdf[idx]
                scale = min(2.0, lebar / max(page.get_width(), 1))
                img = page.render(scale=scale).to_pil()
            finally:
                pdf.close()
        elif ext in IMG_EXTS:
            from PIL import Image
            with Image.open(path) as im:
                im.load()
                img = im.copy()
        else:
            return None
        if img.mode != "RGB":
            img = img.convert("RGB")
        img.thumbnail((lebar, lebar * 2))
        img.save(out, "JPEG", quality=85)
    except Exception:
        return None
    # batasi cache maksimal 300 gambar
    try:
        fs = sorted((os.path.join(CACHE_DIR, f) for f in os.listdir(CACHE_DIR)), key=os.path.getmtime)
        for f in fs[:-300]:
            os.remove(f)
    except OSError:
        pass
    return out


STOP = set("""
yang dan di ke dari untuk pada dengan adalah itu ini atau apa siapa bagaimana mengapa kenapa
kapan dimana apakah saja ada akan dalam sebagai oleh juga tidak dapat bisa para saya kita
kami mereka dia anda sebuah suatu agar sehingga karena jika maka lebih sangat telah sudah
the a an of to in and is are for on with what how why when where which who be by as at it
""".split())


def tokens(text):
    ws = re.findall(r"[0-9a-zA-Z\u00C0-\u024F]+", (text or "").lower())
    return [w for w in ws if len(w) > 1 and w not in STOP]


def build_query(words, limit=40):
    parts = []
    for w in list(dict.fromkeys(words))[:limit]:
        parts.append(f'"{w}"*' if len(w) >= 4 else f'"{w}"')
    return " OR ".join(parts)


def cari(db, pertanyaan, tambahan="", k=8):
    q = build_query(tokens(pertanyaan) + tokens(tambahan))
    if not q:
        return []
    try:
        return db.execute(
            "SELECT sumber, halaman, isi FROM chunks WHERE chunks MATCH ? "
            "ORDER BY bm25(chunks) LIMIT ?", (q, k)).fetchall()
    except sqlite3.OperationalError:
        return []
