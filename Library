sisa = [n for n in manifest if n not in {f[0] for f in files}]
if sisa:
    print("\nMasih di indeks tapi file fisik sudah dihapus (dibersihkan otomatis saat indexer jalan):")
    for n in sisa:
        print(f"- {n}")
PYSTATUS

chmod 644 "$APP_DIR"/*.py

# ---------------------------------------------------------------- [5/7]
echo -e "\n${YELLOW}[5/7] Membuat shortcut terminal & logrotate...${NC}"
cat << EOF > /usr/local/bin/cek-modul
#!/bin/bash
cd $APP_DIR && $VENV/bin/python $APP_DIR/cek_status.py
EOF
cat << EOF > /usr/local/bin/index-modul
#!/bin/bash
systemctl start ai-modul-index.service && tail -n 20 $APP_DIR/proses.log
EOF
chmod +x /usr/local/bin/cek-modul /usr/local/bin/index-modul

touch "$APP_DIR/proses.log"
cat << EOF > /etc/logrotate.d/ai-modul
$APP_DIR/proses.log {
    size 1M
    rotate 3
    missingok
    notifempty
    copytruncate
    compress
}
EOF

# ---------------------------------------------------------------- [6/7]
echo -e "\n${YELLOW}[6/7] Membuat systemd service (Web UI) & timer (indexer)...${NC}"
cat << EOF > /etc/systemd/system/ai-modul.service
[Unit]
Description=AI Asisten Modul (Web UI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
Environment=PYTHONUNBUFFERED=1
ExecStart=$VENV/bin/streamlit run $APP_DIR/app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true --server.fileWatcherType none --server.maxUploadSize 100 --browser.gatherUsageStats false
Restart=always
RestartSec=5
Nice=10
OOMScoreAdjust=300
$MEM_WEB

[Install]
WantedBy=multi-user.target
EOF

cat << EOF > /etc/systemd/system/ai-modul-index.service
[Unit]
Description=AI Asisten Modul (Indexer)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=$APP_DIR
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'exec $VENV/bin/python $APP_DIR/indexer.py >> $APP_DIR/proses.log 2>&1'
Nice=15
IOSchedulingClass=idle
OOMScoreAdjust=700
$MEM_IDX
TimeoutStartSec=3h
EOF

cat << EOF > /etc/systemd/system/ai-modul-index.timer
[Unit]
Description=Cek dokumen modul baru tiap 5 menit

[Timer]
OnBootSec=2min
OnUnitInactiveSec=5min
Unit=ai-modul-index.service

[Install]
WantedBy=timers.target
EOF

# ---------------------------------------------------------------- [7/7]
echo -e "\n${YELLOW}[7/7] Mengaktifkan layanan...${NC}"
systemctl daemon-reload
systemctl enable ai-modul
systemctl restart ai-modul
systemctl enable --now ai-modul-index.timer
systemctl start --no-block ai-modul-index.service || true

IP_STB=$(hostname -I | awk '{print $1}')
echo -e "\n${GREEN}=== SELESAI! ===${NC}"
echo -e "${CYAN}Web UI          :${NC} http://${IP_STB}:8501"
echo -e "${CYAN}Folder Modul    :${NC} $APP_DIR/modul_pdf  (file baru otomatis terindeks)"
echo -e "${CYAN}Cek Status      :${NC} sudo cek-modul"
echo -e "${CYAN}Indeks Manual   :${NC} sudo index-modul"
echo -e "${CYAN}Pantau Log      :${NC} tail -f $APP_DIR/proses.log"
if [ -d "$APP_DIR/database_ai" ]; then
  echo -e "${YELLOW}Catatan: database ChromaDB lama ($APP_DIR/database_ai) tidak dipakai lagi.${NC}"
  echo -e "${YELLOW}File modul akan diindeks ulang otomatis; setelah itu folder lama boleh dihapus: sudo rm -rf $APP_DIR/database_ai${NC}"
fi
if [ -z "$WEB_PASS" ] && [ ! -f "$APP_DIR/web_password.txt" ]; then
  echo -e "${YELLOW}Peringatan: Web UI tanpa password. Siapa pun di LAN bisa memakai API Key Anda untuk bertanya.${NC}"
fi
