#!/usr/bin/env python3
# Dijalankan oleh systemd (ai-modul-index.service) tiap 5 menit & dari tombol Web UI.
# Bagian awal sengaja ringan (hanya sqlite3) supaya run "tidak ada file baru" nyaris gratis.
import os, sys, json, time, fcntl
from common import (MODUL_DIR, LOCK_FILE, STATUS_FILE, FLAG_RETRY, FLAG_REINDEX,
                    IMG_EXTS, MAX_TRIES, get_api_key, has_key, get_db, list_files)


def log(msg):
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}", flush=True)


def write_status(**kw):
    kw["time"] = time.strftime("%Y-%m-%d %H:%M:%S")
    tmp = STATUS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(kw, f, ensure_ascii=False)
    os.replace(tmp, STATUS_FILE)


def main():
    os.makedirs(MODUL_DIR, exist_ok=True)
    lockfd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # indexer lain sedang jalan

    db = get_db()

    if os.path.exists(FLAG_REINDEX):
        os.remove(FLAG_REINDEX)
        with db:
            db.execute("DELETE FROM chunks")
            db.execute("DELETE FROM files")
        log("Indeks direset: semua file akan diproses ulang.")
    if os.path.exists(FLAG_RETRY):
        os.remove(FLAG_RETRY)
        with db:
            db.execute("UPDATE files SET tries=0 WHERE status='error'")
        log("Percobaan file gagal direset.")

    manifest = {r[0]: r for r in db.execute(
        "SELECT name,size,mtime,status,tries,updated FROM files")}
    files = list_files()
    ada = {f[0] for f in files}

    # file yang sudah dihapus dari folder -> bersihkan dari indeks
    hilang = [n for n in manifest if n not in ada]
    if hilang:
        with db:
            for n in hilang:
                db.execute("DELETE FROM chunks WHERE sumber=?", (n,))
                db.execute("DELETE FROM files WHERE name=?", (n,))
        log(f"Membersihkan {len(hilang)} file yang sudah dihapus dari folder.")

    key = get_api_key()
    now = time.time()
    todo, tanpa_key = [], 0
    for name, size, mtime in files:
        if name.lower().endswith(IMG_EXTS) and not has_key(key):
            tanpa_key += 1
            continue
        m = manifest.get(name)
        if m is None or m[1] != size or abs((m[2] or 0) - mtime) > 1:
            todo.append((name, size, mtime))
        elif m[3] == "error" and m[4] < MAX_TRIES and now - (m[5] or 0) >= 900 * max(m[4], 1):
            todo.append((name, size, mtime))

    if not todo:
        return 0

    # pastikan file selesai disalin (ukuran stabil)
    time.sleep(2)
    stabil = []
    for name, size, mtime in todo:
        try:
            if os.path.getsize(os.path.join(MODUL_DIR, name)) == size:
                stabil.append((name, size, mtime))
        except OSError:
            pass
    todo = stabil
    if not todo:
        return 0

    from ekstrak import ekstrak_teks, chunkify  # impor berat hanya jika ada kerja

    log(f"=== Ditemukan {len(todo)} dokumen baru/berubah ===")
    ok = kosong = gagal = 0
    for i, (name, size, mtime) in enumerate(todo, 1):
        write_status(state="running", current=name, done=i - 1, total=len(todo))
        log(f"[{i}/{len(todo)}] Memproses: {name}")
        m = manifest.get(name)
        sama = bool(m) and m[1] == size and abs((m[2] or 0) - mtime) <= 1
        try:
            secs = ekstrak_teks(os.path.join(MODUL_DIR, name), key)
            rows = [(c, name, label) for label, text in secs for c in chunkify(text)]
            status = "ok" if rows else "empty"
            err = None if rows else "tidak ada teks terbaca (PDF scan/file kosong)"
            with db:
                db.execute("DELETE FROM chunks WHERE sumber=?", (name,))
                if rows:
                    db.executemany("INSERT INTO chunks(isi,sumber,halaman) VALUES (?,?,?)", rows)
                db.execute(
                    "INSERT INTO files(name,size,mtime,status,chunks,tries,error,updated) "
                    "VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET "
                    "size=excluded.size, mtime=excluded.mtime, status=excluded.status, "
                    "chunks=excluded.chunks, tries=excluded.tries, error=excluded.error, "
                    "updated=excluded.updated",
                    (name, size, mtime, status, len(rows), 0, err, time.time()))
            if rows:
                ok += 1
                log(f"   -> OK ({len(rows)} bagian)")
            else:
                kosong += 1
                log(f"   -> KOSONG: {err}")
        except Exception as e:
            gagal += 1
            tries = (m[4] + 1) if (sama and m and m[3] == "error") else 1
            log(f"   -> [ERROR] {name}: {e} (percobaan {tries}/{MAX_TRIES})")
            with db:
                if not sama:
                    db.execute("DELETE FROM chunks WHERE sumber=?", (name,))
                db.execute(
                    "INSERT INTO files(name,size,mtime,status,chunks,tries,error,updated) "
                    "VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(name) DO UPDATE SET "
                    "size=excluded.size, mtime=excluded.mtime, status=excluded.status, "
                    "chunks=excluded.chunks, tries=excluded.tries, error=excluded.error, "
                    "updated=excluded.updated",
                    (name, size, mtime, "error", 0, tries, str(e)[:300], time.time()))

    try:
        with db:
            db.execute("INSERT INTO chunks(chunks) VALUES('optimize')")
    except Exception:
        pass
    msg = f"Selesai: {ok} berhasil, {kosong} tanpa teks, {gagal} gagal"
    write_status(state="idle", msg=msg, done=len(todo), total=len(todo))
    log(f"=== {msg} ===")
    return 0


if __name__ == "__main__":
