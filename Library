import os, csv, time
from common import MODEL_NAME, IMG_EXTS

PROMPT_GAMBAR = ("Transkripsikan seluruh teks, tabel, grafik, dan isi gambar ini "
                 "secara rinci dalam bahasa Indonesia.")


OCR_BATCH = 4          # halaman per permintaan ke Gemini
OCR_MAX_PAGES = 80     # batas halaman scan yang di-OCR per file PDF

PROMPT_OCR = ("Berikut halaman-halaman dokumen hasil scan (nomor halaman: {daftar}). "
              "Untuk SETIAP halaman, transkripsikan seluruh teks, isi tabel, serta judul, kolom, dan isian "
              "formulir secara rinci dengan bahasa aslinya. Awali tiap halaman dengan satu baris persis seperti "
              "ini: === HALAMAN <nomor> === . Jika halaman kosong, tulis (kosong) setelah penanda.")


def _generate_retry(client, contents):
    last = None
    for attempt in range(3):
        try:
            return client.models.generate_content(model=MODEL_NAME, contents=contents)
        except Exception as e:
            last = e
            s = str(e)
            if not any(x in s for x in ("429", "503", "RESOURCE_EXHAUSTED", "UNAVAILABLE")):
                raise
            time.sleep(20 * (attempt + 1))
    raise last


def _pisah_halaman(teks, batch):
    import re
    bagian = re.split(r"===\s*HALAMAN\s*(\d+)\s*===", teks)
    hasil = {}
    if len(bagian) >= 3:
        for j in range(1, len(bagian) - 1, 2):
            n = int(bagian[j])
            if n in batch:
                hasil[n] = (hasil.get(n, "") + "\n" + bagian[j + 1]).strip()
    elif teks.strip():
        hasil[batch[0]] = teks.strip()
    return [(f"Hal {n}", t) for n, t in sorted(hasil.items()) if len(t.strip()) > 10]


def _ocr_pdf(fp, nomor, api_key):
    import pypdfium2 as pdfium
    from google import genai
    from google.genai import types
    print(f"   -> OCR {len(nomor)} halaman scan via Gemini", flush=True)
    client = genai.Client(api_key=api_key, http_options=types.HttpOptions(timeout=180_000))
    pdf = pdfium.PdfDocument(fp)
    out = []
    try:
        for i in range(0, len(nomor), OCR_BATCH):
            batch = nomor[i:i + OCR_BATCH]
            isi = []
            for n in batch:
                page = pdf[n - 1]
                scale = min(2.0, 1600 / max(page.get_width(), 1))
                isi.append(f"Halaman {n}:")
                isi.append(page.render(scale=scale).to_pil().convert("RGB"))
            isi.append(PROMPT_OCR.format(daftar=", ".join(str(n) for n in batch)))
            res = _generate_retry(client, isi)
            out.extend(_pisah_halaman(res.text or "", batch))
            time.sleep(4)
    finally:
        pdf.close()
    return out


def _pdf(fp, api_key=""):
    from pypdf import PdfReader
    r = PdfReader(fp)
    if r.is_encrypted:
        r.decrypt("")
    out, kosong = [], []
    for i, p in enumerate(r.pages):
        try:
            t = p.extract_text() or ""
        except Exception:
            t = ""
        if len(t.strip()) > 30:
            out.append((f"Hal {i+1}", t))
        else:
            kosong.append(i + 1)
    if kosong and api_key and "TEMPEL_API_KEY" not in api_key:
        if len(kosong) > OCR_MAX_PAGES:
            print(f"   -> {len(kosong)} halaman tanpa teks, OCR dibatasi {OCR_MAX_PAGES} halaman pertama", flush=True)
        out.extend(_ocr_pdf(fp, kosong[:OCR_MAX_PAGES], api_key))
        out.sort(key=lambda x: int(x[0].split()[1]))
    return out


def _docx(fp):
    from docx import Document
    d = Document(fp)
    parts = [p.text for p in d.paragraphs if p.text.strip()]
    for tb in d.tables:
        for row in tb.rows:
            cells = [c.text.strip() for c in row.cells if c.text.strip()]
            if cells:
                parts.append(" | ".join(cells))
    t = "\n".join(parts)
    return [("Dokumen Word", t)] if len(t.strip()) > 30 else []


def _txt(fp):
    with open(fp, "r", encoding="utf-8", errors="ignore") as f:
        t = f.read()
    return [("File Teks", t)] if len(t.strip()) > 30 else []


def _xlsx(fp):
    import openpyxl
    wb = openpyxl.load_workbook(fp, data_only=True, read_only=True)
    out = []
    try:
        for name in wb.sheetnames:
            rows, headers, first = [], [], True
            for row in wb[name].iter_rows(values_only=True):
                clean = [str(c).strip() if c is not None else "" for c in row]
                if not any(clean):
                    continue
                if first:
                    headers, first = clean, False
                    rows.append("Kolom: " + " | ".join(h for h in headers if h))
                elif len(headers) == len(clean):
                    rows.append(" ; ".join(f"{h}: {v}" for h, v in zip(headers, clean) if v))
                else:
                    rows.append(" | ".join(v for v in clean if v))
            if rows:
                out.append((f"Sheet '{name}'", "\n".join(rows)))
    finally:
        wb.close()
    return out


def _csv(fp):
    csv.field_size_limit(10_000_000)
    with open(fp, "r", encoding="utf-8-sig", errors="ignore", newline="") as f:
        rows = [" | ".join(r) for r in csv.reader(f) if any(r)]
    return [("Data CSV", "\n".join(rows))] if rows else []


def _gambar(fp, api_key):
    from PIL import Image
    from google import genai
    from google.genai import types
    client = genai.Client(api_key=api_key, http_options=types.HttpOptions(timeout=120_000))
    with Image.open(fp) as img:
        img.load()
        if img.mode not in ("RGB", "L"):
            img = img.convert("RGB")
        img.thumbnail((2000, 2000))
        last = None
        for attempt in range(3):
            try:
                res = client.models.generate_content(model=MODEL_NAME, contents=[img, PROMPT_GAMBAR])
                break
            except Exception as e:
                last = e
                s = str(e)
                if not any(x in s for x in ("429", "503", "RESOURCE_EXHAUSTED", "UNAVAILABLE")):
                    raise
                time.sleep(20 * (attempt + 1))
        else:
            raise last
    time.sleep(4)
    t = res.text or ""
    return [("Gambar Modul", t)] if len(t.strip()) > 10 else []


def ekstrak_teks(filepath, api_key=""):
    ext = os.path.splitext(filepath)[1].lower()
    if ext == ".pdf":
        return _pdf(filepath, api_key)
    if ext == ".docx":
        return _docx(filepath)
    if ext == ".txt":
        return _txt(filepath)
    if ext == ".xlsx":
        return _xlsx(filepath)
    if ext == ".csv":
        return _csv(filepath)
    if ext in IMG_EXTS:
        return _gambar(filepath, api_key)
    return []


def chunkify(text, size=1000):
    chunks, buf = [], ""
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        while len(line) > size:
            if buf:
                chunks.append(buf)
                buf = ""
            chunks.append(line[:size])
            line = line[size:]
        if buf and len(buf) + len(line) + 1 > size:
            chunks.append(buf)
            buf = line
        else:
            buf = (buf + "\n" + line) if buf else line
    if buf:
        chunks.append(buf)
    return [c for c in chunks if len(c.strip()) > 10]
PYEKSTRAK

