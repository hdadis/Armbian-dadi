#!/bin/bash

# Exit on error
set -e

echo "=================================================="
echo "  n8n + PostgreSQL FULL NATIVE (No Docker) Setup  "
echo "=================================================="

# Variable Configuration
DB_NAME="n8n"
DB_USER="n8n_user"
DB_PASS="980Abc"
PROJECT_DIR="/var/www/n8n"

# [1/5] Install Dependencies
echo "[1/5] Installing System Dependencies, Node.js, & PM2..."
sudo apt update -y
sudo apt install -y postgresql postgresql-contrib curl git build-essential

curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
sudo apt install -y nodejs
sudo npm install -g pm2 n8n

# [2/5] Setup Database
echo "[2/5] Setting up Native PostgreSQL Database..."
sudo -u postgres psql -tc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" | grep -q 1 || \
sudo -u postgres psql -c "CREATE DATABASE $DB_NAME;"

sudo -u postgres psql -tc "SELECT 1 FROM pg_roles WHERE rolname = '$DB_USER'" | grep -q 1 || \
sudo -u postgres psql -c "CREATE USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"

sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER;"
sudo -u postgres psql -c "ALTER DATABASE $DB_NAME OWNER TO $DB_USER;"

sudo systemctl restart postgresql
sudo systemctl enable postgresql

# [3/5] Buat Folder Project
echo "[3/5] Setting up project directory..."
sudo mkdir -p $PROJECT_DIR
sudo chown -R $USER:$USER $PROJECT_DIR

# [4/5] Generate .env FILE (Wajib Sebelum Start PM2)
echo "[4/5] Generating .env file at $PROJECT_DIR/.env..."
cat << 'EOF' > $PROJECT_DIR/.env
# Domain Configuration
DOMAIN_NAME=https://ai.balai.my.id/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# n8n General Settings
N8N_HOST=0.0.0.0
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_ENV=production
WEBHOOK_URL=https://ai.balai.my.id/
N8N_SECURE_COOKIE=false

# Native PostgreSQL Connection
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=980Abc

# Security Key
N8N_ENCRYPTION_KEY=980Abc

# Timezone
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
EOF

# [5/5] Start PM2 Service
echo "[5/5] Starting n8n service via PM2..."
sudo pm2 startup systemd -u $USER --hp $HOME || true

cd $PROJECT_DIR
pm2 start n8n --name n8n --env .env
pm2 save

echo "=================================================="
echo " Instalasi Native Selesai & n8n Berhasil Dijalankan!"
echo " Status PM2:"
pm2 status
echo "=================================================="
