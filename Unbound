#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "1. Menginstal aplikasi..."
apt update
# Menambahkan ca-certificates agar tls-cert-bundle berfungsi
apt install unbound unbound-anchor dnsutils net-tools tcpdump wget ca-certificates -y
dig -v

echo "2. Copy Configuration Unbound & Auto-Update dari GitHub..."
wget -O /etc/unbound/unbound.conf.d/unbound.conf https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Unbound3
wget -O /etc/systemd/system/apt-auto-update.service https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Unbound4
wget -O /usr/local/sbin/apt-auto-update.sh https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Unbound5

chmod +x /usr/local/sbin/apt-auto-update.sh
systemctl daemon-reload
systemctl enable apt-auto-update.service

echo "3. Menonaktifkan DNSStubListener agar Port 53 bisa dipakai AdGuard Home..."
sed -i 's/#DNSStubListener=yes/DNSStubListener=no/' /etc/systemd/resolved.conf
sed -i 's/DNSStubListener=yes/DNSStubListener=no/' /etc/systemd/resolved.conf
systemctl restart systemd-resolved

echo "4. Mengunduh root.hints dan menyiapkan DNSSEC root.key..."
wget https://www.internic.net/domain/named.root -O /var/lib/unbound/root.hints
unbound-anchor -a /var/lib/unbound/root.key || true
cp /var/lib/unbound/root.key /etc/unbound/root.key
chown -R unbound:unbound /var/lib/unbound /etc/unbound

echo "5. Menambahkan pengaturan Port 5335 & Forward-Zone (DNS-over-TLS) ke Unbound3..."
# Menghapus file adguard-port.conf sisa percobaan manual jika ada, agar digabung rapi di unbound.conf
rm -f /etc/unbound/unbound.conf.d/adguard-port.conf

cat << 'EOF' >> /etc/unbound/unbound.conf.d/unbound.conf

server:
    port: 5335
    interface: 0.0.0.0
    access-control: 127.0.0.0/8 allow
    access-control: 192.168.0.0/16 allow
    access-control: 172.16.0.0/12 allow
    tls-cert-bundle: /etc/ssl/certs/ca-certificates.crt

forward-zone:
    name: "."
    forward-tls-upstream: yes
    # Cloudflare DNS over TLS
    forward-addr: 1.1.1.1@853#cloudflare-dns.com
    forward-addr: 1.0.0.1@853#cloudflare-dns.com
    # Quad9 DNS over TLS
    forward-addr: 9.9.9.9@853#dns.quad9.net
EOF

echo "6. Memeriksa konfigurasi dan menjalankan Unbound..."
unbound-checkconf
systemctl restart unbound
systemctl enable unbound
systemctl status unbound --no-pager

echo "7. Menguji hasil akhir Unbound di Port 5335..."
netstat -tlpn | grep unbound
dig sigok.verteiltesysteme.net @127.0.0.1 -p 5335
dig sigfail.verteiltesysteme.net @127.0.0.1 -p 5335
dig dnssec-failed.org @127.0.0.1 -p 5335

echo "Instalasi selesai!"
