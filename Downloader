#!/bin/bash
# ============================================================
#  instalasi.sh - Downloader untuk Armbian HG680P
#  aria2 + AriaNg (web UI) + yt-dlp (yt / ytmp3 / ytm4a)
#
#  SEMUA unduhan masuk ke folder IDM:
#      /mnt/External/Downloads/IDM
#  - Kalau folder itu sudah berada di disk/mount TERPISAH dari disk sistem
#    (flashdisk/HDD USB, atau folder jaringan sshfs/cifs/nfs, termasuk kalau
#    yang di-mount folder induknya), dipakai apa adanya.
#  - Kalau belum, dipasang otomatis lewat sshfs ke REMOTE_HOST.
#  - Unduhan DITOLAK kalau folder itu ternyata di disk sistem (misal disk
#    USB tercabut), supaya disk sistem tidak penuh.
#  Aman dijalankan berulang kali (tidak menghapus file apa pun).
# ============================================================
set -e

# ---------- PENGATURAN ----------
REMOTE_USER="root"
REMOTE_HOST="192.168.18.2"
REMOTE_DIR="/mnt/External/Downloads/IDM"
MOUNT_DIR="/mnt/External/Downloads/IDM"   # lokasi di HG680P (sama dengan folder tujuan)
OLD_MOUNT="/mnt/idm"                       # mount lama; dibersihkan bila masih ada
RPC_PORT="6800"
WEB_PORT="6880"
# --------------------------------

if [ "$(id -u)" -ne 0 ]; then
  echo "Jalankan sebagai root."; exit 1
fi
export DEBIAN_FRONTEND=noninteractive

# jenis filesystem tempat sebuah path berada (bukan sekadar mountpoint)
fs_type()   { findmnt -n -o FSTYPE -T "$1" 2>/dev/null | head -n1; }
fs_target() { findmnt -n -o TARGET -T "$1" 2>/dev/null | head -n1; }
fs_source() { findmnt -n -o SOURCE -T "$1" 2>/dev/null | head -n1; }
# true jika path ada di disk/mount TERPISAH (USB atau jaringan), bukan di disk sistem "/"
on_separate_mount() { local t; t="$(fs_target "$1")"; [ -n "$t" ] && [ "$t" != "/" ]; }

# ------------------------------------------------------------
echo "==> [1/6] Install paket"
apt-get update -y
apt-get install -y aria2 curl unzip python3 ca-certificates ffmpeg

# ------------------------------------------------------------
echo "==> [2/6] Folder IDM (${MOUNT_DIR})"
FS="$(fs_type "$MOUNT_DIR")"
if [ -d "$MOUNT_DIR" ] && on_separate_mount "$MOUNT_DIR"; then
  echo "    Sudah ter-mount: $(fs_target "$MOUNT_DIR") <- $(fs_source "$MOUNT_DIR") (tipe: ${FS}), dipakai apa adanya."
else
  echo "    Belum ada disk/mount terpisah di sini (terbaca: ${FS:-folder belum ada})."
  if grep -E '^[^#]*[[:space:]]/mnt/External(/[^[:space:]]*)?[[:space:]]' /etc/fstab 2>/dev/null | grep -qv 'fuse.sshfs'; then
    echo "GAGAL: /mnt/External terdaftar di /etc/fstab tapi belum ter-mount (flashdisk/HDD belum terpasang?)."
    echo "       Pasang disknya, jalankan: mount -a   lalu ulangi script ini."
    exit 1
  fi
  echo "    Memasang folder IDM lewat sshfs dari ${REMOTE_HOST}..."
  apt-get install -y sshfs fuse3 openssh-client

  KEY=""
  for k in id_ed25519 id_rsa id_ecdsa; do
    if [ -f "/root/.ssh/$k" ]; then KEY="/root/.ssh/$k"; break; fi
  done
  if [ -z "$KEY" ]; then
    echo "    SSH key belum ada, membuat key baru..."
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519 -q
    KEY="/root/.ssh/id_ed25519"
  fi
  ssh_test() {
    ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "${REMOTE_USER}@${REMOTE_HOST}" "test -d '${REMOTE_DIR}'" >/dev/null 2>&1
  }
  if ! ssh_test; then
    echo "    Login pakai key belum bisa. Mengirim key ke ${REMOTE_HOST}..."
    echo "    >>> Masukkan password ${REMOTE_USER}@${REMOTE_HOST} (hanya sekali ini) <<<"
    ssh-copy-id -i "${KEY}.pub" -o StrictHostKeyChecking=accept-new \
        "${REMOTE_USER}@${REMOTE_HOST}" </dev/tty || true
    if ! ssh_test; then
      echo "GAGAL: tidak bisa SSH ke ${REMOTE_USER}@${REMOTE_HOST}, atau folder ${REMOTE_DIR} tidak ada di sana."
      exit 1
    fi
  fi

  # jangan menutupi file yang ada di disk lokal HG680P
  if [ -d "$MOUNT_DIR" ] && [ -n "$(ls -A "$MOUNT_DIR" 2>/dev/null)" ]; then
    echo "GAGAL: ${MOUNT_DIR} berisi file dan berada di DISK SISTEM (tipe: ${FS:-?})."
    echo "       Kalau menurut Anda folder ini sudah ter-mount, kirim hasil ini:"
    echo "       findmnt -T ${MOUNT_DIR}"
    exit 1
  fi

  mkdir -p "$MOUNT_DIR"
  sed -i 's/^#\s*user_allow_other/user_allow_other/' /etc/fuse.conf 2>/dev/null || true
  sed -i "\|[[:space:]]${MOUNT_DIR}[[:space:]]|d" /etc/fstab
  echo "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR} ${MOUNT_DIR} fuse.sshfs _netdev,reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,IdentityFile=${KEY},StrictHostKeyChecking=accept-new,allow_other 0 0" >> /etc/fstab
  systemctl daemon-reload
  mount "$MOUNT_DIR"
  FS="$(fs_type "$MOUNT_DIR")"
  if ! on_separate_mount "$MOUNT_DIR"; then
    echo "GAGAL: mount ke ${REMOTE_HOST}:${REMOTE_DIR} tidak berhasil (terbaca: ${FS:-?})."; exit 1
  fi
fi

# pastikan benar-benar bisa ditulis
if touch "$MOUNT_DIR/.tulis_tes" 2>/dev/null; then
  rm -f "$MOUNT_DIR/.tulis_tes"
  echo "    Folder IDM bisa ditulis."
else
  echo "GAGAL: folder ${MOUNT_DIR} tidak bisa ditulis."; exit 1
fi

# bersihkan mount lama (/mnt/idm) jika masih ada; file di 192.168.18.2 tidak disentuh
if [ "$OLD_MOUNT" != "$MOUNT_DIR" ]; then
  systemctl stop aria2 2>/dev/null || true
  if mountpoint -q "$OLD_MOUNT" 2>/dev/null; then
    umount "$OLD_MOUNT" 2>/dev/null || umount -l "$OLD_MOUNT" 2>/dev/null || true
  fi
  if grep -q "[[:space:]]${OLD_MOUNT}[[:space:]]" /etc/fstab 2>/dev/null; then
    sed -i "\|[[:space:]]${OLD_MOUNT}[[:space:]]|d" /etc/fstab
    systemctl daemon-reload
    echo "    Entri mount lama ${OLD_MOUNT} dihapus dari /etc/fstab."
  fi
  rmdir "$OLD_MOUNT" 2>/dev/null || true
fi

# ------------------------------------------------------------
echo "==> [3/6] Konfigurasi aria2"
mkdir -p /root/.aria2
CONF="/root/.aria2/aria2.conf"
SECRET=""
if [ -f "$CONF" ]; then
  SECRET="$(grep '^rpc-secret=' "$CONF" | head -n1 | cut -d= -f2-)"
fi
if [ -z "$SECRET" ]; then
  SECRET="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16)"
fi
cat > "$CONF" <<EOF
dir=${MOUNT_DIR}
continue=true
max-concurrent-downloads=3
max-connection-per-server=16
split=16
min-split-size=1M
file-allocation=none
disk-cache=16M
enable-rpc=true
rpc-listen-all=true
rpc-listen-port=${RPC_PORT}
rpc-allow-origin-all=true
rpc-secret=${SECRET}
input-file=/root/.aria2/aria2.session
save-session=/root/.aria2/aria2.session
save-session-interval=60
EOF
touch /root/.aria2/aria2.session

# ------------------------------------------------------------
echo "==> [4/6] Service aria2 (jalan otomatis, menunggu folder IDM siap)"
# aria2 baru mulai setelah folder IDM berada di disk/mount terpisah (USB atau jaringan),
# supaya unduhan tidak pernah jatuh ke disk sistem HG680P.
cat > /usr/local/bin/idm-wait <<'EOF'
#!/bin/bash
DEST="__DEST__"
for i in $(seq 1 60); do
  T="$(findmnt -n -o TARGET -T "$DEST" 2>/dev/null | head -n1)"
  if [ -n "$T" ] && [ "$T" != "/" ]; then exit 0; fi
  sleep 5
done
exit 1
EOF
sed -i "s|__DEST__|${MOUNT_DIR}|" /usr/local/bin/idm-wait
chmod +x /usr/local/bin/idm-wait

cat > /etc/systemd/system/aria2.service <<'EOF'
[Unit]
Description=aria2 downloader
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/idm-wait
ExecStart=/usr/bin/aria2c --conf-path=/root/.aria2/aria2.conf
Restart=always
RestartSec=5
TimeoutStartSec=400

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable aria2 >/dev/null 2>&1
systemctl restart aria2

# ------------------------------------------------------------
echo "==> [5/6] Web UI (AriaNg)"
WEB_OK=0
mkdir -p /opt/ariang
URL="$(curl -fsSL https://api.github.com/repos/mayswind/AriaNg/releases/latest \
  | grep -o 'https://[^"]*AllInOne[^"]*\.zip' | head -n1 || true)"
if [ -n "$URL" ] && curl -fsSL "$URL" -o /tmp/ariang.zip && unzip -oq /tmp/ariang.zip -d /opt/ariang; then
  rm -f /tmp/ariang.zip
  cat > /etc/systemd/system/ariang.service <<EOF
[Unit]
Description=AriaNg web UI
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m http.server ${WEB_PORT} --directory /opt/ariang
Restart=always

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable ariang >/dev/null 2>&1
  systemctl restart ariang
  WEB_OK=1
else
  echo "    Web UI gagal diunduh (aria2 tetap jalan, bisa dipakai lewat CLI)."
fi

# ------------------------------------------------------------
echo "==> [6/6] Downloader YouTube (yt-dlp: yt / ytmp3 / ytm4a)"
YT_OK=0
ARCH="$(uname -m)"
if [ "$ARCH" = "aarch64" ]; then YT_FILE="yt-dlp_linux_aarch64"; else YT_FILE="yt-dlp"; fi
if [ -x /usr/local/bin/yt-dlp ] || curl -fsSL "https://github.com/yt-dlp/yt-dlp/releases/latest/download/${YT_FILE}" -o /usr/local/bin/yt-dlp; then
  chmod +x /usr/local/bin/yt-dlp
  mkdir -p /var/tmp/yt /var/tmp/yt-logs

cat > /usr/local/bin/yt-run <<'EOF'
#!/bin/bash
# Pembantu untuk yt / ytmp3 / ytm4a.
# SEMUA unduhan WAJIB masuk ke folder IDM (tidak pernah ke disk sistem HG680P).
DEST="__DEST__"
MODE="$1"; shift

if [ -z "$1" ]; then
  echo "Pemakaian: yt | ytmp3 | ytm4a \"LINK_YOUTUBE\""
  exit 1
fi

on_separate_mount() {
  local t; t="$(findmnt -n -o TARGET -T "$1" 2>/dev/null | head -n1)"
  [ -n "$t" ] && [ "$t" != "/" ]
}
if ! on_separate_mount "$DEST"; then
  mount -a >/dev/null 2>&1               # coba pasang disk/mount dari fstab bila ada
fi
if [ ! -d "$DEST" ] || ! on_separate_mount "$DEST"; then
  echo "GAGAL: $DEST berada di DISK SISTEM HG680P (disk/folder IDM belum terpasang)."
  echo "Unduhan dibatalkan supaya disk sistem tidak penuh."
  echo "Cek: findmnt -T $DEST   |   Perbaiki: mount -a  atau  bash instalasi.sh"
  exit 1
fi
TESTF="$DEST/.tulis_tes_$$"
if ! touch "$TESTF" 2>/dev/null; then
  echo "GAGAL: folder $DEST tidak bisa ditulis."
  exit 1
fi
rm -f "$TESTF"

case "$MODE" in
  mp3) OPTS=(-x --audio-format mp3) ;;
  m4a) OPTS=(-f "bestaudio[ext=m4a]/bestaudio") ;;
  *)   OPTS=() ;;
esac

mkdir -p /var/tmp/yt /var/tmp/yt-logs
LOG="/var/tmp/yt-logs/$(date +%Y%m%d-%H%M%S).log"
setsid nohup /usr/local/bin/yt-dlp --newline "${OPTS[@]}" \
  -P "temp:/var/tmp/yt" -P "home:$DEST" \
  -o "%(title)s [%(id)s].%(ext)s" "$@" > "$LOG" 2>&1 < /dev/null &
ln -sf "$LOG" /var/tmp/yt-logs/latest.log
echo "Unduhan berjalan di latar belakang. Terminal boleh ditutup."
echo "Tujuan  : $DEST   [disk: $(findmnt -n -o SOURCE -T "$DEST" 2>/dev/null | head -n1)]"
echo "Progress: ytlog"
EOF
  sed -i "s|__DEST__|${MOUNT_DIR}|" /usr/local/bin/yt-run

cat > /usr/local/bin/yt <<'EOF'
#!/bin/bash
# Pemakaian: yt "LINK"   (video kualitas terbaik)
exec /usr/local/bin/yt-run video "$@"
EOF
cat > /usr/local/bin/ytmp3 <<'EOF'
#!/bin/bash
# Pemakaian: ytmp3 "LINK"   (audio, diconvert ke mp3)
exec /usr/local/bin/yt-run mp3 "$@"
EOF
cat > /usr/local/bin/ytm4a <<'EOF'
#!/bin/bash
# Pemakaian: ytm4a "LINK"   (audio asli m4a, tanpa convert)
exec /usr/local/bin/yt-run m4a "$@"
EOF
cat > /usr/local/bin/ytlog <<'EOF'
#!/bin/bash
# Lihat progress unduhan terakhir (Ctrl+C untuk keluar, unduhan tetap jalan)
tail -n 30 -f /var/tmp/yt-logs/latest.log
EOF
  chmod +x /usr/local/bin/yt-run /usr/local/bin/yt /usr/local/bin/ytmp3 /usr/local/bin/ytm4a /usr/local/bin/ytlog
  YT_OK=1
else
  echo "    yt-dlp gagal diunduh (bagian aria2 tetap berfungsi)."
fi

# Plugin FFmpeg untuk MOC (mocp) agar bisa memutar m4a, hanya jika mocp terpasang
if command -v mocp >/dev/null 2>&1; then
  echo "    mocp terdeteksi, memasang plugin FFmpeg untuk MOC..."
  if apt-get install -y moc-ffmpeg-plugin; then
    mocp -x >/dev/null 2>&1 || true
  else
    echo "    Plugin moc-ffmpeg-plugin gagal dipasang (abaikan; pakai ytmp3 untuk MOC)."
  fi
fi

# ------------------------------------------------------------
IP="$(hostname -I | awk '{print $1}')"
SECRET_B64="$(printf '%s' "$SECRET" | base64 | tr -d '=\n')"

echo
echo "=============================================="
echo " SELESAI"
echo "=============================================="
echo " Folder download : ${MOUNT_DIR}   [disk: $(fs_source "$MOUNT_DIR")]"
echo " RPC secret      : ${SECRET}"
if [ "$WEB_OK" -eq 1 ]; then
  echo " Web UI          : http://${IP}:${WEB_PORT}/#!/settings/rpc/set/ws/${IP}/${RPC_PORT}/jsonrpc/${SECRET_B64}"
  echo "                   (kalau tidak terisi otomatis: AriaNg Settings > RPC,"
  echo "                    host ${IP}, port ${RPC_PORT}, secret di atas)"
fi
echo " Via terminal    : aria2c -x 16 -s 16 -c -d ${MOUNT_DIR} \"LINK\""
echo " Cek status      : systemctl status aria2"
if [ "$YT_OK" -eq 1 ]; then
  echo " YouTube (video) : yt \"LINK_YOUTUBE\""
  echo " YouTube (m4a)   : ytm4a \"LINK_YOUTUBE\"   (tanpa convert, paling ringan)"
  echo " YouTube (mp3)   : ytmp3 \"LINK_YOUTUBE\""
  echo " Lihat progress  : ytlog   (unduhan jalan di latar belakang, terminal boleh ditutup)"
  echo " Update yt-dlp   : yt-dlp -U   (jalankan kalau YouTube mulai error)"
fi
echo "=============================================="
