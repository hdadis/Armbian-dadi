#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=== 0. Membersihkan instalasi lama secara total (Fresh Clean) ==="
# Hentikan proses PM2 jika sedang berjalan
pm2 delete n8n 2>/dev/null || true
pm2 kill 2>/dev/null || true

# Hapus folder NVM dan folder global n8n/pm2 sebelumnya
rm -rf /root/.nvm
rm -rf /root/.npm
rm -rf /root/.pm2
rm -rf /root/n8n

# Purge paket Node.js, npm, dan dependensi terkait dari sistem apt
apt-get purge -y nodejs npm nodejs-doc 2>/dev/null || true
apt-get autoremove -y
apt-get clean

echo "=== 1. Menginstal dependensi dasar sistem ==="
apt-get update
apt-get install -y curl build-essential python3 python3-pip software-properties-common git

echo "=== 2. Menginstal Node.js v22.x (LTS terbaru) via NodeSource ==="
# Tambahkan repository NodeSource resmi untuk Node.js v22
curl -fsSL https://deb.nodesource.com/setup_22.x | bash -

# Install Node.js dan npm secara global
apt-get install -y nodejs

# Verifikasi instalasi Node.js & npm
node -v
npm -v

echo "=== 3. Menginstal PM2 dan n8n v1.94.0 via npm ==="
# Konfigurasi npm agar lebih stabil saat mendownload paket
npm config set maxsockets 50

# Menggunakan npm install -g agar binary n8n & pm2 langsung masuk ke PATH sistem
npm install -g pm2 n8n@1.94.0 --unsafe-perm

# Verifikasi instalasi PM2
pm2 -v

echo "=== 4. Menyiapkan konfigurasi environment n8n ==="
mkdir -p /root/n8n/downloads
cd /root/n8n
curl -sSL https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/n8n-sql -o .env

echo "=== 5. Menginstal Cloudflared ==="
bash -c "$(curl -fsSL https://raw.githubusercontent.com/hdadis/Armbian-dadi/refs/heads/main/Cloudflared)"
cloudflared service install eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9

echo "=== 6. Menjalankan n8n dengan PM2 ==="
# Pindah ke direktori /root/n8n agar file .env otomatis ter-load oleh n8n
cd /root/n8n

# Jalankan n8n via PM2
N8N_BIN=$(which n8n)
pm2 start "$N8N_BIN" --name "n8n"

# Simpan konfigurasi PM2 agar bertahan saat reboot
pm2 save

# Autostart PM2 pada saat booting
pm2 startup systemd -u root --hp /root || true

echo "=== Instalasi Selesai ==="
pm2 status
