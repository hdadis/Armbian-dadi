#!/bin/bash

# Hentikan skrip jika ada error
set -e

echo "=== [1/5] Memperbarui sistem dan menginstal dependensi dasar ==="
apt update
apt install -y build-essential cmake pkg-config git libsqlite3-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev curl

echo "=== [2/5] Menginstal Node.js versi 24 dan npm ==="
if ! command -v node &> /dev/null; then
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt install -y nodejs
else
    echo "Node.js sudah terinstal. Melanjutkan..."
fi

echo "=== [3/5] Mengunduh repository LightNVR ==="
if [ -d "lightNVR" ]; then
    echo "Folder lightNVR sudah ada, memperbarui kode..."
    cd lightNVR
    git pull
    git submodule update --init --recursive
else
    git clone https://github.com/opensensor/lightNVR.git
    cd lightNVR
    git submodule update --init --recursive
fi

echo "=== [4/5] Melakukan proses Build (Backend C & Frontend) ==="
./scripts/build.sh --release

echo "=== [5/5] Menginstal layanan sistem (systemd) ==="
./scripts/install.sh

# Menyalakan dan mengaktifkan service
systemctl start lightnvr
systemctl enable lightnvr

echo "====================================================="
echo " Instalasi LightNVR Selesai!"
echo " Silakan akses dashboard melalui browser di alamat:"
echo " http://<IP_SERVER_ANDA>:8080"
echo " Login default -> Username: admin | Password: admin"
echo "====================================================="
