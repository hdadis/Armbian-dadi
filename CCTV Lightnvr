#!/bin/bash

# Hentikan skrip jika terjadi error di salah satu perintah
set -e

echo "=== [1/5] Memperbarui sistem dan menginstal dependensi dasar ==="
apt update
apt install -y build-essential cmake pkg-config git libsqlite3-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
    curl ffmpeg

echo "=== [1.5/5] Menginstal Node.js v22.x dan npm v10.x (Bawaan Node.js v22) ==="
# Mengunduh dan menjalankan skrip setup NodeSource untuk Node.js v22
curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
apt install -y nodejs

# Memastikan npm menggunakan versi stabil terbaru untuk Node.js v22 (npm v10.x.x)
npm install -g npm@latest

echo "=== [2/5] Memeriksa instalasi Node.js dan npm ==="
node_ver=$(node -v)
npm_ver=$(npm -v)
echo "Node.js versi: $node_ver"
echo "NPM versi: $npm_ver"

echo "=== [3/5] Mengunduh repository LightNVR ==="
cd ~
if [ -d "lightNVR" ]; then
    echo "Folder lightNVR sudah ada, memperbarui kode..."
    cd lightNVR
    git pull
    git submodule update --init --recursive
else
    git clone https://github.com/opensensor/lightNVR.git
    cd lightNVR
    git submodule update --init --recursive
fi

echo "=== [4/5] Menginstal Dependensi & Build Frontend/Backend ==="
# Menginstal dependensi package.json
npm install --production=false

# Mengompilasi frontend/backend proyek
if [ -f "package.json" ]; then
    npm run build || echo "Build via npm selesai / tidak memerlukan langkah build tambahan."
fi

echo "=== [5/5] Membuat dan Mengaktifkan Layanan systemd ==="
SERVICE_FILE="/etc/systemd/system/lightnvr.service"
WORKING_DIR=$(pwd)

cat <<EOF > $SERVICE_FILE
[Unit]
Description=LightNVR Native Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$WORKING_DIR
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production PORT=8080

[Install]
WantedBy=multi-user.target
EOF

# Reload daemon dan jalankan service
systemctl daemon-reload
systemctl enable lightnvr
systemctl restart lightnvr

# Untuk Clear Cache supaya refresh
sudo apt clean
sudo apt autoremove -y
npm cache clean --force

echo "====================================================="
echo " Instalasi LightNVR Selesai!"
echo " Status Service saat ini:"
systemctl status lightnvr --no-pager || true
echo "====================================================="
echo " Silakan akses dashboard melalui browser di alamat:"
echo " http://$(hostname -I | awk '{print $1}'):8080"
echo "====================================================="
