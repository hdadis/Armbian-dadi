#!/bin/bash

# Exit jika terjadi error
set -e

echo "=== Memulai Instalasi MOCP & ALSA Soundtouch Plugin ==="

# 1. Update repository dan install paket yang dibutuhkan
echo "[1/4] Menginstall paket dependencies..."
sudo apt update
sudo apt install -y moc alsa-utils libasound2-plugin-equal ladspa-sdk swh-plugins soundtouch

# 2. Buat konfigurasi ALSA (~/.asoundrc)
echo "[2/4] Membuat konfigurasi ALSA (~/.asoundrc)..."
cat << 'EOF' > ~/.asoundrc
pcm.pitch432 {
    type ladspa
    slave.pcm "plug:default"
    plugin "pitch_scale"
    label "pitchScale"
    input {
        controls [ 0.981818 ] # Rasio 432 / 440 Hz
    }
}

pcm.mocp432 {
    type plug
    slave.pcm "pitch432"
}
EOF

# 3. Buat folder dan konfigurasi MOCP (~/.moc/config)
echo "[3/4] Mengatur konfigurasi MOCP (~/.moc/config)..."
mkdir -p ~/.moc

cat << 'EOF' > ~/.moc/config
SoundDriver = ALSA
ALSADevice = mocp432
EOF

echo "[4/4] Selesai!"
echo "=== Instalasi & Konfigurasi Selesai ==="
echo "Untuk menjalankan MOCP, ketik perintah: mocp"
