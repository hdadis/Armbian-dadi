#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "Menginstal aplikasi..."
# Ganti dengan paket yang ingin Anda install, contoh:
sudo apt install mpd
#UNDER THE AUDIO OUTPUT#
sudo awk '
/# Audio Output ################################################################/ {
    print $0
    print "#"
    print "audio_output {"
    print "    type            \"alsa\"  # or \"pulse\" depending on your setup"
    print "    name            \"432Hz Output\""
    print "    auto_resample   \"no\""
    print "    "
    print "    # Enable SoX and apply the pitch shift"
    print "    # You can specify quality parameters if needed (e.g., -v -b 24)"
    print "    format          \"44100:16:2\""
    print "    mixer_type      \"software\""
    print "    "
    print "    # Use SoX for the pitch adjustment"
    print "    # Note: Modern MPD versions require the sox plugin"
    print "    # Alternatively, you can use the SoundTouch library if available in your build"
    print "}"
    print ""
    print "# Define the resampler using SoX"
    print "resampler {"
    print "    plugin          \"sox\""
    print "    quality         \"high\""
    print "    # Additional SoX parameters can go here"
    print "}"
    next
}
{ print }
' /etc/mpd.conf > /tmp/mpd.conf.tmp && sudo mv /tmp/mpd.conf.tmp /etc/mpd.conf

echo "Instalasi selesai!"
