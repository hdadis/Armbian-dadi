TARGET="$APP_DIR/cari_properti.py"
TULIS=1
if [ -f "$TARGET" ]; then
  JAWAB=""
  read -r -p "   cari_properti.py sudah ada (mungkin sudah Anda edit). Timpa dengan versi baru? [y/N]: " JAWAB || true
