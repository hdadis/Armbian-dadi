if [ "$TULIS" -eq 1 ]; then
cat > "$TARGET" <<'PY_EMBED_END'
"""
cari_properti.py - Kumpulkan iklan properti (Depok - Bogor) dan tandai yang
kemungkinan dijual langsung oleh pemilik.

Cara pakai:
  1. pip install requests beautifulsoup4 openpyxl
  2. Isi SOURCES di bawah (URL halaman hasil pencarian + CSS selector).
  3. python cari_properti.py
  Hasil: hasil_properti_TANGGAL_JAM.xlsx (hanya iklan BARU sejak run terakhir),
  disimpan lokal di OUTPUT_DIR dan/atau dikirim ke REMOTE_HOST lewat scp.

Catatan etika/legal:
  - Script ini mengecek robots.txt dan memberi jeda antar request.
  - Nomor telepon hanya diambil jika TAMPIL TERBUKA di halaman iklan
    (teks, tel:, wa.me) dan hanya untuk iklan "kemungkinan pemilik".
    Script TIDAK menembus tombol "tampilkan nomor", login, atau captcha.
    Pakai nomor hanya untuk menghubungi soal iklan itu (UU PDP).
  - Jika situs memblokir (403/captcha), jangan ditembus. Pakai cara manual.
"""
import json
import os
import re
import shlex
import subprocess
import time
from datetime import datetime
import random
import urllib.robotparser
from pathlib import Path
from urllib.parse import urljoin, urlparse

import requests
from bs4 import BeautifulSoup
from openpyxl import Workbook
from openpyxl.styles import Font

# ---------------------------------------------------------------------------
# 1. KONFIGURASI - EDIT BAGIAN INI
# ---------------------------------------------------------------------------
# Buka situs properti, set filter (lokasi Depok/Bogor, jenis, harga), lalu
# salin URL hasil pencariannya ke "urls". Selector CSS dicari lewat browser:
# klik kanan pada satu iklan -> Inspect -> lihat tag/class-nya.
SOURCES = [
    {
        "name": "ContohSitus",
        "urls": [
            "https://www.contoh-situs-properti.com/dijual/depok?page=1",
            "https://www.contoh-situs-properti.com/dijual/bogor?page=1",
        ],
        "item": "div.listing-card",     # pembungkus satu iklan
        "title": "h2",                    # judul
        "price": ".price",                # harga
        "location": ".location",          # lokasi
        "desc": ".description",           # deskripsi singkat (boleh kosong "")
        "link": "a",                      # elemen <a> menuju detail iklan
        "agent_badge": "",                # (opsional) selector lencana/logo agen di kartu iklan
        "contact_area": "",               # (opsional) selector kotak kontak di halaman detail
    },
]

AREA_KEYWORDS = [
    "depok", "margonda", "sawangan", "cinere", "limo", "cimanggis", "tapos",
    "sukmajaya", "pancoran mas", "beji", "cipayung", "bojongsari", "citayam",
    "bogor", "cibinong", "sentul", "bojonggede", "cilebut", "parung",
    "tajur", "baranangsiang", "gunung putri", "citeureup", "ciomas", "dramaga",
]

OWNER_HINTS = [
    "pemilik langsung", "dijual oleh pemilik", "owner", "tanpa perantara",
    "tanpa agen", "no agen", "langsung pemilik", "butuh uang", "bu cepat",
    "dijual cepat", "over kredit", "hak milik pribadi",
]
# Pola ciri agen / iklan yang dikelola pihak lain (regex, huruf kecil).
AGENT_HINTS = [
    r"\bagen(?:t)?\b", r"\bbroker\b", r"\bmakelar\b", r"\bcalo\b",
    r"\brealty\b", r"\breal estate\b", r"\bmarketing\b",
    r"\bkomisi\b", r"\bfee\b", r"\bco-?broke\b",
    r"\beksklusif\b", r"\bexclusive\b", r"\blisting by\b",
    r"\bdikelola\b", r"\bditawarkan oleh\b", r"\bmitra\b",
    r"\bdeveloper\b", r"\bpengembang\b",
    r"\bkonsultan properti\b", r"\bproperti group\b", r"\bproperty group\b",
    r"\bray white\b", r"\bcentury ?21\b", r"\bcoldwell\b", r"\blj hooker\b",
    r"\bera\s+(?:indonesia|properti|property)\b",
    r"\b(?:pt|cv)\.?\s+[a-z]",
]
# Frasa yang justru menandakan pemilik (dibuang dulu sebelum cek agen).
NEGASI_AGEN = re.compile(
    r"\b(?:tanpa|no|non|bukan|anti|tidak\s+(?:lewat|pakai|melalui))\s+"
    r"(?:agen|agent|broker|makelar|perantara|calo)\b"
    r"|\bagen(?:t)?\s+(?:dilarang|jangan|mohon\s+tidak|no)\b"
)

# --- FILTER ---
FILTER_KETAT = True   # True = iklan yang ada ciri agen TIDAK dimasukkan ke Excel
MINIMAL_SKOR = 0      # 0 = boleh "belum jelas" asal tanpa ciri agen
                      # 1 = wajib ada kata penanda pemilik ("pemilik langsung", dll)

AMBIL_TELEPON = True        # ambil nomor yang tampil terbuka di halaman detail
DELAY = (3.0, 6.0)          # jeda acak antar request (detik)
MAX_ITEMS_PER_PAGE = 100
# Tujuan file hasil. Dua mode:
#  a) Lokal : OUTPUT_DIR (default /mnt/External/Downloads/IDM di perangkat ini)
#  b) Kirim ke komputer lain lewat SSH/scp: isi REMOTE_HOST (+ REMOTE_USER,
#     REMOTE_DIR). File tetap disimpan juga di folder "hasil" lokal sebagai cadangan.
# Semua bisa diatur lewat variabel lingkungan (lihat setup_kirim.sh).
REMOTE_HOST = os.environ.get("REMOTE_HOST", "")            # contoh: 192.168.28.2
REMOTE_USER = os.environ.get("REMOTE_USER", "")
REMOTE_DIR = os.environ.get("REMOTE_DIR", "/mnt/External/Downloads/IDM")
SSH_KEY = os.environ.get("SSH_KEY", "")                    # kosong = kunci default
OUTPUT_DIR = os.environ.get("OUTPUT_DIR") or (
    str(Path(__file__).resolve().parent / "hasil") if REMOTE_HOST
    else "/mnt/External/Downloads/IDM"
)
SEEN_FILE = "seen.json"
PHONES_FILE = "phones.json"   # catatan nomor -> daftar iklan (deteksi agen)
BATAS_AGEN = 3                # nomor yang muncul di >= segini iklan dianggap agen
HEADERS = {
    "User-Agent": "Mozilla/5.0 (personal property research script)",
    "Accept-Language": "id-ID,id;q=0.9",
}

# ---------------------------------------------------------------------------
# 2. FUNGSI
# ---------------------------------------------------------------------------
_robots_cache = {}


def boleh_diakses(url):
    host = f"{urlparse(url).scheme}://{urlparse(url).netloc}"
    if host not in _robots_cache:
        rp = urllib.robotparser.RobotFileParser()
        rp.set_url(host + "/robots.txt")
        try:
            rp.read()
        except Exception:
            rp = None
        _robots_cache[host] = rp
    rp = _robots_cache[host]
    return True if rp is None else rp.can_fetch(HEADERS["User-Agent"], url)


def ambil_halaman(url):
    if not boleh_diakses(url):
        print(f"  [SKIP] robots.txt melarang: {url}")
        return None
    try:
        r = requests.get(url, headers=HEADERS, timeout=20)
    except requests.RequestException as e:
        print(f"  [ERROR] {url}: {e}")
        return None
    if r.status_code != 200:
        print(f"  [GAGAL] HTTP {r.status_code}: {url} (jangan ditembus, coba manual)")
        return None
    return r.text


def teks(node, selector):
    if not selector:
        return ""
    el = node.select_one(selector)
    return el.get_text(" ", strip=True) if el else ""


def ada_tanda_agen(teks_):
    """Kembalikan pola agen yang cocok ('' jika tidak ada)."""
    t = NEGASI_AGEN.sub(" ", (teks_ or "").lower())
    for pola in AGENT_HINTS:
        m = re.search(pola, t)
        if m:
            return m.group(0).strip()
    return ""


def skor_pemilik(judul, desc):
    t = f"{judul} {desc}".lower()
    return sum(2 for k in OWNER_HINTS if k in t)


def di_area(lokasi, judul, desc):
    t = f"{lokasi} {judul} {desc}".lower()
    return any(k in t for k in AREA_KEYWORDS)


HP_REGEX = re.compile(r"(?:\+?62|0)\s*8\d{1,2}[\s.\-]?\d{3,4}[\s.\-]?\d{2,5}")


def normalisasi_hp(raw):
    d = re.sub(r"\D", "", raw)
    if d.startswith("0"):
        d = "62" + d[1:]
    return d if d.startswith("628") and 11 <= len(d) <= 14 else ""


def cari_telepon(html, area=""):
    """Ambil nomor HP yang tampil terbuka. area = selector kotak kontak (opsional)."""
    soup = BeautifulSoup(html, "html.parser")
    root = soup.select_one(area) if area else None
    root = root or soup
    kandidat = []
    for a in root.find_all("a", href=True):
        h = a["href"]
        if h.startswith("tel:") or "wa.me/" in h or "api.whatsapp.com" in h:
            kandidat.append(h)
    kandidat.append(root.get_text(" ", strip=True))
    hasil = []
    for teks_ in kandidat:
        for m in HP_REGEX.findall(teks_) or re.findall(r"\d{9,14}", teks_):
            n = normalisasi_hp(m)
            if n and n not in hasil:
                hasil.append(n)
    return hasil[:3]


def tambah_telepon(item, src):
    html = ambil_halaman(item["link"])
    if not html:
        return
    area = src.get("contact_area", "")
    if area:
        el = BeautifulSoup(html, "html.parser").select_one(area)
        tanda = ada_tanda_agen(el.get_text(" ", strip=True)) if el else ""
        if tanda:
            item["tanda_agen"] = f"kotak kontak: {tanda}"
    nomor = cari_telepon(html, area)
    if nomor:
        item["telepon"] = ", ".join("+" + n for n in nomor)
        item["wa_link"] = f"https://wa.me/{nomor[0]}"


def parse(html, src, base_url):
    soup = BeautifulSoup(html, "html.parser")
    hasil = []
    for node in soup.select(src["item"])[:MAX_ITEMS_PER_PAGE]:
        judul = teks(node, src["title"])
        lokasi = teks(node, src["location"])
        desc = teks(node, src["desc"])
        a = node.select_one(src["link"])
        link = urljoin(base_url, a["href"]) if a and a.get("href") else ""
        if not link or not di_area(lokasi, judul, desc):
            continue
        skor = skor_pemilik(judul, desc)
        tanda = ada_tanda_agen(f"{judul} {desc}")
        if src.get("agent_badge") and node.select_one(src["agent_badge"]):
            tanda = tanda or "badge agen"
        hasil.append({
            "tanda_agen": tanda,
            "sumber": src["name"],
            "judul": judul,
            "harga": teks(node, src["price"]),
            "lokasi": lokasi,
            "skor_pemilik": skor,
            "telepon": "",
            "wa_link": "",
            "jml_iklan_nomor": "",
            "indikasi": "Kemungkinan agen" if tanda
                        else ("Kemungkinan pemilik" if skor > 0 else "Belum jelas"),
            "link": link,
        })
    return hasil


def muat_seen():
    if Path(SEEN_FILE).exists():
        return set(json.loads(Path(SEEN_FILE).read_text()))
    return set()


def muat_phones():
    if Path(PHONES_FILE).exists():
        return json.loads(Path(PHONES_FILE).read_text())
    return {}


def tandai_nomor_berulang(item, phones):
    """Catat nomor; nomor yang sama di banyak iklan = ciri khas agen/broker."""
    if not item["telepon"]:
        item["jml_iklan_nomor"] = ""
        return
    nomor = item["telepon"].split(",")[0].strip().lstrip("+")
    daftar = phones.setdefault(nomor, [])
    if item["link"] not in daftar:
        daftar.append(item["link"])
    item["jml_iklan_nomor"] = len(daftar)
    if len(daftar) >= BATAS_AGEN:
        item["indikasi"] = "Kemungkinan agen (nomor berulang)"
        item["tanda_agen"] = f"nomor muncul di {len(daftar)} iklan"


def kirim_remote(path):
    """Kirim file ke REMOTE_HOST:REMOTE_DIR lewat scp. Mengembalikan True jika sukses."""
    if not REMOTE_HOST:
        return False
    tujuan = f"{REMOTE_USER}@{REMOTE_HOST}" if REMOTE_USER else REMOTE_HOST
    opsi = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
            "-o", "StrictHostKeyChecking=accept-new"]
    if SSH_KEY:
        opsi += ["-i", SSH_KEY]
    try:
        subprocess.run(["ssh", *opsi, tujuan, f"mkdir -p {shlex.quote(REMOTE_DIR)}"],
                       check=True, capture_output=True, timeout=60)
        subprocess.run(["scp", *opsi, str(path), f"{tujuan}:{REMOTE_DIR}/"],
                       check=True, capture_output=True, timeout=120)
        print(f"  Terkirim ke {tujuan}:{REMOTE_DIR}/")
        return True
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError) as e:
        err = getattr(e, "stderr", b"") or b""
        print(f"  [GAGAL KIRIM] {e.__class__.__name__}: {err.decode(errors='ignore').strip()[:200]}")
        print(f"  File tetap aman di {path}. Cek SSH dengan: ssh {tujuan}")
        return False


def simpan_excel(rows):
    try:
        Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)
        folder = Path(OUTPUT_DIR)
    except OSError as e:
        print(f"  [PERINGATAN] folder {OUTPUT_DIR} tidak bisa dipakai ({e}); simpan di folder script")
        folder = Path(".")
    output = folder / f"hasil_properti_{datetime.now():%Y%m%d_%H%M}.xlsx"
    wb = Workbook()
    ws = wb.active
    ws.title = "Iklan baru"
    kolom = ["sumber", "judul", "harga", "lokasi", "indikasi",
             "telepon", "wa_link", "jml_iklan_nomor", "skor_pemilik", "link", "status_kontak", "catatan"]
    ws.append([k.upper() for k in kolom])
    for c in ws[1]:
        c.font = Font(bold=True)
    for r in sorted(rows, key=lambda x: -x["skor_pemilik"]):
        ws.append([r.get(k, "") for k in kolom])
    for col, w in zip("ABCDEFGHIJKL", [14, 50, 18, 24, 20, 22, 34, 14, 12, 60, 16, 30]):
        ws.column_dimensions[col].width = w
    wb.save(output)
    return output


def alasan_buang(item):
    if FILTER_KETAT and item["tanda_agen"]:
        return item["tanda_agen"]
    if item["skor_pemilik"] < MINIMAL_SKOR:
        return "tanpa penanda pemilik"
    return ""


def main():
    seen = muat_seen()
    phones = muat_phones()
    baru, dibuang = [], 0
    for src in SOURCES:
        print(f"== {src['name']}")
        for url in src["urls"]:
            print(f"  ambil {url}")
            html = ambil_halaman(url)
            if html:
                for item in parse(html, src, url):
                    if item["link"] in seen:
                        continue
                    seen.add(item["link"])
                    alasan = alasan_buang(item)
                    if not alasan and AMBIL_TELEPON:
                        tambah_telepon(item, src)
                        tandai_nomor_berulang(item, phones)
                        time.sleep(random.uniform(*DELAY))
                        alasan = alasan_buang(item)
                    if alasan:
                        dibuang += 1
                        print(f"    [DIBUANG: {alasan}] {item['judul'][:60]}")
                    else:
                        baru.append(item)
            time.sleep(random.uniform(*DELAY))
    Path(SEEN_FILE).write_text(json.dumps(sorted(seen)))
    Path(PHONES_FILE).write_text(json.dumps(phones, indent=1))
    if baru:
        output = simpan_excel(baru)
        kirim_remote(output)
        print(f"\nSelesai: {len(baru)} iklan lolos filter, {dibuang} dibuang -> {output}")
    else:
        print(f"\nTidak ada iklan lolos filter ({dibuang} dibuang). "
              "Jika semua 0, cek selector di SOURCES.")


if __name__ == "__main__":
    main()
PY_EMBED_END
fi

