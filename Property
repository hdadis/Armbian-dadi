#!/usr/bin/env bash
# install.sh - Pemasang pencari properti Armbian terintegrasi Samba CIFS
# Target simpan langsung: //192.168.18.2/External/Downloads/IDM via /mnt/IDM_Storage

set -euo pipefail

APP_DIR="${APP_DIR:-$HOME/cari-properti}"
LOCAL_MOUNT="/mnt/IDM_Storage"
SERVER_IP="192.168.18.2"
SHARE_NAME="External"
SUB_PATH="Downloads/IDM"
CRED_FILE="/etc/samba/credentials_share"
SAMBA_USER="dadi"
SAMBA_PASS="dadi"

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

echo "==> [1/6] Update paket & pasang dependensi (Python, cifs-utils, cron)"
$SUDO apt-get update -y
$SUDO apt-get install -y python3 python3-venv python3-pip ca-certificates cron cifs-utils

echo "==> [2/6] Setup Storage Jaringan Samba (192.168.18.2)"
$SUDO mkdir -p /etc/samba
$SUDO bash -c "cat <<EOF > '${CRED_FILE}'
username=${SAMBA_USER}
password=${SAMBA_PASS}
EOF"
$SUDO chmod 600 "${CRED_FILE}"
$SUDO mkdir -p "${LOCAL_MOUNT}"

# Konfigurasi /etc/fstab untuk automount permanen
REMOTE_TARGET="//${SERVER_IP}/${SHARE_NAME}/${SUB_PATH}"
MOUNT_OPTS="credentials=${CRED_FILE},iocharset=utf8,uid=$(id -u),gid=$(id -g),file_mode=0777,dir_mode=0777,_netdev,nofail,vers=3.0"
FSTAB_LINE="${REMOTE_TARGET} ${LOCAL_MOUNT} cifs ${MOUNT_OPTS} 0 0"

$SUDO sed -i "\|${LOCAL_MOUNT}|d" /etc/fstab
echo "${FSTAB_LINE}" | $SUDO tee -a /etc/fstab > /dev/null

$SUDO systemctl daemon-reload
$SUDO mount "${LOCAL_MOUNT}" || $SUDO mount -a || true

if mountpoint -q "${LOCAL_MOUNT}"; then
    echo "    OK: Storage Samba terpasang di ${LOCAL_MOUNT}"
else
    echo "    PERINGATAN: Mount gagal. Cek koneksi ke ${SERVER_IP}."
fi

echo "==> [3/6] Tulis script pencari ke $APP_DIR"
mkdir -p "$APP_DIR"
TARGET="$APP_DIR/cari_properti.py"
TULIS=1
if [ -f "$TARGET" ]; then
  JAWAB=""
  read -r -p "    cari_properti.py sudah ada. Timpa dengan versi baru? [y/N]: " JAWAB || true
  if [[ "$JAWAB" =~ ^[Yy]$ ]]; then
    cp "$TARGET" "$TARGET.bak.$(date +%Y%m%d%H%M)"
    echo "    Versi lama dicadangkan."
  else
    TULIS=0
    echo "    Dipertahankan (tidak ditimpa)."
  fi
fi

if [ "$TULIS" -eq 1 ]; then
cat > "$TARGET" <<'PY_EMBED_END'
"""
cari_properti.py - Kumpulkan iklan properti (Depok - Bogor) dan tandai yang
kemungkinan dijual langsung oleh pemilik.
"""
import json
import os
import re
import time
from datetime import datetime
import random
import urllib.robotparser
from pathlib import Path
from urllib.parse import parse_qsl, urlencode, urljoin, urlparse, urlunparse

import requests
from bs4 import BeautifulSoup
from openpyxl import Workbook
from openpyxl.styles import Font

# ---------------------------------------------------------------------------
# 1. KONFIGURASI
# ---------------------------------------------------------------------------
SOURCES = [
    {
        "name": "ContohSitus",
        "urls": [
            "https://www.contoh-situs-properti.com/dijual/rumah/depok",
            "https://www.contoh-situs-properti.com/dijual/rumah/bogor",
        ],
        "max_pages": 10,
    },
]

AREA_KEYWORDS = [
    "depok", "margonda", "sawangan", "cinere", "limo", "cimanggis", "tapos",
    "sukmajaya", "pancoran mas", "beji", "cipayung", "bojongsari", "citayam",
    "bogor", "cibinong", "sentul", "bojonggede", "cilebut", "parung",
    "tajur", "baranangsiang", "gunung putri", "citeureup", "ciomas", "dramaga",
]

OWNER_HINTS = [
    "pemilik langsung", "dijual oleh pemilik", "owner", "tanpa perantara",
    "tanpa agen", "no agen", "langsung pemilik", "butuh uang", "bu cepat",
    "dijual cepat", "over kredit", "hak milik pribadi",
]

AGENT_HINTS = [
    r"\bagen(?:t)?\b", r"\bbroker\b", r"\bmakelar\b", r"\bcalo\b",
    r"\brealty\b", r"\breal estate\b", r"\bmarketing\b",
    r"\bkomisi\b", r"\bfee\b", r"\bco-?broke\b",
    r"\beksklusif\b", r"\bexclusive\b", r"\blisting by\b",
    r"\bdikelola\b", r"\bditawarkan oleh\b", r"\bmitra\b",
    r"\bdeveloper\b", r"\bpengembang\b",
    r"\bkonsultan properti\b", r"\bproperti group\b", r"\bproperty group\b",
    r"\bray white\b", r"\bcentury ?21\b", r"\bcoldwell\b", r"\blj hooker\b",
    r"\bera\s+(?:indonesia|properti|property)\b",
    r"\b(?:pt|cv)\.?\s+[a-z]",
]

NEGASI_AGEN = re.compile(
    r"\b(?:tanpa|no|non|bukan|anti|tidak\s+(?:lewat|pakai|melalui))\s+"
    r"(?:agen|agent|broker|makelar|perantara|calo)\b"
    r"|\bagen(?:t)?\s+(?:dilarang|jangan|mohon\s+tidak|no)\b"
)

FILTER_KETAT = True
MINIMAL_SKOR = 0
AMBIL_TELEPON = True
DELAY = (3.0, 6.0)
MAX_ITEMS_PER_PAGE = 100
OUTPUT_DIR = os.environ.get("OUTPUT_DIR", "/mnt/IDM_Storage")
SEEN_FILE = "seen.json"
PHONES_FILE = "phones.json"
BATAS_AGEN = 3
HEADERS = {
    "User-Agent": "Mozilla/5.0 (personal property research script)",
    "Accept-Language": "id-ID,id;q=0.9",
}

# ---------------------------------------------------------------------------
# 2. FUNGSI
# ---------------------------------------------------------------------------
_robots_cache = {}

def boleh_diakses(url):
    host = f"{urlparse(url).scheme}://{urlparse(url).netloc}"
    if host not in _robots_cache:
        rp = urllib.robotparser.RobotFileParser()
        rp.set_url(host + "/robots.txt")
        try:
            rp.read()
        except Exception:
            rp = None
        _robots_cache[host] = rp
    rp = _robots_cache[host]
    return True if rp is None else rp.can_fetch(HEADERS["User-Agent"], url)

def ambil_halaman(url):
    if not boleh_diakses(url):
        print(f"  [SKIP] robots.txt melarang: {url}")
        return None
    try:
        r = requests.get(url, headers=HEADERS, timeout=20)
    except requests.RequestException as e:
        print(f"  [ERROR] {url}: {e}")
        return None
    if r.status_code != 200:
        print(f"  [GAGAL] HTTP {r.status_code}: {url}")
        return None
    return r.text

def teks(node, selector):
    if not selector:
        return ""
    el = node.select_one(selector)
    return el.get_text(" ", strip=True) if el else ""

def ada_tanda_agen(teks_):
    t = NEGASI_AGEN.sub(" ", (teks_ or "").lower())
    for pola in AGENT_HINTS:
        m = re.search(pola, t)
        if m:
            return m.group(0).strip()
    return ""

def skor_pemilik(judul, desc):
    t = f"{judul} {desc}".lower()
    return sum(2 for k in OWNER_HINTS if k in t)

def di_area(lokasi, judul, desc):
    t = f"{lokasi} {judul} {desc}".lower()
    return any(k in t for k in AREA_KEYWORDS)

HP_REGEX = re.compile(r"(?:\+?62|0)\s*8\d{1,2}[\s.\-]?\d{3,4}[\s.\-]?\d{2,5}")

def normalisasi_hp(raw):
    d = re.sub(r"\D", "", raw)
    if d.startswith("0"):
        d = "62" + d[1:]
    return d if d.startswith("628") and 11 <= len(d) <= 14 else ""

def cari_telepon(html, area=""):
    soup = BeautifulSoup(html, "html.parser")
    root = soup.select_one(area) if area else None
    root = root or soup
    kandidat = []
    for a in root.find_all("a", href=True):
        h = a["href"]
        if h.startswith("tel:") or "wa.me/" in h or "api.whatsapp.com" in h:
            kandidat.append(h)
    kandidat.append(root.get_text(" ", strip=True))
    hasil = []
    for teks_ in kandidat:
        for m in HP_REGEX.findall(teks_) or re.findall(r"\d{9,14}", teks_):
            n = normalisasi_hp(m)
            if n and n not in hasil:
                hasil.append(n)
    return hasil[:3]

def tambah_telepon(item, src):
    html = ambil_halaman(item["link"])
    if not html:
        return
    area = src.get("contact_area", "")
    if area:
        el = BeautifulSoup(html, "html.parser").select_one(area)
        tanda = ada_tanda_agen(el.get_text(" ", strip=True)) if el else ""
        if tanda:
            item["tanda_agen"] = f"kotak kontak: {tanda}"
    nomor = cari_telepon(html, area)
    if nomor:
        item["telepon"] = ", ".join("+" + n for n in nomor)
        item["wa_link"] = f"https://wa.me/{nomor[0]}"

HARGA_RE = re.compile(r"rp\.?\s?\d[\d.,]*\s?(?:juta|jt|miliar|milyar|m|rb|ribu)?\b", re.I)

def _teks(el):
    return el.get_text(" ", strip=True)

def _link_kartu(node, base_url):
    kand = [node] if node.name == "a" and node.get("href") else []
    kand += node.find_all("a", href=True)
    for a in kand:
        h = a["href"].strip()
        if h and not h.startswith(("#", "javascript:", "tel:", "mailto:")) \
                and "wa.me" not in h and "whatsapp" not in h:
            return urljoin(base_url, h)
    return ""

def auto_kartu(soup, base_url):
    kandidat = [t for t in soup.find_all(True)
                if t.name not in ("script", "style", "head", "html", "body")
                and len(_teks(t)) <= 40 and HARGA_RE.search(_teks(t))]
    ids = {id(t) for t in kandidat}
    inti = [t for t in kandidat if not any(id(d) in ids for d in t.find_all(True))]
    if len(inti) < 3:
        return []
    inti_ids = {id(t) for t in inti}

    def jml(el):
        return sum(1 for d in el.find_all(True) if id(d) in inti_ids) + (id(el) in inti_ids)

    hasil, dipakai = [], set()
    for p in inti:
        cur = p
        while cur.parent is not None and cur.parent.name not in ("body", "html", "[document]") \
                and jml(cur.parent) == 1:
            cur = cur.parent
        if id(cur) in dipakai or len(_teks(cur)) > 2500:
            continue
        dipakai.add(id(cur))
        link = _link_kartu(cur, base_url)
        if not link:
            continue
        judul = ""
        h = cur.find(["h1", "h2", "h3", "h4", "h5"])
        if h:
            judul = _teks(h)
        if not judul:
            anchors = sorted((_teks(a) for a in cur.find_all("a")), key=len, reverse=True)
            judul = anchors[0] if anchors and anchors[0] else _teks(cur)[:80]
        lokasi = ""
        for d in cur.find_all(True):
            tt = _teks(d)
            if len(tt) <= 80 and any(k in tt.lower() for k in AREA_KEYWORDS):
                lokasi = tt
                break
        hasil.append({"judul": judul, "harga": _teks(p), "lokasi": lokasi,
                      "desc": _teks(cur)[:600], "link": link, "node": cur})
    return hasil

def ambil_kartu(soup, src, base_url):
    mode = src.get("item", "auto")
    if mode in ("", "auto"):
        return auto_kartu(soup, base_url)
    hasil = []
    for node in soup.select(mode)[:MAX_ITEMS_PER_PAGE]:
        a = node.select_one(src.get("link", "a"))
        hasil.append({
            "judul": teks(node, src.get("title", "")),
            "harga": teks(node, src.get("price", "")),
            "lokasi": teks(node, src.get("location", "")),
            "desc": teks(node, src.get("desc", "")),
            "link": urljoin(base_url, a["href"]) if a and a.get("href") else "",
            "node": node,
        })
    return hasil

def halaman_berikut(url, html, src):
    soup = BeautifulSoup(html, "html.parser")
    sel = src.get("next", "")
    if sel:
        el = soup.select_one(sel)
        return urljoin(url, el["href"]) if el and el.get("href") else ""
    el = soup.select_one('a[rel~="next"], link[rel~="next"]')
    if el and el.get("href"):
        return urljoin(url, el["href"])
    for a in soup.find_all("a", href=True):
        if _teks(a).lower() in ("next", "berikutnya", "selanjutnya", "next »",
                                "selanjutnya »", "›", "»", ">"):
            return urljoin(url, a["href"])
    pu = urlparse(url)
    m = re.search(r"/(page|halaman|p)/(\d+)", pu.path)
    if m:
        path = pu.path[:m.start(2)] + str(int(m.group(2)) + 1) + pu.path[m.end(2):]
        return urlunparse(pu._replace(path=path))
    q = dict(parse_qsl(pu.query))
    param = src.get("page_param") or next(
        (k for k in ("page", "halaman", "p", "pg", "paged") if k in q), "page")
    q[param] = str(int(q[param]) + 1) if q.get(param, "").isdigit() else "2"
    return urlunparse(pu._replace(query=urlencode(q)))

def iterasi_halaman(start, src):
    url, dikunjungi = start, set()
    for n in range(1, int(src.get("max_pages", 10)) + 1):
        if not url or url in dikunjungi:
            break
        dikunjungi.add(url)
        print(f"  halaman {n}: {url}")
        html = ambil_halaman(url)
        if not html:
            break
        yield url, html
        url = halaman_berikut(url, html, src)
        time.sleep(random.uniform(*DELAY))

def parse(html, src, base_url):
    soup = BeautifulSoup(html, "html.parser")
    hasil, semua = [], set()
    for k in ambil_kartu(soup, src, base_url):
        if not k["link"]:
            continue
        semua.add(k["link"])
        judul, lokasi, desc = k["judul"], k["lokasi"], k["desc"]
        if not di_area(lokasi, judul, desc):
            continue
        skor = skor_pemilik(judul, desc)
        tanda = ada_tanda_agen(f"{judul} {desc}")
        if src.get("agent_badge") and k["node"].select_one(src["agent_badge"]):
            tanda = tanda or "badge agen"
        hasil.append({
            "tanda_agen": tanda,
            "sumber": src["name"],
            "judul": judul,
            "harga": k["harga"],
            "lokasi": lokasi,
            "skor_pemilik": skor,
            "telepon": "",
            "wa_link": "",
            "jml_iklan_nomor": "",
            "indikasi": "Kemungkinan agen" if tanda
                        else ("Kemungkinan pemilik" if skor > 0 else "Belum jelas"),
            "link": k["link"],
        })
    return hasil, semua

def muat_seen():
    if Path(SEEN_FILE).exists():
        return set(json.loads(Path(SEEN_FILE).read_text()))
    return set()

def muat_phones():
    if Path(PHONES_FILE).exists():
        return json.loads(Path(PHONES_FILE).read_text())
    return {}

def tandai_nomor_berulang(item, phones):
    if not item["telepon"]:
        item["jml_iklan_nomor"] = ""
        return
    nomor = item["telepon"].split(",")[0].strip().lstrip("+")
    daftar = phones.setdefault(nomor, [])
    if item["link"] not in daftar:
        daftar.append(item["link"])
    item["jml_iklan_nomor"] = len(daftar)
    if len(daftar) >= BATAS_AGEN:
        item["indikasi"] = "Kemungkinan agen (nomor berulang)"
        item["tanda_agen"] = f"nomor muncul di {len(daftar)} iklan"

def simpan_excel(rows):
    try:
        Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)
        folder = Path(OUTPUT_DIR)
    except OSError as e:
        print(f"  [PERINGATAN] folder {OUTPUT_DIR} tidak bisa dipakai ({e}); simpan di lokal script")
        folder = Path(".")
    output = folder / f"hasil_properti_{datetime.now():%Y%m%d_%H%M}.xlsx"
    wb = Workbook()
    ws = wb.active
    ws.title = "Iklan baru"
    kolom = ["sumber", "judul", "harga", "lokasi", "indikasi",
             "telepon", "wa_link", "jml_iklan_nomor", "skor_pemilik", "link", "status_kontak", "catatan"]
    ws.append([k.upper() for k in kolom])
    for c in ws[1]:
        c.font = Font(bold=True)
    for r in sorted(rows, key=lambda x: -x["skor_pemilik"]):
        ws.append([r.get(k, "") for k in kolom])
    for col, w in zip("ABCDEFGHIJKL", [14, 50, 18, 24, 20, 22, 34, 14, 12, 60, 16, 30]):
        ws.column_dimensions[col].width = w
    wb.save(output)
    return output

def alasan_buang(item):
    if FILTER_KETAT and item["tanda_agen"]:
        return item["tanda_agen"]
    if item["skor_pemilik"] < MINIMAL_SKOR:
        return "tanpa penanda pemilik"
    return ""

def main():
    seen = muat_seen()
    phones = muat_phones()
    baru, dibuang = [], 0
    for src in SOURCES:
        print(f"== {src['name']}")
        for start in src["urls"]:
            sebelumnya = None
            for page_url, html in iterasi_halaman(start, src):
                items, semua = parse(html, src, page_url)
                if not semua:
                    print("    (tidak ada iklan terbaca di halaman ini, berhenti)")
                    break
                if semua == sebelumnya:
                    print("    (isi sama dengan halaman sebelumnya, berhenti)")
                    break
                sebelumnya = semua
                for item in items:
                    if item["link"] in seen:
                        continue
                    seen.add(item["link"])
                    alasan = alasan_buang(item)
                    if not alasan and AMBIL_TELEPON:
                        tambah_telepon(item, src)
                        tandai_nomor_berulang(item, phones)
                        time.sleep(random.uniform(*DELAY))
                        alasan = alasan_buang(item)
                    if alasan:
                        dibuang += 1
                        print(f"    [DIBUANG: {alasan}] {item['judul'][:60]}")
                    else:
                        baru.append(item)
    Path(SEEN_FILE).write_text(json.dumps(sorted(seen)))
    Path(PHONES_FILE).write_text(json.dumps(phones, indent=1))
    if baru:
        output = simpan_excel(baru)
        print(f"\nSelesai: {len(baru)} iklan lolos filter, {dibuang} dibuang -> {output}")
    else:
        print(f"\nTidak ada iklan lolos filter ({dibuang} dibuang).")

if __name__ == "__main__":
    main()
PY_EMBED_END
fi

