#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

echo "=== 1. Menginstal dependensi dasar sistem & PostgreSQL ==="
sudo apt-get update
sudo apt-get install -y curl build-essential python3 python3-pip software-properties-common postgresql postgresql-contrib

echo "=== 2. Membuat Database & User PostgreSQL secara Otomatis ==="
# Konfigurasi Nama DB, User, dan Password otomatis
DB_NAME="n8n"
DB_USER="dadi"
DB_PASS="980Abc" # Anda bisa mengganti password ini jika diperlukan

# Eksekusi pembuatan database di Postgres
sudo -u postgres psql -c "CREATE DATABASE $DB_NAME;"
sudo -u postgres psql -c "CREATE USER $DB_USER WITH ENCRYPTED PASSWORD '$DB_PASS';"
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER;"
# Izin khusus schema public untuk n8n versi baru
sudo -u postgres psql -d $DB_NAME -c "ALTER SCHEMA public OWNER TO $DB_USER;"

echo "=== 3. Menginstal Node.js v20 (LTS) ==="
curl -fsSL https://nodesource.com | bash -
sudo apt-get install -y nodejs

# Verifikasi instalasi Node.js
node -v
npm -v

echo "=== 4. Menginstal PM2 dan n8n v1.94.0 via npm ==="
sudo npm config set maxsockets 50
sudo npm install -g pm2 n8n@1.94.0 --unsafe-perm

echo "=== 5. Membuat File Environment (.env) Secara Mandiri ==="
mkdir -p /root/n8n/downloads
cd /root/n8n

# Membuat file .env baru dan memasukkan semua konfigurasi Anda secara langsung
cat << EOF > .env
# ==========================================
# KONFIGURASI BAWAAN ANDA
# ==========================================
GENERIC_TIMEZONE=Asia/Jakarta
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DOWNLOADS_DIRECTORY=/root/n8n/downloads
N8N_HOST=0.0.0.0
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PORT=5678
WEBHOOK_URL=https://ai.balai.my.id/
N8N_SECURE_COOKIE=false

# ==========================================
# KONFIGURASI DATABASE INTERNAL (POSTGRESQL)
# ==========================================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=127.0.0.1
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=$DB_NAME
DB_POSTGRESDB_USER=$DB_USER
DB_POSTGRESDB_PASSWORD=$DB_PASS
EOF

echo "=== 6. Menginstal Cloudflared ==="
bash -c "$(curl -fsSL https://githubusercontent.com)"
cloudflared service install eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9

echo "=== 7. Menjalankan n8n dengan PM2 ==="
pm2 delete n8n 2>/dev/null || true
cd /root/n8n

N8N_BIN=$(which n8n)
pm2 start "$N8N_BIN" --name "n8n"
pm2 save
pm2 startup systemd -u root --hp /root || true

echo "=== Instalasi Selesai ==="
pm2 status
