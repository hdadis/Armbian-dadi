echo "=== [3/7] Membuat Script Auto-Update 19 List (Skor Tinggi ~95-97%) ==="
cat << 'EOF' > /opt/AdGuardHome/update-blocklists.sh
#!/bin/bash
export LC_ALL=C
OUT="/opt/AdGuardHome/data/gabungan_stabil.txt"
TMP_RAW="/tmp/raw_lists.txt"
TMP_CLEAN="/tmp/clean_lists.txt"
rm -f "$TMP_RAW" "$TMP_CLEAN"

for id in 24 1 59 48 27 39 6 45 67 47 66 61 65 63 60 7 22 52; do
  curl -sSL --retry 2 --connect-timeout 15 --max-time 60 "https://adguardteam.github.io/HostlistsRegistry/assets/filter_${id}.txt" >> "$TMP_RAW"
  echo "" >> "$TMP_RAW"
done
curl -sSL --retry 2 --connect-timeout 15 --max-time 60 "https://raw.githubusercontent.com/hdadis/adblock-mix/refs/heads/main/ABP%20Compiled%201.txt" >> "$TMP_RAW"

if [ -s "$TMP_RAW" ] && [ "$(wc -l < "$TMP_RAW")" -gt 10000 ]; then
  # Membuang komentar, baris kosong, dan mengabaikan aturan @@ (allowlist liar) dari list luar
  grep -vE '^[[:space:]]*(!|#|\$|@@)' "$TMP_RAW" \vert{} tr -d '\r' \vert{} nice -n 19 sort -S 50M -u > "$TMP_CLEAN"
  rm -f "$TMP_RAW"

  # Menyuntikkan Whitelist resmi Microsoft, Xbox, & Push Notification yang diizinkan lolos
  for dom in account.microsoft.com login.live.com login.microsoftonline.com acctcdn.msauth.net acctcdn.msftauth.net logincdn.msauth.net aadcdn.msauth.net aadcdn.msftauth.net amcdn.msftauth.net graph.microsoft.com profile.microsoft.com account.live.com signup.live.com sfx.ms onedrive.live.com storage.live.com clientconfig.passport.net device.auth.xboxlive.com user.auth.xboxlive.com xsts.auth.xboxlive.com mtalk.google.com fcm.googleapis.com; do
    echo "@@||${dom}^\$important" >> "$TMP_CLEAN"
  done

  mv -f "$TMP_CLEAN" "$OUT"
  chmod 644 "$OUT"

  sleep 5
  if systemctl is-active --quiet AdGuardHome; then
    systemctl restart AdGuardHome
  fi
else
  rm -f "$TMP_RAW" "$TMP_CLEAN"
fi
EOF
