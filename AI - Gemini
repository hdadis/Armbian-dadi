cat << 'EOF' > analisis_excel.py
import os
import sys
import re
import ast
import glob
import time
import shutil
import tempfile
import subprocess
from google import genai
from google.genai import types
from google.genai.errors import APIError

# Daftar 6 API Key Gemini (akan berputar dari 1 -> 6 -> balik ke 1 jika limit)
DAFTAR_API_KEYS = [
    os.environ.get("GEMINI_KEY_1", "Hayook di isi"),
    os.environ.get("GEMINI_KEY_2", "Hayook di isi"),
