]

# Filter key yang belum diisi agar tidak memicu error invalid key
DAFTAR_API_KEYS = [k for k in DAFTAR_API_KEYS if k and not k.startswith("MASUKKAN_KEY_")]

if not DAFTAR_API_KEYS:
    print("\n[!] ERROR: Tidak ada API Key Gemini yang valid!")
    sys.exit(1)

TARGET_DIR = "/mnt/External/Downloads/IDM"
NAMA_MODEL = "gemini-3.7-flash"

class GeminiRotator:
    def __init__(self, api_keys: list[str]):
        self.api_keys = api_keys
        self.total_keys = len(api_keys)
        self.indeks_aktif = 0

    @property
    def key_aktif(self) -> str:
        return self.api_keys[self.indeks_aktif]

    def geser_ke_key_berikutnya(self):
        self.indeks_aktif = (self.indeks_aktif + 1) % self.total_keys
        print(f"[*] Rotasi: Berpindah ke API Key urutan ke-{self.indeks_aktif + 1}")

    def generate_content(
        self,
        prompt: str,
        config: types.GenerateContentConfig | None = None,
        maks_siklus: int = 5,
        jeda_siklus: int = 10,
    ) -> str:
        total_percobaan = self.total_keys * maks_siklus
        percobaan_dalam_siklus = 0

        for _ in range(total_percobaan):
            key = self.key_aktif
            print(f"[*] Mengirim permintaan menggunakan Key urutan ke-{self.indeks_aktif + 1}...")

            try:
                client = genai.Client(api_key=key)
                response = client.models.generate_content(
                    model=NAMA_MODEL,
                    contents=prompt,
                    config=config,
                )
                print(f"[âœ“] Berhasil direspons menggunakan Key urutan ke-{self.indeks_aktif + 1}!")
                return response.text or ""

            except Exception as e:
                err_str = str(e)
                err_upper = err_str.upper()

                # Coba fallback ke Vertex AI jika API key bertipe service/vertex
                if "API_KEY_INVALID" in err_upper or "400" in err_upper:
                    try:
                        client = genai.Client(vertexai=True, api_key=key)
                        response = client.models.generate_content(
                            model=NAMA_MODEL, contents=prompt, config=config
                        )
                        print(f"[âœ“] Berhasil direspons menggunakan Key urutan ke-{self.indeks_aktif + 1} (Vertex)!")
                        return response.text or ""
                    except Exception as e2:
                        err_str = str(e2)
                        err_upper = err_str.upper()

                # Cek apakah limit/kuota habis (429, RESOURCE_EXHAUSTED, 503 UNAVAILABLE)
                is_quota_or_busy = any(
                    x in err_upper for x in ["429", "RESOURCE_EXHAUSTED", "QUOTA", "503", "UNAVAILABLE"]
                )

                if is_quota_or_busy:
                    print(f"[!] Limit/Padat pada Key urutan ke-{self.indeks_aktif + 1}: {err_str[:90]}...")
                    self.geser_ke_key_berikutnya()
                    percobaan_dalam_siklus += 1

                    # Jika seluruh daftar key sudah dicoba penuh dalam satu siklus
                    if percobaan_dalam_siklus >= self.total_keys:
                        print(f"[!] Seluruh ({self.total_keys}) API Key sedang limit/penuh. Menunggu {jeda_siklus} detik sebelum siklus ulang...")
                        time.sleep(jeda_siklus)
                        percobaan_dalam_siklus = 0
                else:
                    print(f"[!] Kendala non-kuota pada Key ke-{self.indeks_aktif + 1}: {err_str[:120]}")
                    raise e

        raise RuntimeError(f"Gagal memproses permintaan setelah {maks_siklus} putaran rotasi penuh.")

print("=" * 70)
print("       GEMINI ADVANCED FP&A EXCEL BUILDER (KEY ROTATION)")
print("=" * 70)
print(f"[*] Jumlah API Key aktif: {len(DAFTAR_API_KEYS)}")
print("Paste soal/kasus Anda, lalu ketik X di baris baru dan tekan ENTER:")
print("-" * 70)

baris_soal = []
while True:
    try:
        baris = input()
    except EOFError:
        break
    if baris.strip().upper() == "X":
        break
    baris_soal.append(baris)

soal_user = "\n".join(baris_soal).strip()
if not soal_user:
    print("\n[!] Soal kosong. Batal.")
    sys.exit(1)

nama_output = "laporan.xlsx"
print(f"\n[*] Target file output: {nama_output}")

PROMPT_SISTEM = f"""You are a Manager Finance Analyst (FP&A, Accounting, Corporate Finance) and an expert Python/`openpyxl` developer.

# TASK & OUTPUT FORMAT
Read the business case study below and answer it fully inside an Excel workbook. If a completed written analysis is also provided, use it as the strict source of truth: all Excel numbers, logic, and structures must match the written analysis exactly.

Write all Excel labels, headers, and commentary in the **same language as the case study**.

Return your response as **ONLY the Python Script** enclosed inside `<excel_script>` tags:
<excel_script>
raw Python code (no markdown fences), openpyxl + standard library only, that builds the dynamic Excel model and ends with wb.save("__OUT__")
</excel_script>
Do NOT output any Markdown report, explanations, or text outside the `<excel_script>` tags.

---

# 1. STRUCTURE
- **Follow the case study literally. If it specifies the sheets (number, names, order), tables, columns or questions, build exactly that.
- **Answer EVERY question and sub-question in the order asked. Use the question numbering in the section titles.
- **Never add sheets that were not asked for.
- **If the case does not specify a layout, use 2 sheets:
  * "Analysis": a dashboard-style review with the sections below.
  * "Summary": key figures linked to Analysis, checks, conclusion, recommendation and action items. Name it in the language of the case.

---

# 2. EXCEL CONTENT & FINANCIAL MODELING STANDARDS
- **Dedicated Input Cells**: Place all raw numbers given in the case at the top of the sheet in their own cells with **light yellow fill (`FFF2CC`) and bold blue font (`0000FF`)**. Add a short italic grey note beside every assumption added or input requiring validation.
- **100% Live Formulas**: Every calculated result MUST be a live Excel formula referencing input/calculation cells. **Never compute results in Python and paste static values.** Always wrap sheet names containing spaces or `&` in single quotes (e.g., `'Summary & Closure'!B2`).
- **Formula Compatibility**: Use only universally supported Excel functions: `IF`, `IFERROR`, `AND`, `OR`, `SUM`, `SUMIF`, `SUMIFS`, `SUMPRODUCT`, `COUNTIF`, `INDEX`, `MATCH`, `MAX`, `MIN`, `AVERAGE`, `ROUND`, `TEXT`, `NPV`, `IRR`, `PMT`. **Strictly forbidden**: `XLOOKUP`, `FILTER`, `SORT`, `UNIQUE`, `LET`, or dynamic array formulas.
- **Transparent Formula Logic**: Show the formula logic either directly inside the column header (e.g., `"Total Expected Cost (=C+D)"`) or in an adjacent `"Formula / Logic"` column explaining the calculation in plain words.
- **Dynamic Conditional Allocations & Statuses**:
  * Allocate specific unbudgeted requests dynamically using `IF` formulas comparing the row's category name to the input category cell.
  * Build automated **Status Columns** using nested `IF` formulas (e.g., returning `"OVERRUN - already invoiced"`, `"POTENTIAL OVERRUN (commitment)"`, `"UNDER BUDGET"`, or `"AT BUDGET - fully consumed"` based on actual vs. budget and expected vs. budget).
- **Reconciliation & Audit Checks**: Under every main table, add a check row in small italic text comparing calculated totals against source figures stated in the case using an `IF` formula that returns `"TIES TO SOURCE âœ“"` or `"CHECK ERROR"`.
- **Live Formula-Driven Narratives**: In summary sections, sentences containing numbers must be built as live string-concatenated formulas so they update automatically, e.g., `="Total cost rises to "&TEXT(Analysis!C28,"#,##0")&", resulting in a margin gap."`
- **Deep Analytical Commentary ("The So What")**: Include a wrapped-text commentary/clarification column per row or metric providing case-specific insights: what the number means, key risks, what must be verified before closure, largest and highest-percentage drivers, scenario comparisons, sensitivities, and comparisons against targets/thresholds. State clear decisions and conditions.

---

# 3. VISUAL STYLING & FORMATTING SPECIFICATIONS
- **Typography**: `Calibri` size 11 for body; Title in bold size 14-16 dark navy (`1F3864`); Subtitle in italic grey (`595959`).
- **Section Bands**: Full-width light blue-lavender fill (`D9E1F2`) with bold navy (`1F3864`) text.
- **Table Headers**: Dark navy fill (`1F3864`), white bold centered text, `wrap_text=True`, tall row height.
- **Total Rows**: Grey fill (`E7E6E6` or `D9D9D9`), bold font, `SUM` formulas, and overall status formula (e.g., `"TOTAL PROJECT OVER BUDGET"`).
- **Number Formatting**:
  * Amounts/Currency: `#,##0;(#,##0);"-"`
  * Percentages: `0.0%;(0.0%);"-"`
- **Grid & Layout Polish**: Thin light-grey borders on all table cells; hide worksheet gridlines (`ws.views.sheetView[0].showGridLines = False`); freeze panes below the main table header; auto-adjust column widths and row heights so all wrapped text is 100% visible without truncation; merge long narrative cells across the table width.

---

# 4. PYTHON CODE EFFICIENCY RULES
- Keep the Python script compact and token-efficient.
- Define small helper functions for cell styling, borders, number formats, and row writing; use loops for populating tables.
- **No comments, no docstrings, no `print()` statements.**
- Never truncate the code. The script must be 100% complete and executable out of the box, ending with `wb.save("__OUT__")`.
"""

def parse_output(teks_respon):
    skrip_kode = ""
    if "<excel_script>" in teks_respon:
        sisa = teks_respon.split("<excel_script>", 1)[1]
        if "</excel_script>" in sisa:
            skrip_kode = sisa.split("</excel_script>", 1)[0].strip()
        else:
            skrip_kode = sisa.strip()

    if not skrip_kode:
        blok = re.findall(r"```(?:python|py)?[ \t]*\r?\n(.*?)```", teks_respon, re.DOTALL)
        if blok:
            skrip_kode = max(blok, key=len).strip()
        else:
            skrip_kode = teks_respon.strip()

    skrip_kode = re.sub(r"^```(?:python|py)?\s*", "", skrip_kode)
    skrip_kode = re.sub(r"\s*```$", "", skrip_kode)
    return skrip_kode.strip()

try:
    print("\n[*] Memulai proses perakitan prompt dan permintaan ke Gemini...")
    rotator = GeminiRotator(DAFTAR_API_KEYS)
    
    cfg = types.GenerateContentConfig(
        system_instruction=PROMPT_SISTEM,
        max_output_tokens=32000,
        temperature=0.2,
    )

    teks_mentah = rotator.generate_content(prompt=soal_user, config=cfg)
    skrip_python = parse_output(teks_mentah)

    if not skrip_python:
        print("\n[!] Gagal mengekstrak <excel_script> dari respons AI.")
        print("Respons mentah:\n", teks_mentah[:800])
        sys.exit(1)

    with open("_temp_builder.py", "w", encoding="utf-8") as f_temp:
        f_temp.write(skrip_python)

    with tempfile.TemporaryDirectory() as tmp:
        kandidat_tmp = os.path.join(tmp, nama_output)

        skrip_final = skrip_python.replace('"__OUT__"', f'r"{kandidat_tmp}"').replace("'__OUT__'", f'r"{kandidat_tmp}"')
        skrip_final = skrip_final.replace(f'"{nama_output}"', f'r"{kandidat_tmp}"').replace(f"'{nama_output}'", f'r"{kandidat_tmp}"')

        if not re.search(r"\.save\(", skrip_final):
            skrip_final += f'\nwb.save(r"{kandidat_tmp}")\n'

        script_path = os.path.join(tmp, "builder.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(skrip_final)

        print("[*] Menjalankan engine openpyxl untuk menyusun spreadsheet...")
        hasil = subprocess.run(
            [sys.executable, script_path],
            capture_output=True, text=True, timeout=180, cwd=tmp
        )

        if not os.path.exists(kandidat_tmp):
            err = (hasil.stderr or hasil.stdout or "File output tidak terbentuk.").strip()
            print("\n[!] Script perakit Excel gagal. Error:\n" + err[-1500:])
            sys.exit(1)

        os.makedirs(TARGET_DIR, exist_ok=True)

        jalan_tujuan = os.path.join(TARGET_DIR, nama_output)
        if os.path.exists(jalan_tujuan):
            dasar, ext = os.path.splitext(nama_output)
            i = 1
            while os.path.exists(os.path.join(TARGET_DIR, f"{dasar}_{i}{ext}")):
                i += 1
            jalan_tujuan = os.path.join(TARGET_DIR, f"{dasar}_{i}{ext}")

        shutil.move(kandidat_tmp, jalan_tujuan)

    print(f"\n[âœ“] SELESAI! File Excel tersimpan di: {os.path.abspath(jalan_tujuan)}")
    sys.exit(0)

except (APIError, RuntimeError) as e:
    print(f"\n[!] Error: {e}")
    sys.exit(1)
except subprocess.TimeoutExpired:
    print("\n[!] Timeout saat menjalankan perakit Excel.")
    sys.exit(1)

EOF

