#!/bin/bash

echo "========================================================"
echo "   SETUP LINGKUNGAN: GEMINI FP&A EXCEL & REPORT BUILDER"
echo "========================================================"

# 1. Update dan instal dependensi sistem yang dibutuhkan
echo "[*] Memperbarui sistem dan menginstal dependensi dasar..."
apt-get update && apt-get upgrade -y
apt-get install -y python3-pip python3-venv libreoffice git curl

# 2. Membuat Virtual Environment Python
ENV_NAME="gemini_env"
if [ ! -d "$ENV_NAME" ]; then
    echo "[*] Membuat virtual environment: $ENV_NAME..."
    python3 -m venv $ENV_NAME
else
    echo "[i] Virtual environment $ENV_NAME sudah ada."
fi

# 3. Mengaktifkan environment dan menginstal library Python
echo "[*] Menginstal library Python (google-genai, openpyxl)..."
source $ENV_NAME/bin/activate
pip install --upgrade pip
pip install google-genai openpyxl python-docx

# 4. Membuat file analisis_excel.py secara otomatis (Tanpa perubahan kode)
echo "[*] Menulis file analisis_excel.py..."
cat << 'EOF' > analisis_excel.py
import os
import sys
import re
import ast
import glob
import shutil
import tempfile
import subprocess
from google import genai
from google.genai import types
from google.genai.errors import APIError

# Konfigurasi API Key (Dapat disesuaikan menggunakan Environment Variable)
API_KEY = os.environ.get("GEMINI_API_KEY", "xxxxxxxxxxxxxxx")
if not API_KEY:
    print("\n[!] ERROR: GEMINI_API_KEY belum diatur!")
    sys.exit(1)

MODEL = os.environ.get("EXCEL_MODEL", "gemini-3.6-flash")

print("=" * 70)
print("   GEMINI ADVANCED FP&A BUILDER & REPORT GENERATOR")
print("=" * 70)
print("Paste soal/kasus Anda, lalu ketik X di baris baru dan tekan ENTER:")
print("-" * 70)

baris_soal = []
while True:
    try:
        baris = input()
    except EOFError:
        break
    if baris.strip().upper() == "X":
        break
    baris_soal.append(baris)

soal_user = "\n".join(baris_soal).strip()
if not soal_user:
    print("\n[!] Soal kosong. Batal.")
    sys.exit(1)

# Nama file output diatur otomatis
nama_output = "laporan.xlsx"
print(f"\n[*] Target file output: {nama_output}")

# Prompt Sistem Profesional FP&A Excel & Markdown
PROMPT_SISTEM = f"""You are a senior finance analyst (FP&A, accounting, corporate finance) and an expert Python/openpyxl developer. Read the case study and answer it fully. Return exactly two parts, in this order, and nothing outside the tags:
<excel_script>raw Python code (no markdown fences), openpyxl + standard library only, that saves "__OUT__" in the current directory</excel_script>
<laporan>detailed written analysis in Markdown</laporan>

LANGUAGE: write all Excel labels and the report in the same language as the case study.
STRUCTURE: follow the case study literally. If it specifies the sheets (number, names, order), tables, columns or questions, build exactly that and answer EVERY question and sub-question in the order asked, using the question numbering in the section titles. Never add sheets that were not asked for. If the case does not specify the layout, use 2 sheets: "Analysis" (inputs, calculations, answers per question) and "Summary" (key figures linked to Analysis, checks, conclusion, recommendation, action items).

EXCEL CONTENT (detailed, analytical, but compact):
- Inputs at the top: every number given in the case in its own cell (yellow fill FFF2CC, bold blue font 0000FF). Add a short italic grey note for every assumption you add.
- Every result is a live formula that references input cells. Never compute in Python and paste values. Quote sheet names with spaces or & in formulas, e.g. 'Summary & Closure'!B2.
- Every table: header row fill 1F3864 with white bold wrapped text; show the formula logic in the header or in an adjacent "Formula / Logic" column; TOTAL row fill E7E6E6 bold; IF-formula status columns; a check cell (formula) that reconciles totals to the figures stated in the case.
- Add a wrapped-text commentary column per row or per metric with case-specific analysis: what the number means, the risk, what must be verified, largest and smallest items. Include scenario comparison, sensitivity, key risk metrics, thresholds or targets wherever relevant to the case.
- The summary sheet or section must contain: key figures linked by formula, financial impact, a clear conclusion, a recommendation and numbered action items. Sentences that contain numbers must be formulas such as ="Cost rises to "&TEXT(Analysis!C28,"#,##0"), so they stay live.
- Interpret every result (the "so what"): compare with targets, quantify the impact, state the decision and the conditions.
- Format: Calibri 11; title bold 16 navy 1F3864; italic grey 595959 subtitle; section bands fill D9E1F2 with bold navy text; amounts #,##0;(#,##0);"-" ; percentages 0.0%;(0.0%);"-" ; thin light-grey borders; gridlines hidden; freeze panes below the main header; set column widths and row heights so wrapped text is fully visible; merge long text cells across the table width.
- Use only widely supported functions: IF, IFERROR, AND, OR, SUM, SUMIF, SUMIFS, SUMPRODUCT, COUNTIF, INDEX, MATCH, MAX, MIN, AVERAGE, ROUND, TEXT, NPV, IRR, PMT. Never use XLOOKUP, FILTER, SORT, UNIQUE, LET or dynamic arrays.

CODE EFFICIENCY (saves tokens): keep the script compact. Define small helper functions for styling and for writing rows, and use loops. No comments, no docstrings, no prints. The script must be complete (never truncated) and end with wb.save("__OUT__").

REPORT (inside <laporan>): Markdown with headings in the language of the case. Detailed but do not copy every Excel cell. Sections: executive summary (key numbers and verdict); assumptions; answer to each question with formulas and figures step by step (tables allowed); analysis, interpretation and risks; conclusion, recommendation and actions. Every number must equal what the Excel formulas produce.
"""

def minta_respons(prompt_teks, sys_inst=None):
    cfg = types.GenerateContentConfig(
        system_instruction=sys_inst,
        max_output_tokens=32000,
        temperature=0.2,
    )
    try:
        client = genai.Client(api_key=API_KEY)
        resp = client.models.generate_content(model=MODEL, contents=prompt_teks, config=cfg)
    except Exception as e1:
        if "API_KEY_INVALID" in str(e1) or "400" in str(e1):
            client = genai.Client(vertexai=True, api_key=API_KEY)
            resp = client.models.generate_content(model=MODEL, contents=prompt_teks, config=cfg)
        else:
            raise e1
    return resp.text or ""

def parse_output(teks_respon):
    if "<excel_script>" in teks_respon:
        sisa = teks_respon.split("<excel_script>", 1)[1]
        if "</excel_script>" in sisa:
            skrip_kode = sisa.split("</excel_script>", 1)[0].strip()
            laporan_sisa = sisa.split("</excel_script>", 1)[1]
        else:
            if "<laporan>" in sisa:
                skrip_kode = sisa.split("<laporan>", 1)[0].strip()
                laporan_sisa = "<laporan>" + sisa.split("<laporan>", 1)[1]
            else:
                skrip_kode = sisa.strip()
                laporan_sisa = ""
    else:
        skrip_kode = ""
        laporan_sisa = teks_respon

    laporan_teks = ""
    if "<laporan>" in laporan_sisa:
        laporan_bagian = laporan_sisa.split("<laporan>", 1)[1]
        if "</laporan>" in laporan_bagian:
            laporan_teks = laporan_bagian.split("</laporan>", 1)[0].strip()
        else:
            laporan_teks = laporan_bagian.strip()

    if not skrip_kode:
        blok = re.findall(r"```(?:python|py)?[ \t]*\r?\n(.*?)```", teks_respon, re.DOTALL)
        if blok:
            skrip_kode = max(blok, key=len)
            
    return skrip_kode, laporan_teks

try:
    print(f"\n[*] Memanggil {MODEL} untuk analisis FP&A...")
    teks_mentah = minta_respons(soal_user, sys_inst=PROMPT_SISTEM)
    
    skrip_python, laporan_markdown = parse_output(teks_mentah)
    
    if not skrip_python:
        print("\n[!] Gagal mengekstrak <excel_script> dari respons AI.")
        print("Respons mentah:\n", teks_mentah[:800])
        sys.exit(1)

    with tempfile.TemporaryDirectory() as tmp:
        kandidat_tmp = os.path.join(tmp, nama_output)
        
        skrip_final = skrip_python.replace('"__OUT__"', f'r"{kandidat_tmp}"').replace("'__OUT__'", f'r"{kandidat_tmp}"')
        
        if not re.search(r"\.save\(", skrip_final):
            skrip_final += f'\nwb.save(r"{kandidat_tmp}")\n'

        script_path = os.path.join(tmp, "builder.py")
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(skrip_final)

        print("[*] Menjalankan script openpyxl untuk merakit spreadsheet...")
        hasil = subprocess.run(
            [sys.executable, script_path],
            capture_output=True, text=True, timeout=180, cwd=tmp
        )

        if not os.path.exists(kandidat_tmp):
            err = (hasil.stderr or hasil.stdout or "File output tidak terbentuk.").strip()
            print("\n[!] Script Python gagal. Error:\n" + err[-1500:])
            sys.exit(1)

        os.makedirs("Hasil_Excel", exist_ok=True)
        
        jalan_tujuan = os.path.join("Hasil_Excel", nama_output)
        if os.path.exists(jalan_tujuan):
            dasar, ext = os.path.splitext(nama_output)
            i = 1
            while os.path.exists(os.path.join("Hasil_Excel", f"{dasar}_{i}{ext}")):
                i += 1
            jalan_tujuan = os.path.join("Hasil_Excel", f"{dasar}_{i}{ext}")

        shutil.move(kandidat_tmp, jalan_tujuan)

    print(f"\n[✓] BERHASIL! File Excel tersimpan di: {os.path.abspath(jalan_tujuan)}")
    
    if laporan_markdown:
        print("\n" + "="*70)
        print("   LAPORAN ANALISIS FP&A (DARI TAG <laporan>)")
        print("="*70)
        print(laporan_markdown)
        print("="*70)
        
        nama_lap = os.path.splitext(os.path.basename(jalan_tujuan))[0] + "_Report.md"
        jalan_lap = os.path.join("Hasil_Excel", nama_lap)
        with open(jalan_lap, "w", encoding="utf-8") as lf:
            lf.write(laporan_markdown)
        print(f"[i] Laporan Markdown juga disimpan di: {os.path.abspath(jalan_lap)}")

    sys.exit(0)

except APIError as e:
    print(f"\n[!] Error API Gemini: {e}")
    sys.exit(1)
except subprocess.TimeoutExpired:
    print("\n[!] Timeout saat menjalankan perakit Excel.")
    sys.exit(1)
EOF

chmod +x analisis_excel.py

echo "========================================================"
echo " [✓] SETUP & PEMBUATAN FILE SELESAI!"
echo " File analisis_excel.py telah berhasil dibuat."
echo " Cara menjalankan:"
echo " 1. source $ENV_NAME/bin/activate"
echo " 2. python3 analisis_excel.py"
echo "========================================================"
