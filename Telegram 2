# 1. Update paket & install dependencies pendukung
sudo apt install python3 python3-pip python3-venv arp-scan -y

# 2. Buat folder direktori kerja di /root
sudo mkdir -p /root/armbian-bot && cd /root/armbian-bot

# 3. Buat Virtual Environment & Install pustaka Python
sudo python3 -m venv /root/armbian-bot/venv
sudo /root/armbian-bot/venv/bin/pip install pyTelegramBotAPI requests psutil

# 4. Buat file bot.py lengkap
sudo wget -O /root/armbian-bot/bot.py https://raw.githubusercontent.com/hdadis/Script/refs/heads/main/Telegram%202

# 5. Buat file armbianbot.service lengkap
sudo bash -c 'cat << "EOF" > /etc/systemd/system/armbianbot.service
[Unit]
Description=Armbian Telegram Bot Monitor
After=network.target

[Service]
User=root
WorkingDirectory=/root/armbian-bot
ExecStart=/root/armbian-bot/venv/bin/python3 /root/armbian-bot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

EOF'


# 6. Reload daemon, aktifkan, dan jalankan service
sudo systemctl daemon-reload
sudo systemctl enable armbianbot.service
sudo systemctl restart armbianbot.service
sudo systemctl status armbianbot.service
/root/armbian-bot/venv/bin/python3 /root/armbian-bot/bot.py
