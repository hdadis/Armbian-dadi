#!/bin/bash

if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root atau dengan sudo"
  exit 1
fi

echo "1. Membersihkan layanan audio berat (PipeWire, PulseAudio, GStreamer)..."
systemctl --user --now unmask pulseaudio.service pulseaudio.socket 2>/dev/null || true
apt-get purge -y pipewire* pulseaudio* wireplumber libspa-0.2-* gstreamer1.0-libav gstreamer1.0-plugins-ugly* 2>/dev/null || true
apt-get autoremove -y
apt-get autoclean

echo "2. Menginstal MOC, plugin codec, dan ALSA murni..."
# apt-get update
apt-get install -y moc moc-ffmpeg-plugin alsa-utils

# Fungsi untuk membuat konfigurasi MOC di direktori target
buat_config_moc() {
  local TARGET_USER=$1
  local TARGET_HOME=$2
  local MOC_DIR="$TARGET_HOME/.moc"

  mkdir -p "$MOC_DIR"
  cat <<EOF > "$MOC_DIR/config"
SoundDriver = ALSA
AlsaDevice = default
SavePlaylist = yes
Softmixer_SaveState = yes
EOF
  chown -R "$TARGET_USER":"$TARGET_USER" "$MOC_DIR"
  chmod 600 "$MOC_DIR/config"
}

echo "3. Mengatur konfigurasi MOC untuk mode ROOT (/root/.moc)..."
buat_config_moc "root" "/root"
usermod -aG audio root

# Jika dijalankan via sudo oleh user biasa, buatkan juga untuk user tersebut
if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  echo "4. Mengatur konfigurasi MOC untuk user ($SUDO_USER)..."
  buat_config_moc "$SUDO_USER" "$USER_HOME"
  usermod -aG audio "$SUDO_USER"
fi

echo "5. Menyalakan server MOC..."
mocp -x 2>/dev/null || true
mocp -S

echo "========================================================"
echo "Selesai! MOC kini bisa dijalankan langsung di mode root maupun user biasa."
