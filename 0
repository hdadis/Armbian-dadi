#!/usr/bin/env bash
set -euo pipefail

SERVER_IP="192.168.18.2"
LOCAL_MOUNT="/mnt/IDM_Storage"
CRED_FILE="/etc/samba/credentials_share"

if [[ $EUID -ne 0 ]]; then
   echo "[ERROR] Skrip ini harus dijalankan sebagai root (gunakan sudo)." >&2
   exit 1
fi

echo "[1/5] Menginstal cifs-utils dan smbclient..."
apt-get update -y
apt-get install -y cifs-utils smbclient

echo ""
echo "=== Kredensial Samba Server (${SERVER_IP}) ==="
read -rp "Username Samba (kosongkan jika Guest/tanpa password): " SAMBA_USER
SAMBA_PASS=""
if [[ -n "${SAMBA_USER}" ]]; then
    read -rsp "Password Samba untuk '${SAMBA_USER}': " SAMBA_PASS
    echo ""
fi

mkdir -p /etc/samba
if [[ -n "${SAMBA_USER}" ]]; then
    cat <<EOF > "${CRED_FILE}"
username=${SAMBA_USER}
password=${SAMBA_PASS}
EOF
    chmod 600 "${CRED_FILE}"
    MOUNT_AUTH="credentials=${CRED_FILE}"
    SMB_AUTH="-U ${SAMBA_USER}%${SAMBA_PASS}"
else
    MOUNT_AUTH="guest"
    SMB_AUTH="-N"
fi

echo ""
echo "[2/5] Memeriksa daftar share aktif di ${SERVER_IP}..."
# Menampilkan share yang tersedia untuk memudahkan pemilihan
smbclient -L "//${SERVER_IP}" ${SMB_AUTH} -g 2>/dev/null | grep -i "Disk|" | cut -d'|' -f2 || true

echo ""
read -rp "Masukkan nama share di server (contoh: External, Downloads, atau IDM): " SHARE_NAME
SHARE_NAME="$(echo "${SHARE_NAME}" | sed 's|^/||;s|/$||')"

# Cek apakah share mencakup subfolder
read -rp "Apakah butuh subfolder di dalam share tersebut? (Ketik subfoldernya, contoh 'Downloads/IDM', atau tekan Enter jika langsung share folder IDM): " SUB_PATH
SUB_PATH="$(echo "${SUB_PATH}" | sed 's|^/||;s|/$||')"

if [[ -n "${SUB_PATH}" ]]; then
    FULL_REMOTE="//${SERVER_IP}/${SHARE_NAME}/${SUB_PATH}"
else
    FULL_REMOTE="//${SERVER_IP}/${SHARE_NAME}"
fi

echo "[3/5] Menyiapkan direktori local mount di ${LOCAL_MOUNT}..."
mkdir -p "${LOCAL_MOUNT}"

echo "[4/5] Mengonfigurasi /etc/fstab..."
# Parameter:
# _netdev,nofail: memastikan OS tidak crash saat boot jika server sedang mati/jaringan belum aktif
# uid=1000,gid=1000,file_mode=0777,dir_mode=0777: hak akses penuh untuk pengguna biasa di Armbian
MOUNT_OPTS="${MOUNT_AUTH},iocharset=utf8,uid=1000,gid=1000,file_mode=0777,dir_mode=0777,_netdev,nofail,vers=3.0"
FSTAB_LINE="${FULL_REMOTE} ${LOCAL_MOUNT} cifs ${MOUNT_OPTS} 0 0"

# Bersihkan konfigurasi lama jika pernah didaftarkan
sed -i "\|${LOCAL_MOUNT}|d" /etc/fstab
echo "${FSTAB_LINE}" >> /etc/fstab

echo "[5/5] Memuat daemon dan mengeksekusi mounting..."
systemctl daemon-reload
mount -a

if mountpoint -q "${LOCAL_MOUNT}"; then
    echo ""
    echo "=== Berhasil! Penyimpanan terpasang di ${LOCAL_MOUNT} ==="
    df -h "${LOCAL_MOUNT}"

    # Verifikasi izin tulis
    TEST_FILE="${LOCAL_MOUNT}/.test_write_perm"
    if touch "${TEST_FILE}" 2>/dev/null; then
        rm -f "${TEST_FILE}"
        echo "Status Izin Tulis: OK (Bisa membaca dan menulis file)."
    else
        echo "[PERINGATAN] Folder ter-mount, namun izin tulis ditolak. Periksa opsi 'writeable = yes' pada konfigurasi Samba di server."
    fi
else
    echo "[ERROR] Mount gagal ke ${FULL_REMOTE}. Periksa kembali nama share dan kredensialnya." >&2
    exit 1
fi
