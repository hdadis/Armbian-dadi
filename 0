#!/bin/bash

# Pastikan dijalankan dengan sudo
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini dengan sudo: sudo ./setup_moc_alsa.sh"
  exit 1
fi

# Deteksi user asli agar konfigurasi tidak salah masuk ke akun root
REAL_USER=${SUDO_USER:-$USER}
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

echo "1. Membersihkan layanan audio berat (PipeWire, PulseAudio, GStreamer)..."
systemctl --user --now unmask pulseaudio.service pulseaudio.socket 2>/dev/null || true
apt-get purge -y pipewire* pulseaudio* wireplumber libspa-0.2-* gstreamer1.0-libav gstreamer1.0-plugins-ugly* 2>/dev/null || true
apt-get autoremove -y
apt-get autoclean

echo "2. Menginstal MOC, plugin codec, dan ALSA murni..."
apt-get update
apt-get install -y moc moc-ffmpeg-plugin alsa-utils

echo "3. Menambahkan user ($REAL_USER) ke grup audio..."
usermod -aG audio "$REAL_USER"

echo "4. Mengatur konfigurasi MOC (ALSA + Softmixer)..."
MOC_DIR="$USER_HOME/.moc"
mkdir -p "$MOC_DIR"

cat <<EOF > "$MOC_DIR/config"
SoundDriver = ALSA
AlsaDevice = default
SavePlaylist = yes
Softmixer_SaveState = yes
EOF

# Mengatur kepemilikan dan izin akses wajib (600) untuk MOC
chown -R "$REAL_USER":"$REAL_USER" "$MOC_DIR"
chmod 600 "$MOC_DIR/config"

echo "5. Memulai ulang server MOC..."
su - "$REAL_USER" -c "mocp -x 2>/dev/null || true"
su - "$REAL_USER" -c "mocp -S"

echo "========================================================"
echo "Selesai! MOC kini berjalan dengan Pure ALSA (Sangat Ringan)."
echo "Ketik 'mocp' untuk membuka pemutar musik."
