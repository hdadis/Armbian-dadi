#!/bin/bash

# Pastikan script dijalankan sebagai root (administrator)
if [ "$EUID" -ne 0 ]; then
  echo "Harap jalankan script ini sebagai root (gunakan sudo)"
  exit 1
fi

# Hentikan script jika terjadi error pada perintah penting
set -e

# Fungsi otomatis untuk mengatur ZRAM ke 100% (optimal untuk beban ganda) & menghapus temp
restore_default_swap() {
  echo "=== Mengatur konfigurasi ZRAM ke level optimal (100%) & membersihkan temp ==="
  swapoff /swapfile_temp 2>/dev/null || true
  rm -rf /swapfile_temp /var/tmp/npm_build_tmp
  if [ -f /etc/default/armbian-zram-config ]; then
    sed -i 's/PERCENT=.*/PERCENT=100/g' /etc/default/armbian-zram-config
    systemctl restart armbian-zram-config 2>/dev/null || true
  fi
}

# Pasang trap: Jika script selesai ATAU terhenti karena error, langsung jalankan pembersihan
trap restore_default_swap EXIT

echo "=== 1. Menginstal dependensi dasar sistem ==="
apt-get update
apt-get install -y curl build-essential git python3 python3-pip software-properties-common cron
apt-get clean

echo "=== 2. Memeriksa Node.js & Mengatur NPM v10 (Anti Error EALLOWREMOTE) ==="
if ! command -v node &> /dev/null; then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
  apt-get clean
fi

npm install -g pm2 npm@10 --no-audit --no-fund
hash -r

node -v
npm -v

echo "=== 3. Menyiapkan Ruang eMMC & ZRAM Swap untuk HG680P RAM 1GB ==="
# Hentikan semua proses PM2 sementara (camera & cron Shinobi) agar RAM 1GB fokus penuh
pm2 stop all 2>/dev/null || true

# Bersihkan sisa sampah instalasi sebelumnya agar ruang eMMC lega
swapoff /swapfile_temp 2>/dev/null || true
rm -f /swapfile_temp
rm -rf /usr/lib/node_modules/n8n /usr/local/lib/node_modules/n8n
apt-get clean
apt-get autoclean -y
apt-get autoremove -y
npm cache clean --force
rm -rf /root/.npm /root/.node-gyp /tmp/* /var/tmp/*

# Naikkan ZRAM sementara ke 150% selama proses instalasi
if [ -f /etc/default/armbian-zram-config ]; then
  sed -i 's/PERCENT=.*/PERCENT=150/g' /etc/default/armbian-zram-config
  systemctl restart armbian-zram-config 2>/dev/null || true
fi
free -h
df -h /

echo "=== 4. Menginstal n8n v1.94.0 via npm (Menggunakan Temp eMMC agar RAM tidak penuh) ==="
mkdir -p /var/tmp/npm_build_tmp
TMPDIR=/var/tmp/npm_build_tmp NODE_OPTIONS="--max-old-space-size=650" npm install -g n8n@1.94.0 --maxsockets=1 --omit=dev --no-audit --no-fund --verbose

echo "=== 5. Mengoptimalkan Swap & Membersihkan Cache Instalasi ==="
npm cache clean --force
rm -rf /root/.npm /root/.node-gyp /tmp/* /var/tmp/npm_build_tmp
restore_default_swap

echo "=== 6. Membuat File Konfigurasi .env & Folder Downloads ==="
mkdir -p /root/n8n/downloads /home/node
ln -sfn /root/n8n/downloads /home/node/downloads
cd /root/n8n

cat << 'EOT' > /root/n8n/.env
# --- Network & IP Config ---
N8N_HOST=0.0.0.0
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PORT=5678

# --- URL Config ---
WEBHOOK_URL=https://ai.balai.my.id/

# --- Cookie Security ---
N8N_SECURE_COOKIE=false

# --- Environment Variable Custom ---
N8N_DOWNLOAD_PATH=/home/node/downloads

# Menentukan berapa jam data eksekusi disimpan (5 jam)
EXECUTIONS_DATA_MAX_AGE=5

# Menentukan jumlah maksimal eksekusi yang disimpan (15 riwayat)
EXECUTIONS_DATA_PRUNE_MAX_COUNT=15

# Mengaktifkan penghapusan otomatis
EXECUTIONS_DATA_PRUNE=true

# --- Optimasi Tambahan Khusus STB HG680P (RAM 1GB & eMMC 8GB) ---
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRE_BANNER_ENABLED=false
N8N_TEMPLATES_ENABLED=false
EOT

echo "=== 7. Menginstal Cloudflared ==="
bash -c "$(curl -fsSL https://raw.githubusercontent.com/hdadis/Armbian-dadi/refs/heads/main/Cloudflared)"

cloudflared service uninstall 2>/dev/null || true
cloudflared service install eyJhIjoiZDY4N2VkZDY3OWQ0MjI3YTQ5MjFkZjBhYjk4MzgwYTEiLCJ0IjoiNTRhNDA2MzgtODM4Mi00ODY3LWE1YWEtOTI0MzVkMmMxNWI2IiwicyI6IlpHRXpOV0l6TlRrdE9EUTJZUzAwTURNM0xUbG1ZbUV0WmpjME1UZGhZMkk0WTJVMyJ9

echo "=== 8. Menjalankan Shinobi & n8n secara Bersamaan di PM2 ==="
# Hapus pm2-logrotate jika ada (menghemat ~40MB RAM, digantikan oleh cron di tahap 9)
pm2 uninstall pm2-logrotate 2>/dev/null || true

# Nyalakan kembali proses Shinobi (camera & cron) jika sebelumnya terinstal
pm2 start camera 2>/dev/null || true
pm2 start cron 2>/dev/null || true

# Hapus instance n8n lama jika ada
pm2 delete n8n 2>/dev/null || true

# Muat isi file .env ke environment sistem
set -a
source /root/n8n/.env
set +a

# Jalankan n8n dengan batas memori 420MB (menyisakan ruang aman untuk Shinobi & OS)
N8N_BIN=$(which n8n)
pm2 start "$N8N_BIN" --name "n8n" --max-memory-restart 420M --node-args="--max-old-space-size=400" --update-env

# Simpan konfigurasi PM2 agar Shinobi + n8n bertahan saat reboot
pm2 save
env PATH=$PATH:/usr/bin pm2 startup systemd -u root --hp /root || true

echo "=== 9. Mengatur Pembersih Otomatis (Downloads, BinaryData & Log PM2) ==="
cat << 'EOF' > /usr/local/bin/limit-downloads
#!/bin/bash
TARGET_DIR="/root/n8n/downloads"

if [ -d "$TARGET_DIR" ]; then
  # 1. Hapus file di folder downloads yang umurnya lebih dari 5 jam (300 menit)
  find "$TARGET_DIR" -type f -mmin +300 -delete

  # 2. Jika jumlah file masih lebih dari 15, hapus file paling tua hingga tersisa 15 file terbaru
  find "$TARGET_DIR" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null | sort -zr -n | tail -z -n +16 | cut -z -d' ' -f2- | xargs -0 -r rm -f
fi

# 3. Hapus file binaryData internal n8n yang umurnya lebih dari 5 jam (300 menit)
find /root/.n8n/binaryData -type f -mmin +300 -delete 2>/dev/null || true

# 4. Pangkas log PM2 jika ukurannya melebihi 5MB (menggantikan pm2-logrotate tanpa makan RAM)
find /root/.pm2/logs -type f -name "*.log" -size +5M -exec truncate -s 0 {} + 2>/dev/null || true
EOF
chmod +x /usr/local/bin/limit-downloads

echo "*/15 * * * * root /usr/local/bin/limit-downloads" > /etc/cron.d/n8n-download-limiter
chmod 644 /etc/cron.d/n8n-download-limiter
systemctl enable cron 2>/dev/null || true
systemctl restart cron 2>/dev/null || true

# Buat perintah "clean-stb" untuk pembersihan menyeluruh
cat << 'EOF' > /usr/local/bin/clean-stb
#!/bin/bash
echo "Menjalankan pembersihan cache sistem, log, downloads, dan melegakan RAM..."
/usr/local/bin/limit-downloads
apt-get clean
apt-get autoclean -y
apt-get autoremove -y --purge
npm cache clean --force
# Hapus isi /root/.cache KECUALI folder /root/.cache/n8n agar frontend n8n tidak hilang
find /root/.cache -mindepth 1 ! -regex '^/root/\.cache/n8n\(/.*\)?' -delete 2>/dev/null || true
rm -rf /root/.npm /root/.node-gyp /tmp/* /var/tmp/*
journalctl --vacuum-size=10M
pm2 flush
sync && echo 3 > /proc/sys/vm/drop_caches
echo "=== Status Penyimpanan eMMC & RAM Saat Ini ==="
df -h /
free -h
EOF
chmod +x /usr/local/bin/clean-stb

ln -sf /usr/local/bin/clean-stb /etc/cron.daily/n8n-cleaner

echo "=== 10. Membersihkan Seluruh Cache Pasca-Instalasi ==="
rm -rf /var/lib/apt/lists/*
/usr/local/bin/clean-stb

echo "=== Instalasi & Optimasi Selesai Sepenuhnya ==="
pm2 status
